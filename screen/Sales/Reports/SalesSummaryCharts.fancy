<#-- The four summary charts. The configs are built in the screen actions; output here is not escaped, so an
    attribute value goes through WebUtilities.encodeHtml. -->
<#if sri.getRenderMode() == "qvt">
<div class="row"><#list summaryCharts as chart><div class="${statsChartColStyle}">
    <m-chart height="300px" :config="${WebUtilities.encodeHtml(chart.config)}"></m-chart>
</div></#list></div>
<#else>
<div class="row"><#list summaryCharts as chart><div class="${statsChartColStyle}">
    <div class="chart-container" style="position:relative; height:300px; width:100%;"><canvas id="${chart.id}"></canvas></div>
</div></#list></div>
<script><#list summaryCharts as chart>
    var ${chart.id} = new Chart(document.getElementById("${chart.id}"), ${chart.config});
</#list></script>
</#if>
