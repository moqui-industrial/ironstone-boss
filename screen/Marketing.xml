<!-- IronStone Marketing: root of the app for marketing staff (initial-design.md app table); its sections follow
    design-marketing.md when that file is written. Not yet implemented: its BOSS_MARKETING grant in data/BossSetupData.xml
    is commented out, so no one may open it and it is in no menu. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="IronStone Marketing" menu-image="sym_o_campaign" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Marketing"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true">
        <!-- the record panels the chatter and record-files elements load under this app root, hidden from the menu
            (the theme values STRT_CHATTER_SCREEN and STRT_RECORD_FILES_SCREEN; impl-drawers-commons.md R5) -->
        <subscreens-item name="Chatter" location="component://ironstone-boss/screen/Shared/Chatter.xml" menu-include="false"/>
        <subscreens-item name="RecordFiles" location="component://ironstone-boss/screen/Shared/RecordFiles.xml" menu-include="false"/>
    </subscreens>

    <widgets><subscreens-panel id="marketing-panel" type="popup"/></widgets>
</screen>
