<!-- UtilizationReport (design-projects.md §11 UtilizationReport; style-guide §3.12 Report): capacity against the hours logged and billed,
    by person and week, for the Projects managers (BOSS_PROJECTS_MANAGERS). The parameters are in the URL (UtilizationParams: the first
    week, the number of weeks, a team, a person, a project). Cards: capacity, logged, billable, utilization and billable utilization over
    the weeks past; a chart by week of the team's logged and billable hours as bars against the capacity as a line, with the tables behind
    it (UtilizationTable: person, week, capacity, logged, billable, utilization, billable utilization, allocated; UtilizationPeople: each
    person's totals; CSV and XLSX). A week to come shows no utilization; above 100% is marked. Print opens the same report in html-print.
    Over mantle.work.ProjectReportServices.get#Utilization (the people of the team plan, on the projects the user sees). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Utilization" default-menu-index="7">

    <parameter name="fromDate"/>
    <parameter name="weeks"/>
    <parameter name="teamPartyId"/>
    <parameter name="partyId"/>
    <parameter name="rootWorkEffortId"/>

    <transition name="personDetail"><default-response url="../../Resources/PersonDetail"/></transition>

    <actions><script><![CDATA[
        const L = (text) => ec.l10n.localize(text)
        const fmt = (value) => value == null ? '' : ec.l10n.format(Math.round(Number(String(value)) * 100) / 100, '#,##0.##')
        const pct = (value) => value == null ? '' : ec.l10n.format(Math.round(Number(String(value))), '#,##0') + '%'
        const options = ec.service.sync().name('ironstone.ReportServices.get#ReportOptions').call() || {}
        ec.message.clearErrors()
        projectOptions = Array.from(options.projectOptions || [])
        personOptions = Array.from(options.personOptions || [])
        if (!weeks) weeks = '8'
        const out = ec.service.sync().name('mantle.work.ProjectReportServices.get#Utilization').parameters({fromDate: fromDate || null, weeks: Number(weeks) || 8,
            teamPartyId: teamPartyId || null, partyId: partyId || null, rootWorkEffortId: rootWorkEffortId || null}).call() || {}
        ec.message.clearErrors()
        fromDate = out.fromDay
        teamOptions = Array.from(out.options?.teamOptions || []).map((one) => ({value: one.value, label: one.label}))
        const dayText = (day) => day ? ec.l10n.format(ec.l10n.parseTimestamp(day + ' 12:00:00.000', 'yyyy-MM-dd HH:mm:ss.SSS'), 'MMM d, yyyy') : ''
        rangeText = dayText(out.fromDay) + ' – ' + dayText(out.thruDay)
        const rowOf = (row) => ({partyId: row.partyId, name: row.name || '', roleText: row.roleText || '', weekText: row.label || '',
            capacityText: fmt(row.capacity), loggedText: fmt(row.logged), billableText: fmt(row.billable), allocatedText: fmt(row.allocated),
            utilizationText: pct(row.utilization), billableUtilizationText: pct(row.billableUtilization),
            over: row.utilization != null && Number(row.utilization) > 100, current: !!row.isCurrent})
        utilizationRows = Array.from(out.rowList || []).map(rowOf)
        utilizationRowsCount = utilizationRows.length
        personRows = Array.from(out.personList || []).map((person) => rowOf(Object.assign({partyId: person.partyId, name: person.name, roleText: person.roleText}, person.totals || {})))
        personRowsCount = personRows.length
        rowsFound = personRows.length > 0
        const totals = out.totals || {}
        capacityValue = fmt(totals.capacity || 0)
        loggedValue = fmt(totals.logged || 0)
        billableValue = fmt(totals.billable || 0)
        utilizationValue = totals.utilization == null ? '—' : pct(totals.utilization)
        billableUtilizationValue = totals.billableUtilization == null ? '—' : pct(totals.billableUtilization)
        const weekList = Array.from(out.weekList || [])
        hasChart = rowsFound && weekList.length > 0
        const chart = hasChart ? ec.service.sync().name('ironstone.ReportServices.get#ChartConfig').parameters({id: 'UtilizationChart', type: 'bar',
            labels: weekList.map((week) => week.label), series: [
                {name: L('Logged'), data: weekList.map((week) => week.past ? week.logged : null)},
                {name: L('Billable'), data: weekList.map((week) => week.past ? week.billable : null)},
                {name: L('Capacity'), data: weekList.map((week) => week.past ? week.capacity : null), kind: 'line', dashed: true}],
            yTitle: L('Hours')}).call() || {} : {}
        ec.message.clearErrors()
        chartHtml = chart.html || ''
        chartTui = chart.tui || {t: 'text', text: ''}
        const query = {fromDate: out.fromDay || '', weeks: weeks, teamPartyId: teamPartyId || '', partyId: partyId || '', rootWorkEffortId: rootWorkEffortId || ''}
        printUrl = '/apps/Projects/Reports/Utilization?renderMode=html-print&' + Object.entries(query).filter(([key, value]) => value).map(([key, value]) => key + '=' + encodeURIComponent(value)).join('&')
    ]]></script></actions>

    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h5" text="Utilization report" style="q-my-none col"/>
            <link url="${printUrl}" url-type="plain" text="Print" icon="sym_o_print" target-window="_blank" link-type="anchor-button"/>
        </container>
        <form-single name="UtilizationParams" transition=".">
            <field name="fromDate"><default-field title="From the week of"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
            <field name="weeks"><default-field title="Weeks">
                <drop-down><option key="4" text="4"/><option key="8" text="8"/><option key="12" text="12"/><option key="26" text="26"/></drop-down></default-field></field>
            <field name="teamPartyId"><default-field title="Team">
                <drop-down allow-empty="true"><list-options list="teamOptions" key="${value}" text="${label}"/></drop-down></default-field></field>
            <field name="partyId"><default-field title="Person">
                <drop-down allow-empty="true"><list-options list="personOptions" key="${value}" text="${label}"/></drop-down></default-field></field>
            <field name="rootWorkEffortId"><default-field title="Project">
                <drop-down allow-empty="true"><list-options list="projectOptions" key="${value}" text="${label}"/></drop-down></default-field></field>
            <field name="runButton"><default-field title="Run"><submit icon="sym_o_play_arrow"/></default-field></field>
            <field-layout>
                <field-row-big><field-ref name="fromDate"/><field-ref name="weeks"/><field-ref name="teamPartyId"/><field-ref name="partyId"/>
                    <field-ref name="rootWorkEffortId"/><field-ref name="runButton"/></field-row-big>
            </field-layout>
        </form-single>

        <dashboard min-width="150" style="q-mb-sm">
            <number-card title="Capacity" value="${capacityValue}" icon="sym_o_event_available" size="sm"/>
            <number-card title="Logged" value="${loggedValue}" icon="sym_o_schedule" size="sm"/>
            <number-card title="Billable" value="${billableValue}" icon="sym_o_paid" size="sm"/>
            <number-card title="Utilization" value="${utilizationValue}" icon="sym_o_speed" size="sm"/>
            <number-card title="Billable utilization" value="${billableUtilizationValue}" icon="sym_o_percent" size="sm"/>
        </dashboard>

        <section name="UtilizationChartBox" condition="hasChart"><widgets>
            <container-box><box-header title="Hours by week · ${rangeText}"/><box-body>
                <render-mode><text type="qvt"><![CDATA[${chartHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify(chartTui)}]]></text></render-mode>
            </box-body></container-box>
        </widgets></section>

        <container-box><box-header title="By person · ${rangeText}"/><box-body-nopad>
            <form-list name="UtilizationPeople" list="personRows" skip-form="true" paginate="false" show-csv-button="true" show-xlsx-button="true">
                <field name="name"><default-field title="Person">
                    <link url="personDetail" text="${name}" parameter-map="{partyId:partyId}" link-type="anchor"/></default-field></field>
                <field name="roleText"><default-field title="Role"><display/></default-field></field>
                <field name="capacityText" align="right"><default-field title="Capacity"><display/></default-field></field>
                <field name="loggedText" align="right"><default-field title="Logged"><display/></default-field></field>
                <field name="billableText" align="right"><default-field title="Billable"><display/></default-field></field>
                <field name="utilizationText" align="right"><default-field title="Utilization"><display style="${over ? 'text-warning text-weight-bold' : ''}"/></default-field></field>
                <field name="billableUtilizationText" align="right"><default-field title="Billable utilization"><display/></default-field></field>
                <field name="allocatedText" align="right"><default-field title="Allocated"><display/></default-field></field>
                <columns type="mobile">
                    <column><field-ref name="name"/><field-ref name="roleText"/></column>
                    <column><field-ref name="utilizationText"/><field-ref name="billableUtilizationText"/></column>
                </columns>
            </form-list>
            <label type="p" text="No one to show: no internal member of the projects you see matches." style="m-muted q-pa-sm q-mb-none" condition="!rowsFound"/>
        </box-body-nopad></container-box>

        <section name="UtilizationWeeksBox" condition="rowsFound"><widgets>
            <container-box><box-header title="By person and week"/><box-body-nopad>
                <form-list name="UtilizationTable" list="utilizationRows" skip-form="true" paginate="false" show-csv-button="true" show-xlsx-button="true" select-columns="true">
                    <field name="name"><default-field title="Person"><display/></default-field></field>
                    <field name="weekText"><default-field title="Week of"><display style="${current ? 'text-weight-bold' : ''}"/></default-field></field>
                    <field name="capacityText" align="right"><default-field title="Capacity"><display/></default-field></field>
                    <field name="loggedText" align="right"><default-field title="Logged"><display/></default-field></field>
                    <field name="billableText" align="right"><default-field title="Billable"><display/></default-field></field>
                    <field name="utilizationText" align="right"><default-field title="Utilization"><display style="${over ? 'text-warning text-weight-bold' : ''}"/></default-field></field>
                    <field name="billableUtilizationText" align="right"><default-field title="Billable utilization"><display/></default-field></field>
                    <field name="allocatedText" align="right"><default-field title="Allocated"><display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="name"/><field-ref name="weekText"/></column>
                        <column><field-ref name="loggedText"/><field-ref name="utilizationText"/></column>
                    </columns>
                </form-list>
            </box-body-nopad></container-box>
        </widgets></section>
        <label type="p" text="Utilization is the hours logged over capacity; billable utilization the billable hours over capacity. Capacity is the working hours less holidays and leave; logged counts all of a person's time that week. Weeks to come show their capacity and allocations only." style="text-caption m-muted"/>
    </widgets>
</screen>
