<!-- Time import step 2 (design-projects.md §8 ImportTime): the first 50 rows as they will be made, without writing anything
    (mantle.work.TimeServices.import#TimeEntryCsv preview, through ironstone.projects.TimeImportServices.get#ImportPreview): the row, the
    day, the person, the work item and project, the hours and time, the work type, billable, what it will do (create, skip when the
    entry is there already, or fail) and its problems (no date, a person or work item not found or not visible, no hours, a week
    submitted or not the user's to change) and warnings (hours rounded to the smallest entry, a work type not found), with the
    counts over the whole file and which column each field was read from. confirmPreview notes it in the draft; the next step
    imports. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Preview" default-menu-index="2" server-static="qvt" menu-image="sym_o_visibility" menu-image-type="icon">

    <parameter name="importId"/>

    <transition name="confirmPreview">
        <actions><script><![CDATA[
            const current = ec.service.sync().name('ironstone.projects.TimeImportServices.get#ImportDraft').parameters({importId: importId}).call()
            if (!current?.found) { ec.message.addError(ec.l10n.localize('This import is not available; start again from the file')); return }
            ec.service.sync().name('ironstone.projects.TimeImportServices.store#ImportDraft').parameters({importId: importId, fields: {status: 'previewed'}}).call()
        ]]></script></actions>
        <default-response url="."><parameter name="importId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="ironstone.projects.TimeImportServices.get#ImportPreview" in-map="{importId:importId}" out-map="previewOut"/>
        <script><![CDATA[
            preview = previewOut.preview || null
            hasDraft = !!preview && !preview.error
            previewError = preview?.error || null
            previewRows = Array.from(preview?.rowList || [])
        ]]></script>
    </actions>
    <widgets>
        <section name="NoDraft" condition="!hasDraft"><widgets>
            <container-box type="warning"><box-body><label type="p" text="${previewError || 'Start with the file.'}"/></box-body></container-box>
        </widgets></section>
        <section name="PreviewList" condition="hasDraft"><widgets>
            <container-box><box-header title="What will happen"/><box-body>
                <label type="p" text="${preview.summaryText}." style="text-body2"/>
                <label type="p" text="Read from the columns: ${preview.mappingText}." style="text-caption m-muted"/>
                <label type="p" text="Left out: ${preview.unusedText}." style="text-caption m-muted" condition="preview.unusedText"/>
                <label type="p" text="A row that fails is left out and named with its reason; the others are imported." style="text-caption m-muted"/>
                <form-single name="TimeImportPreviewConfirm" transition="confirmPreview">
                    <field name="importId" from="importId"><default-field><hidden/></default-field></field>
                </form-single>
            </box-body></container-box>
            <container-box><box-header title="Rows"/><box-body-nopad>
                <form-list name="TimeImportPreviewRows" list="previewRows" skip-form="true" paginate="false">
                    <field name="rowNumber" align="right"><default-field title="Row"><display/></default-field></field>
                    <field name="day"><default-field title="Day"><display style="text-no-wrap"/></default-field></field>
                    <field name="personName"><default-field title="Person"><display/></default-field></field>
                    <field name="itemText"><default-field title="Work item"><display/></default-field></field>
                    <field name="hoursText" align="right"><default-field title="Hours"><display/></default-field></field>
                    <field name="spanText"><default-field title="Time"><display style="text-no-wrap"/></default-field></field>
                    <field name="workTypeLabel"><default-field title="Work type"><display/></default-field></field>
                    <field name="billableText"><default-field title="Billable"><display/></default-field></field>
                    <field name="actionLabel"><default-field title="Action"><display style="${actionStyle} text-weight-medium"/></default-field></field>
                    <field name="problemText"><default-field title="Problems"><display style="${problemStyle} text-caption"/></default-field></field>
                    <columns>
                        <column><field-ref name="rowNumber"/><field-ref name="day"/></column>
                        <column><field-ref name="personName"/><field-ref name="itemText"/></column>
                        <column><field-ref name="hoursText"/><field-ref name="spanText"/></column>
                        <column><field-ref name="workTypeLabel"/><field-ref name="billableText"/></column>
                        <column><field-ref name="actionLabel"/><field-ref name="problemText"/></column>
                    </columns>
                    <columns type="mobile">
                        <column><field-ref name="itemText"/><field-ref name="problemText"/></column>
                        <column><field-ref name="actionLabel"/><field-ref name="hoursText"/></column>
                    </columns>
                </form-list>
                <label type="p" text="The first ${previewRows.length} rows are shown." style="text-caption m-muted q-pa-sm" condition="preview.moreRows == true"/>
            </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
