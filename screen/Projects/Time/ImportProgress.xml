<!-- How far a time import that runs as a job is (Import/Result): Commons' contact import progress component
    (screen/Commons/Contacts/ImportProgress.qvue) on the topic its query names (timeImportProgress, which
    mantle.work.TimeServices.import#TimeEntryCsv sends the user who runs the import, every 25 rows and at the end), loaded by the
    Result step in a dynamic-container while the draft is running. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Import progress" default-menu-include="false" render-modes="vue,qvue,tui" server-static="vue,qvue">
    <widgets>
        <render-mode><text type="qvue" location="component://mr-boss/screen/Commons/Contacts/ImportProgress.qvue" template="false"/><text type="tui" location="component://mr-boss/screen/Commons/Contacts/ImportProgress.tui.json" template="false"/></render-mode>
    </widgets>
</screen>
