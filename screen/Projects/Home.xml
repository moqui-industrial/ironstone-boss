<!-- Projects Home (design-projects.md §3 Home; style-guide §3.1 Landing), for the team and the managers
    (service/ironstone/ProjectServices.xml get#ProjectsHome): a greeting; a first-run card when the user sees no project (create
    a project, import work items, connect a repository); the counters, each a link into its list: my open work items, due this
    week, overdue and my hours this week, and for managers the projects at risk (the health, or numbers that warn) and the
    milestones in fourteen days; my next work items (ten, by due date then priority); what changed lately in my projects; my
    projects (managers: those they manage) with their health, status, progress, next milestone and open items; the shortcuts.

    Reviews waiting on me (impl-projects.md P3b2): a counter into Code's Merge requests waiting for my review, and a block of the
    five latest (number, title, repository, author, checks, updated), both left out when the build has no git hosting.

    Time (impl-projects.md P6a): the timer strip across the top while the user's timer runs (the work item, its project, when it
    started, the elapsed time with m-elapsed, Stop and My time); Start timer on each of my work items (a timer on another item
    stops first); My hours, this week's against my working hours with the timesheet's status once submitted, into My time; for
    managers Approve time (the timesheets to approve) and the Approvals block (the submitted weeks waiting, five, oldest first, each opening
    TimesheetDetail; left out when none waits).

    Resources (impl-projects.md P7): for managers Allocation requests (the requested allocations they decide, into Allocations'
    Requested), and those requests in the Approvals block after the weeks.

    Billing (impl-projects.md P8a): for managers who manage money, Unbilled (the billable time not invoiced in the projects they see,
    its amount; into Billing's Unbilled).

    Reports (impl-projects.md P9): for managers the charts Hours by project over the last four weeks (stacked by week, the time they
    may see) and, for those who manage money, Unbilled by client, each with its table in a dialog and a link to its report or list.

    Clients (impl-projects.md P10b): a client contact gets the clients' Home of design-projects.md §3 (ClientHome, from
    ironstone.client.ClientServices.get#ClientHome): Open requests, Waiting for your reply, Waiting for your approval, Milestones in
    30 days and Invoices due; the gates it approves, its projects with the latest update posted for it, its open requests, the
    team's recent messages to it, milestones soon and invoices due. Each counter comes from
    mantle.work.ProjectServices.get#ProjectHomeCounts, which answers null for one the user does not get. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">

    <transition name="workItemDetail"><default-response url="../WorkItems/WorkItemDetail"/></transition>
    <transition name="projectDetail"><default-response url="../Projects/ProjectDetail"/></transition>
    <!-- the timer: Stop on the strip, Start timer on a work item -->
    <transition name="stopTimer">
        <actions>
            <service-call name="mantle.work.TimesheetServices.stop#Timer" out-map="timerOut"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(timerOut.message, 'success')</script></if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="startTimer">
        <actions>
            <service-call name="ironstone.TimeServices.start#Timer" out-map="timerOut" in-map="{workEffortId:workEffortId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(timerOut.message, 'success')</script></if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <!-- a client contact (impl-projects.md P10b): the clients' Home of design-projects.md §3 -->
        <if condition="clientUser"><then>
            <script><![CDATA[
                const L = (text) => ec.l10n.localize(text)
                const nowMillis = Number(String(ec.user.nowTimestamp))
                const hour = Number(ec.l10n.format(new Date(nowMillis), 'H'))
                const name = String(ec.user.userAccount?.userFullName || ec.user.username || '').split(' ')[0]
                greeting = (hour < 12 ? L('Good morning') : hour < 18 ? L('Good afternoon') : L('Good evening')) + (name ? ', ' + name : '')
                todayText = ec.l10n.format(new Date(nowMillis), 'EEEE, MMMM d')
                // the clients' Home of design-projects.md §3 (impl-projects.md P10b): ironstone.client.ClientServices.get#ClientHome
                const clientHome = ec.service.sync().name('ironstone.client.ClientServices.get#ClientHome').call()?.home || {}
                ec.message.clearErrors()
                const counts = clientHome.counts || {}
                const n = (value) => value == null ? '—' : ec.l10n.format(value, '#,##0')
                openRequestsText = n(counts.openRequests); waitingReplyText = n(counts.waitingReply); approvalsText = n(counts.approvals)
                milestones30Text = n(counts.milestones30); invoicesDueText = n(counts.invoicesDue)
                clientProjectList = Array.from(clientHome.projectList || [])
                clientRequestList = Array.from(clientHome.requestList || [])
                clientReplyList = Array.from(clientHome.replyList || [])
                clientApprovalList = Array.from(clientHome.approvalList || [])
                clientMilestoneList = Array.from(clientHome.milestoneList || [])
                clientInvoiceList = Array.from(clientHome.invoiceList || [])
                clientFailedText = (clientHome.failedParts || []).length ? L('Some parts could not be read') + ': ' + clientHome.failedParts.join(', ') : ''
            ]]></script>
        </then><else>
        <service-call name="ironstone.ProjectServices.get#ProjectsHome" out-map="homeOut"/>
        <script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            const home = homeOut.home || {}
            const nowMillis = Number(String(ec.user.nowTimestamp))
            const hour = Number(ec.l10n.format(new Date(nowMillis), 'H'))
            const name = String(ec.user.userAccount?.userFullName || ec.user.username || '').split(' ')[0]
            greeting = (hour < 12 ? L('Good morning') : hour < 18 ? L('Good afternoon') : L('Good evening')) + (name ? ', ' + name : '')
            todayText = ec.l10n.format(new Date(nowMillis), 'EEEE, MMMM d')
            isManager = !!home.isManager
            firstRun = !!home.firstRun
            const counts = home.counts || {}
            const n = (value) => value == null ? '—' : ec.l10n.format(value, '#,##0')
            myOpenText = n(counts.myOpen); dueWeekText = n(counts.dueWeek); overdueText = n(counts.overdue)
            hoursWeekText = counts.hoursWeek == null ? '—' : ec.l10n.format(counts.hoursWeek, '#,##0.##') + ' h'
            if (counts.hoursWeek != null && counts.expectedWeek) hoursWeekText = ec.l10n.format(counts.hoursWeek, '#,##0.##') + ' / ' + ec.l10n.format(counts.expectedWeek, '#,##0.##') + ' h'
            // the week's timesheet status, when it is no longer open
            const sheetLabels = {TmshCompleted: L('submitted'), TmshApproved: L('approved')}
            hoursTitle = L('My hours') + (sheetLabels[counts.timesheetStatusId] ? ' · ' + sheetLabels[counts.timesheetStatusId] : '')
            toApproveText = n(counts.timesheetsToApprove)
            allocationsShown = isManager && counts.allocationRequests != null
            allocationsText = n(counts.allocationRequests)
            unbilledShown = isManager && counts.unbilledAmount != null
            unbilledText = unbilledShown ? ec.l10n.formatCurrency(toDecimal(counts.unbilledAmount), counts.unbilledCurrencyUomId || 'USD') : ''
            // the timer strip
            timer = home.timer || null
            timerShown = !!timer
            if (timer) {
                const enc = (value) => String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\u0022/g, '&quot;')
                timerTitle = (timer.workEffortId ? timer.workEffortId + ' ' : '') + (timer.workEffortName || L('No work item'))
                timerCaption = [timer.projectName, L('since') + ' ' + timer.startedText, timer.comments].filter((part) => part).join(' · ')
                timerElapsedHtml = '<m-elapsed from="' + enc(timer.fromDate) + '" class="text-h6 text-mono"></m-elapsed>'
                timerTui = {t: 'text', id: 'HomeTimer', style: 'strong', text: L('Timer') + ': ' + timerTitle + ' · ' + timerCaption}
            }
            approvalList = Array.from(home.approvalList || [])
            approvalsShown = isManager && approvalList.length > 0
            atRiskText = n(counts.projectsAtRisk); milestonesText = n(counts.milestonesSoon)
            reviewsShown = !!home.hosting && counts.reviewsWaiting != null
            reviewsText = n(counts.reviewsWaiting)
            reviewList = Array.from(home.reviewList || [])
            const me = ec.user.userAccount?.partyId || ''
            dueWeekLink = '../WorkItems?list=week&assigneePartyId=' + encodeURIComponent(me)
            overdueLink = '../WorkItems?list=overdue&assigneePartyId=' + encodeURIComponent(me)
            workItemList = Array.from(home.workItemList || [])
            myWorkProgress = home.myWorkProgress || null
            myWorkDone = myWorkProgress ? myWorkProgress.done : 0
            myWorkOpen = myWorkProgress ? myWorkProgress.open : 0
            myWorkPercent = myWorkProgress ? myWorkProgress.percent : 0
            myWorkProgressShown = !!(myWorkProgress && myWorkProgress.total > 0)
            activityList = Array.from(home.activityList || [])
            projectList = Array.from(home.projectList || [])
            projectsTitle = isManager ? L('Projects I manage') : L('My projects')

            // the managers' charts (impl-projects.md P9), each on its own: hours by project over the last four weeks (the time they may
            // see, mantle.work.ProjectReportServices.get#TimeReport) and, for those who manage money, unbilled by client
            // (mantle.work.ProjectServices.get#UnbilledSummary's totals by client)
            hoursChartShown = false; unbilledChartShown = false
            hoursRows = []; unbilledRows = []
            if (isManager) {
                const fmt = (value) => ec.l10n.format(Math.round(Number(String(value || 0)) * 100) / 100, '#,##0.##')
                const today = ec.l10n.format(new Date(nowMillis), 'yyyy-MM-dd')
                const js = new Date(today + 'T12:00:00Z').getUTCDay()
                const monday = new Date(Date.parse(today + 'T12:00:00Z') - ((js + 6) % 7 + 21) * 86400000).toISOString().slice(0, 10)
                hoursReportUrl = '../Reports/Time?criterion1=project&period=week&fromDate=' + monday + '&thruDate=' + today
                try {
                    const time = ec.service.sync().name('mantle.work.ProjectReportServices.get#TimeReport').parameters({fromDate: monday, thruDate: today, period: 'week',
                        criteria: ['project'], withAmounts: false}).call() || {}
                    if (ec.message.hasError()) throw new Error(ec.message.getErrorsString())
                    const series = Array.from(time.chart?.series || [])
                    if (series.length) {
                        const chart = ec.service.sync().name('ironstone.ReportServices.get#ChartConfig').parameters({id: 'HomeHoursByProject', type: 'bar',
                            labels: Array.from(time.chart.labels || []), series: series.map((one) => ({name: one.name, data: Array.from(one.data || [])})), stacked: true,
                            height: '220px'}).call() || {}
                        hoursChartHtml = chart.html || ''; hoursChartTui = chart.tui || {t: 'text', text: ''}
                        const periods = Array.from(time.periodList || [])
                        hoursRows = Array.from(time.rowList || []).map((row) => ({project: row.values[0].label, hoursText: fmt(row.hours),
                            weeksText: Array.from(row.periodHours || []).map((hours, i) => (periods[i]?.label || '') + ': ' + fmt(hours)).join(' · ')}))
                        hoursChartShown = true
                    }
                } catch (err) {
                    ec.logger.error(`Projects Home: the hours by project chart left out: ${err && err.message ? err.message : err}`)
                } finally { ec.message.clearErrors() }
                if (unbilledShown) try {
                    const unbilled = ec.service.sync().name('mantle.work.ProjectServices.get#UnbilledSummary').call() || {}
                    if (ec.message.hasError()) throw new Error(ec.message.getErrorsString())
                    const currency = unbilled.totals?.currencyUomId
                    const byClient = Array.from(unbilled.totals?.byClient || []).filter((one) => Number(String(one.amount || 0)) > 0)
                    if (byClient.length && currency) {
                        const chart = ec.service.sync().name('ironstone.ReportServices.get#ChartConfig').parameters({id: 'HomeUnbilledByClient', type: 'bar',
                            labels: byClient.map((one) => one.clientName || L('No client')), series: [{name: L('Unbilled') + ' (' + currency + ')',
                            data: byClient.map((one) => Number(String(one.amount || 0)))}], horizontal: true, height: '220px'}).call() || {}
                        unbilledChartHtml = chart.html || ''; unbilledChartTui = chart.tui || {t: 'text', text: ''}
                        unbilledRows = byClient.map((one) => ({clientName: one.clientName || L('No client'), hoursText: fmt(one.hours),
                            amountText: ec.l10n.formatCurrency(toDecimal(one.amount || 0), currency)}))
                        unbilledChartShown = true
                    }
                } catch (err) {
                    ec.logger.error(`Projects Home: the unbilled by client chart left out: ${err && err.message ? err.message : err}`)
                } finally { ec.message.clearErrors() }
            }
            chartsShown = hoursChartShown || unbilledChartShown
        ]]></script>
        </else></if>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <label type="h4" text="${greeting}" style="q-my-none"/>
            <label type="div" text="${todayText}" style="text-caption m-muted"/>
        </container>

        <!-- a client contact's Home (design-projects.md §3; impl-projects.md P10b): the counters, what waits on it (approvals, replies),
            its projects with the latest update posted for it, its open requests, milestones soon and invoices due -->
        <section name="ClientHome" condition="clientUser"><widgets>
            <container style="row items-center q-mb-sm">
                <container style="col"/>
                <link url="../Requests/List" link-type="anchor-button" btn-type="primary" text="New request" icon="sym_o_support"/>
            </container>
            <label text="${clientFailedText}" type="p" style="text-warning text-caption" condition="clientFailedText"/>
            <dashboard min-width="150" style="q-mb-sm">
                <number-card title="Open requests" value="${openRequestsText}" icon="sym_o_support" size="sm" link="/qapps/Projects/Requests/List?list=all"/>
                <number-card title="Waiting for your reply" value="${waitingReplyText}" icon="sym_o_mark_chat_unread" size="sm"/>
                <number-card title="Waiting for your approval" value="${approvalsText}" icon="sym_o_approval" size="sm"/>
                <number-card title="Milestones in 30 days" value="${milestones30Text}" icon="sym_o_flag" size="sm" link="/qapps/Projects/Projects/Roadmap"/>
                <number-card title="Invoices due" value="${invoicesDueText}" icon="sym_o_receipt_long" size="sm" link="/qapps/Projects/Billing/Invoices?list=sent"/>
            </dashboard>
            <container style="row q-col-gutter-sm">
                <container style="col-12 col-md-6">
                    <section name="ClientApprovals" condition="clientApprovalList.length"><widgets>
                        <container-box type="info"><box-header title="Waiting for your approval"/><box-body-nopad>
                            <form-list name="ClientApprovalList" list="clientApprovalList" skip-form="true" skip-header="true" paginate="false">
                                <field name="workEffortName"><default-field>
                                    <link url="${url}" url-type="plain" text="${workEffortName}" link-type="anchor"/>
                                    <label text="${(isEstimate ? ec.l10n.localize('The estimate') + ' · ' : '') + ec.l10n.localize('asked') + ' ' + requestedText}" type="div" style="text-caption m-muted"/>
                                    <label text="${comments}" type="div" style="text-caption" condition="comments"/></default-field></field>
                            </form-list>
                        </box-body-nopad></container-box>
                    </widgets></section>
                    <container-box><box-header title="Your projects"/><box-toolbar>
                        <link url="../Projects" link-type="anchor" text="All projects"/>
                    </box-toolbar><box-body-nopad>
                        <form-list name="ClientProjects" list="clientProjectList" skip-form="true" skip-header="true" paginate="false">
                            <field name="workEffortName"><default-field>
                                <link url="projectDetail" text="${workEffortName}" parameter-map="{workEffortId:workEffortId}"/>
                                <label text="${updateText}" type="div" style="text-caption m-muted"/></default-field></field>
                            <field name="statusLabel"><default-field>
                                <render-mode><text type="qvt"><![CDATA[<div class="row no-wrap">${healthLabel ? '<q-chip dense square class="q-my-none q-ml-none q-mr-xs m-tonal text-' + healthColor + '">' + WebUtilities.encodeHtml(healthLabel) + '</q-chip>' : ''}<q-chip dense square class="q-ma-none m-tonal text-grey-8">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip></div>]]></text>
                                    <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify([healthLabel, statusLabel].filter((part) => part).join(" · "))}}]]></text></render-mode></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="workEffortName"/></column>
                                <column><field-ref name="statusLabel"/></column>
                            </columns>
                        </form-list>
                        <section name="NoClientProjects" condition="!clientProjectList.length"><widgets>
                            <label type="p" text="No project is shared with you yet" style="m-muted q-pa-sm q-mb-none"/>
                        </widgets></section>
                    </box-body-nopad></container-box>
                    <container-box><box-header title="Your open requests"/><box-toolbar>
                        <link url="../Requests/List" link-type="anchor" text="All requests"/>
                    </box-toolbar><box-body-nopad>
                        <form-list name="ClientRequestList" list="clientRequestList" skip-form="true" skip-header="true" paginate="false">
                            <field name="requestName"><default-field>
                                <link url="${url}" url-type="plain" text="${requestName}" link-type="anchor"/>
                                <label text="${requestId} · ${updatedText}" type="div" style="text-caption m-muted"/></default-field></field>
                            <field name="statusLabel"><default-field><label text="${statusLabel}" type="span" style="text-caption"/></default-field></field>
                        </form-list>
                        <section name="NoClientRequests" condition="!clientRequestList.length"><widgets>
                            <label type="p" text="No open requests" style="m-muted q-pa-sm q-mb-none"/>
                        </widgets></section>
                    </box-body-nopad></container-box>
                </container>
                <container style="col-12 col-md-6">
                    <container-box><box-header title="Recent replies"/><box-body-nopad>
                        <form-list name="ClientReplyList" list="clientReplyList" skip-form="true" skip-header="true" paginate="false">
                            <field name="subject"><default-field>
                                <link url="${url}" url-type="plain" text="${subject || recordText}" link-type="anchor" condition="url"/>
                                <label text="${subject}" type="span" condition="!url"/>
                                <label text="${fromName} · ${whenText}${waiting ? ' · ' + ec.l10n.localize('waiting for your reply') : ''}" type="div" style="text-caption m-muted"/>
                                <label text="${snippet}" type="div" style="text-caption ellipsis-2-lines"/></default-field></field>
                        </form-list>
                        <section name="NoClientReplies" condition="!clientReplyList.length"><widgets>
                            <label type="p" text="No messages from the team yet" style="m-muted q-pa-sm q-mb-none"/>
                        </widgets></section>
                    </box-body-nopad></container-box>
                    <section name="ClientMilestones" condition="clientMilestoneList.length"><widgets>
                        <container-box><box-header title="Milestones in the next 30 days"/><box-body-nopad>
                            <form-list name="ClientMilestoneList" list="clientMilestoneList" skip-form="true" skip-header="true" paginate="false">
                                <field name="workEffortName"><default-field><link url="${url}" url-type="plain" text="${workEffortName}" link-type="anchor"/></default-field></field>
                                <field name="dueText"><default-field><label text="${dueText}" type="span" style="text-caption ${overdue ? 'text-warning' : 'm-muted'}"/></default-field></field>
                            </form-list>
                        </box-body-nopad></container-box>
                    </widgets></section>
                    <section name="ClientInvoices" condition="clientInvoiceList.length"><widgets>
                        <container-box><box-header title="Invoices due"/><box-toolbar>
                            <link url="/qapps/Projects/Billing/Invoices" url-type="plain" link-type="anchor" text="All invoices"/>
                        </box-toolbar><box-body-nopad>
                            <form-list name="ClientInvoiceList" list="clientInvoiceList" skip-form="true" skip-header="true" paginate="false">
                                <field name="invoiceId"><default-field>
                                    <link url="${url}" url-type="plain" text="${ec.l10n.localize('Invoice')} ${invoiceId}" link-type="anchor"/>
                                    <label text="${description}" type="div" style="text-caption m-muted" condition="description"/></default-field></field>
                                <field name="unpaidText" align="right"><default-field>
                                    <label text="${unpaidText}" type="div" style="text-weight-medium text-no-wrap"/>
                                    <label text="${dueText ? ec.l10n.localize('due') + ' ' + dueText : ''}" type="div" style="text-caption ${overdue ? 'text-warning' : 'm-muted'}"/></default-field></field>
                            </form-list>
                        </box-body-nopad></container-box>
                    </widgets></section>
                </container>
            </container>
        </widgets></section>

        <section name="TeamHome" condition="!clientUser"><widgets>

        <!-- the timer strip, first while the timer runs -->
        <section name="TimerStrip" condition="timerShown"><widgets>
            <render-mode><text type="qvt"><![CDATA[<q-card flat bordered class="q-px-md q-py-sm q-mb-md m-home-timer-card">]]></text><text type="tui" template="false">[]</text></render-mode>
                <container style="row items-center q-col-gutter-sm no-wrap m-home-timer">
                    <render-mode><text type="qvt"><![CDATA[<div class="col-auto"><q-icon name="sym_o_timer" size="md" color="primary"></q-icon></div>]]></text><text type="tui" template="false">[]</text></render-mode>
                    <container style="col" >
                        <link url="${timer.url}" url-type="plain" text="${timerTitle}" link-type="anchor" style="text-body1 text-weight-medium" condition="timer.url"/>
                        <label text="${timerTitle}" type="div" style="text-body1 text-weight-medium" condition="!timer.url"/>
                        <label text="${timerCaption}" type="div" style="text-caption m-muted"/>
                    </container>
                    <render-mode><text type="qvt"><![CDATA[<div class="col-auto">${timerElapsedHtml}</div>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify(timerTui)}]]></text></render-mode>
                    <container style="col-auto row items-center q-gutter-xs">
                        <link url="stopTimer" link-type="hidden-form" btn-type="danger" text="Stop" icon="sym_o_stop_circle"/>
                        <link url="../Time/MyTime" text="My time" icon="sym_o_schedule" link-type="anchor-button" style="gt-xs"/>
                    </container>
                </container>
            <render-mode><text type="qvt"><![CDATA[</q-card>]]></text><text type="tui" template="false">[]</text></render-mode>
        </widgets></section>

        <!-- first run: no project yet -->
        <section name="FirstRun" condition="firstRun"><widgets>
            <container-box type="info"><box-header title="Get started with Projects"/><box-body>
                <label type="p" text="You are on no project yet. A project holds the work items, the team, the code and the time of one piece of work." style="m-muted"/>
                <container style="row q-gutter-sm">
                    <link url="../Projects/NewProject" text="Create a project" icon="sym_o_create_new_folder" condition="isManager"/>
                    <link url="../WorkItems/Import" text="Import work items" icon="sym_o_upload_file" condition="isManager"/>
                    <link url="../Code/Repositories" text="Connect a repository" icon="sym_o_code"/>
                </container>
                <label type="p" text="Ask a project manager to add you to a project." style="text-caption m-muted q-mt-sm q-mb-none" condition="!isManager"/>
            </box-body></container-box>
        </widgets></section>

        <!-- the counters, each a link into its list; two a row on a phone -->
        <dashboard min-width="170" style="q-mb-md">
            <number-card title="My open items" value="${myOpenText}" icon="sym_o_checklist" link="../WorkItems?list=mine"/>
            <number-card title="Due this week" value="${dueWeekText}" icon="sym_o_date_range" link="${dueWeekLink}"/>
            <number-card title="Overdue" value="${overdueText}" icon="sym_o_assignment_late" link="${overdueLink}"/>
            <number-card title="Reviews waiting" value="${reviewsText}" icon="sym_o_rate_review" link="../Code/MergeRequests?list=waiting" condition="reviewsShown"/>
            <number-card title="${hoursTitle}" value="${hoursWeekText}" icon="sym_o_schedule" link="../Time/MyTime"/>
            <number-card title="Approve time" value="${toApproveText}" icon="sym_o_approval" link="../Time/Timesheets?list=toApprove" condition="isManager"/>
            <number-card title="Allocation requests" value="${allocationsText}" icon="sym_o_event_available" link="../Resources/Allocations?list=requested" condition="allocationsShown"/>
            <number-card title="Unbilled" value="${unbilledText}" icon="sym_o_request_quote" link="../Billing/Unbilled" condition="unbilledShown"/>
            <number-card title="At risk" value="${atRiskText}" icon="sym_o_warning" link="../Projects?list=atRisk" condition="isManager"/>
            <number-card title="Milestones" value="${milestonesText}" icon="sym_o_flag_circle" link="../Projects/Roadmap" condition="isManager"/>
        </dashboard>

        <container-row>
            <row-col md="8">
                <container-box><box-header title="My work items"/><box-toolbar>
                    <link url="../WorkItems" link-type="anchor" text="All my work items" parameter-map="{list:'mine'}"/>
                </box-toolbar><box-body-nopad>
                    <section name="MyWorkProgress" condition="myWorkProgressShown"><widgets>
                        <container style="q-px-md q-pt-md q-pb-xs">
                            <render-mode><text type="qvt"><![CDATA[
                                <div class="row items-center no-wrap q-col-gutter-x-sm">
                                    <div class="col-auto"><span class="text-caption m-muted">${myWorkDone} done · ${myWorkOpen} open</span></div>
                                    <div class="col"><q-linear-progress rounded size="6px" :value="${myWorkPercent / 100}" color="primary" track-color="grey-3"></q-linear-progress></div>
                                    <div class="col-auto"><span class="text-caption m-muted">${myWorkPercent}%</span></div>
                                </div>
                            ]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify([{t: "text", text: myWorkDone + " done · " + myWorkOpen + " open (" + myWorkPercent + "%)", style: "caption"}])}]]></text></render-mode>
                        </container>
                    </widgets></section>
                    <form-list name="MyWorkItems" list="workItemList" skip-form="true" skip-header="true" paginate="false">
                        <field name="workEffortId"><default-field>
                            <link url="workItemDetail" text="${workEffortId}" parameter-map="{workEffortId:workEffortId}" link-type="anchor" style="text-mono text-no-wrap"/></default-field></field>
                        <field name="workEffortName"><default-field>
                            <link url="workItemDetail" text="${workEffortName}" parameter-map="{workEffortId:workEffortId}"/>
                            <label text="${projectName || ''}" type="div" style="text-caption m-muted"/></default-field></field>
                        <field name="statusLabel"><default-field>
                            <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip>]]></text>
                                <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(statusLabel ?? "")}}]]></text></render-mode></default-field></field>
                        <field name="dueText" align="right"><default-field>
                            <label text="${dueText || ''}" type="span" style="text-no-wrap ${overdue ? 'text-warning' : 'm-muted'}"/></default-field></field>
                        <field name="startTimer" align="right"><default-field title="">
                            <link url="startTimer" link-type="hidden-form-link" icon="sym_o_play_circle" text="" tooltip="Start timer" style="m-btn-flat"
                                    parameter-map="{workEffortId:workEffortId}" condition="!timer || timer.workEffortId != workEffortId"/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="workEffortId"/><field-ref name="workEffortName"/></column>
                            <column><field-ref name="statusLabel"/><field-ref name="dueText"/></column>
                            <column><field-ref name="startTimer"/></column>
                        </columns>
                    </form-list>
                    <section name="NoWorkItems" condition="!workItemList.length"><widgets>
                        <label type="p" text="Nothing assigned to you" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>

                <section name="ReviewsWaiting" condition="reviewsShown"><widgets>
                    <container-box><box-header title="Reviews waiting on me"/><box-toolbar>
                        <link url="../Code/MergeRequests" link-type="anchor" text="All merge requests" parameter-map="{list:'waiting'}"/>
                    </box-toolbar><box-body-nopad>
                        <form-list name="ReviewsWaitingList" list="reviewList" skip-form="true" skip-header="true" paginate="false">
                            <field name="title"><default-field>
                                <link url="/qapps/Projects/Code/MergeRequestDetail" url-type="plain" text="${numText} ${title}" parameter-map="{mergeRequestId:mergeRequestId}"/>
                                <label text="${repositoryId} · ${authorName} · ${branchText}" type="div" style="text-caption m-muted"/></default-field></field>
                            <field name="checkLabel"><default-field>
                                <render-mode><text type="qvt"><![CDATA[${checkLabel ? '<q-chip dense square class="q-ma-none m-tonal text-' + checkColor + '">' + WebUtilities.encodeHtml(checkLabel) + '</q-chip>' : ''}]]></text>
                                    <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(checkLabel ?? "")}}]]></text></render-mode></default-field></field>
                            <field name="updatedText" align="right"><default-field><label text="${updatedText}" type="span" style="text-no-wrap m-muted"/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="title"/></column>
                                <column><field-ref name="checkLabel"/><field-ref name="updatedText"/></column>
                            </columns>
                        </form-list>
                        <section name="NoReviews" condition="!reviewList.length"><widgets>
                            <label type="p" text="No review is waiting for you" style="m-muted q-pa-sm q-mb-none"/>
                        </widgets></section>
                    </box-body-nopad></container-box>
                </widgets></section>

                <!-- the managers' approvals: the submitted weeks waiting -->
                <section name="Approvals" condition="approvalsShown"><widgets>
                    <container-box><box-header title="Approvals"/><box-toolbar>
                        <link url="../Time/Timesheets" link-type="anchor" text="All timesheets to approve" parameter-map="{list:'toApprove'}"/>
                        <link url="../Resources/Allocations" link-type="anchor" text="Allocations" parameter-map="{list:'requested'}" condition="allocationsShown"/>
                    </box-toolbar><box-body-nopad>
                        <form-list name="HomeApprovals" list="approvalList" skip-form="true" skip-header="true" paginate="false">
                            <field name="personName"><default-field>
                                <link url="${url}" url-type="plain" text="${personName}" link-type="anchor"/>
                                <label text="${whatText}" type="div" style="text-caption m-muted"/></default-field></field>
                            <field name="hoursText" align="right"><default-field><display/></default-field></field>
                            <field name="sinceText" align="right"><default-field><label text="${sinceText}" type="span" style="text-no-wrap m-muted"/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="personName"/></column>
                                <column><field-ref name="hoursText"/><field-ref name="sinceText"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad></container-box>
                </widgets></section>

                <container-box><box-header title="${projectsTitle}"/><box-toolbar>
                    <link url="../Projects" link-type="anchor" text="All projects"/>
                </box-toolbar><box-body-nopad>
                    <form-list name="MyProjects" list="projectList" skip-form="true" skip-header="true" paginate="false">
                        <field name="workEffortName"><default-field>
                            <render-mode><text type="qvt"><![CDATA[
                                <span class="row inline no-wrap items-center">${colorName ? '<span class="q-mr-xs bg-' + WebUtilities.encodeHtml(colorName) + '" style="display:inline-block;width:10px;height:10px;border-radius:50%"></span>' : ''}<a class="no-underline" href="/qapps/Projects/Projects/ProjectDetail?workEffortId=${WebUtilities.encodeHtml(workEffortId)}">${WebUtilities.encodeHtml(workEffortName)}</a></span>
                                <span class="text-caption m-muted q-ml-sm">${WebUtilities.encodeHtml(workEffortId)}${nextMilestoneText ? ' · ' + WebUtilities.encodeHtml(nextMilestoneText) : ''}</span>
                            ]]></text>
                                <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify((workEffortName ?? '') + ' ' + (workEffortId ?? '') + (nextMilestoneText ? ' · ' + nextMilestoneText : ''))}}]]></text></render-mode>
                        </default-field></field>
                        <field name="healthLabel"><default-field>
                            <render-mode><text type="qvt"><![CDATA[<div class="row no-wrap">${healthLabel ? '<q-chip dense square class="q-my-none q-ml-none q-mr-xs m-tonal text-' + healthColor + '">' + WebUtilities.encodeHtml(healthLabel) + '</q-chip>' : ''}<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip></div>]]></text>
                                <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify([healthLabel, statusLabel].filter((part) => part).join(" · "))}}]]></text></render-mode></default-field></field>
                        <field name="percentDone" align="right"><default-field>
                            <render-mode><text type="qvt"><![CDATA[<div style="min-width: 90px"><span class="text-caption">${WebUtilities.encodeHtml(progressText ?? '')} · ${openItems} ${ec.l10n.localize('open')}</span><q-linear-progress rounded size="6px" :value="${Number(percentDone || 0) / 100}" color="primary" track-color="grey-3"></q-linear-progress></div>]]></text>
                                <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify((progressText ?? "") + " · " + openItems + " open")}}]]></text></render-mode></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="workEffortName"/></column>
                            <column><field-ref name="healthLabel"/><field-ref name="percentDone"/></column>
                        </columns>
                    </form-list>
                    <section name="NoProjects" condition="!projectList.length"><widgets>
                        <label type="p" text="${isManager ? 'You manage no open project' : 'You are on no open project'}" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>

                <!-- the managers' charts, each with its table (design-projects.md §3 HoursByProject and UnbilledByClient) -->
                <section name="ManagerCharts" condition="chartsShown"><widgets>
                    <container-row>
                        <row-col lg="${unbilledChartShown ? 6 : 12}"><section name="HoursByProject" condition="hoursChartShown"><widgets>
                            <container-box><box-header title="Hours by project · last four weeks"/><box-toolbar>
                                <container-dialog id="HomeHoursTable" button-text="Table" icon="sym_o_table" width="640" title="Hours by project · last four weeks">
                                    <form-list name="HomeHoursByProject" list="hoursRows" skip-form="true" paginate="false">
                                        <field name="project"><default-field title="Project"><display/></default-field></field>
                                        <field name="hoursText" align="right"><default-field title="Hours"><display/></default-field></field>
                                        <field name="weeksText"><default-field title="By week"><display/></default-field></field>
                                    </form-list>
                                </container-dialog>
                                <link url="${hoursReportUrl}" url-type="plain" link-type="anchor" text="Time report"/>
                            </box-toolbar><box-body>
                                <render-mode><text type="qvt"><![CDATA[${hoursChartHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify(hoursChartTui)}]]></text></render-mode>
                            </box-body></container-box>
                        </widgets></section></row-col>
                        <row-col lg="${hoursChartShown ? 6 : 12}"><section name="UnbilledByClient" condition="unbilledChartShown"><widgets>
                            <container-box><box-header title="Unbilled by client"/><box-toolbar>
                                <container-dialog id="HomeUnbilledTable" button-text="Table" icon="sym_o_table" width="520" title="Unbilled by client">
                                    <form-list name="HomeUnbilledByClient" list="unbilledRows" skip-form="true" paginate="false">
                                        <field name="clientName"><default-field title="Client"><display/></default-field></field>
                                        <field name="hoursText" align="right"><default-field title="Hours"><display/></default-field></field>
                                        <field name="amountText" align="right"><default-field title="Unbilled"><display/></default-field></field>
                                    </form-list>
                                </container-dialog>
                                <link url="../Billing/Unbilled" link-type="anchor" text="Unbilled"/>
                            </box-toolbar><box-body>
                                <render-mode><text type="qvt"><![CDATA[${unbilledChartHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify(unbilledChartTui)}]]></text></render-mode>
                            </box-body></container-box>
                        </widgets></section></row-col>
                    </container-row>
                </widgets></section>
            </row-col>
            <row-col md="4">
                <!-- shortcuts: the shell's quick-create kinds and the screens a team member goes to -->
                <container-box><box-header title="Shortcuts"/><box-body>
                    <render-mode><text type="qvt"><![CDATA[<div class="column q-gutter-sm items-start q-mb-sm">
                        <q-btn unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_add_task" label="${ec.l10n.localize('New work item')}" @click="$root.openQuickCreate && $root.openQuickCreate(($root.quickCreateItems || []).find((kind) => kind.kind === 'workItem'))"></q-btn>
                        <q-btn unelevated dense no-caps class="m-btn-tonal q-px-sm" icon="sym_o_more_time" label="${ec.l10n.localize('Log time')}" @click="$root.openQuickCreate && $root.openQuickCreate(($root.quickCreateItems || []).find((kind) => kind.kind === 'time'))"></q-btn></div>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "link", id: "HomeNewWorkItem", text: ec.l10n.localize("New work item"), url: sri.buildUrl("//Projects/QuickCreate").path + "?kind=workItem"})}]]></text></render-mode>
                    <container style="column q-gutter-sm items-start">
                        <link url="../Time/MyTime" text="My time" icon="sym_o_schedule"/>
                        <link url="../Projects/NewProject" text="New project" icon="sym_o_create_new_folder" condition="isManager"/>
                    </container>
                </box-body></container-box>

                <container-box><box-header title="Recently changed in my projects"/><box-body-nopad>
                    <form-list name="RecentChanges" list="activityList" skip-form="true" skip-header="true" paginate="false">
                        <field name="title"><default-field>
                            <render-mode><text type="qvt"><![CDATA[<div class="row no-wrap items-start"><q-icon name="${icon}" size="xs" class="q-mr-sm q-mt-xs m-muted"></q-icon><div>]]></text><text type="tui" template="false">[]</text></render-mode>
                            <link url="${url}" url-type="plain" text="${workEffortId}" link-type="anchor" style="text-mono q-mr-xs"/>
                            <label text="${title}" type="span"/>
                            <label text="${[projectName, authorName, whenText].filter((part) => part).join(' · ')}" type="div" style="text-caption m-muted"/>
                            <render-mode><text type="qvt"><![CDATA[</div></div>]]></text><text type="tui" template="false">[]</text></render-mode>
                        </default-field></field>
                    </form-list>
                    <section name="NoChanges" condition="!activityList.length"><widgets>
                        <label type="p" text="Nothing changed lately" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
        </widgets></section>
    </widgets>
</screen>
