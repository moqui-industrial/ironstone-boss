<!-- Workflows (design-projects.md §12 Workflows; style-guide §3.9 Settings): the flows of projects and work items (Default and
    Development, and any other flow between work statuses) with the projects that use each as their work item flow; the chosen
    flow's moves (from, to, name; Add or rename a move, Remove one); the work statuses with their sequence and color (Edit). The
    Default flow is the system's and the projects' own; its work moves are shown with the others it holds left out. Other status
    types are edited in the Tools app's Status Flows. Service: ironstone.projects.ProjectServices get#Workflows, store#FlowTransition,
    update#WorkStatus. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Workflows" default-menu-index="2" menu-image="sym_o_account_tree" menu-image-type="icon">

    <parameter name="statusFlowId"/>

    <transition name="storeTransition">
        <service-call name="ironstone.projects.ProjectServices.store#FlowTransition" in-map="{statusFlowId:statusFlowId, statusId:statusId, toStatusId:toStatusId,
                transitionName:transitionName, remove:remove}" out-map="moveOut"/>
        <actions><if condition="!ec.message.hasError()"><script>ec.message.addMessage(moveOut.message, 'success')</script></if></actions>
        <default-response url="."><parameter name="statusFlowId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="updateStatus">
        <service-call name="ironstone.projects.ProjectServices.update#WorkStatus" in-map="{statusId:statusId, description:description, sequenceNum:sequenceNum,
                statusColor:statusColor}" out-map="statusOut"/>
        <actions><if condition="!ec.message.hasError()"><script>ec.message.addMessage(statusOut.message, 'success')</script></if></actions>
        <default-response url="."><parameter name="statusFlowId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <script><![CDATA[
            const info = ec.service.sync().name('ironstone.projects.ProjectServices.get#Workflows').parameters({statusFlowId: statusFlowId || 'WorkEffortDevelopment'}).call() || {}
            flowList = Array.from(info.flowList || [])
            if (!statusFlowId || !flowList.some((flow) => flow.statusFlowId === statusFlowId)) statusFlowId = flowList.some((flow) => flow.statusFlowId === 'WorkEffortDevelopment') ? 'WorkEffortDevelopment' : (flowList[0]?.statusFlowId || 'Default')
            transitionList = Array.from(info.transitionList || [])
            statusList = Array.from(info.statusList || [])
            flowName = flowList.find((flow) => flow.statusFlowId === statusFlowId)?.description || statusFlowId
        ]]></script>
    </actions>

    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h5" text="Workflows" style="q-my-none"/>
            <container style="col"/>
            <link url="/qapps/tools/StatusFlows" url-type="plain" text="Other status flows (Tools)" link-type="anchor"/>
        </container>
        <container-box><box-header title="Flows"/><box-body-nopad>
            <form-list name="FlowList" list="flowList" skip-form="true" paginate="false">
                <field name="statusFlowId"><default-field title="Flow"><label text="${statusFlowId}" type="span" style="text-mono"/></default-field></field>
                <field name="description"><default-field title="Description">
                    <link url="." text="${description}" parameter-map="{statusFlowId:statusFlowId}" link-type="anchor"/></default-field></field>
                <field name="transitionCount" align="right"><default-field title="Work moves"><display/></default-field></field>
                <field name="projectCount" align="right"><default-field title="Projects using it"><display/></default-field></field>
            </form-list>
        </box-body-nopad></container-box>

        <container-row>
            <row-col md="7">
                <container-box><box-header title="Moves of ${flowName}"/>
                    <box-toolbar>
                        <container-dialog id="AddMoveDialog" button-text="Add or rename a move" icon="sym_o_add" width="520" title="A move of ${flowName}">
                            <form-single name="AddMove" transition="storeTransition">
                                <field name="statusFlowId"><default-field><hidden/></default-field></field>
                                <field name="statusId"><default-field title="From">
                                    <drop-down><list-options list="statusList" key="${statusId}" text="${description}"/></drop-down></default-field></field>
                                <field name="toStatusId"><default-field title="To">
                                    <drop-down><list-options list="statusList" key="${statusId}" text="${description}"/></drop-down></default-field></field>
                                <field name="transitionName"><default-field title="Name (the button: Approve, Begin, Hold)"><text-line size="24"/></default-field></field>
                                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                    <form-list name="FlowMatrix" list="transitionList" skip-form="true" paginate="false">
                        <field name="fromText"><default-field title="From"><display/></default-field></field>
                        <field name="toText"><default-field title="To"><display/></default-field></field>
                        <field name="transitionName"><default-field title="Name"><display/></default-field></field>
                        <field name="removeLink"><default-field title="">
                            <link url="storeTransition" link-type="hidden-form-link" text="Remove" confirmation="Remove the move ${fromText} to ${toText}?"
                                    parameter-map="{statusFlowId:statusFlowId, statusId:statusId, toStatusId:toStatusId, remove:'Y'}"/></default-field></field>
                    </form-list>
                    <section name="NoMoves" condition="!transitionList.length"><widgets>
                        <label type="p" text="No moves between work statuses" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
            <row-col md="5">
                <container-box><box-header title="Work statuses"/><box-body-nopad>
                    <form-list name="StatusList" list="statusList" skip-form="true" paginate="false">
                        <field name="description"><default-field title="Status">
                            <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${colorShown}">${WebUtilities.encodeHtml(description ?? '')}</q-chip>]]></text>
                                <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(description ?? "")}}]]></text></render-mode></default-field></field>
                        <field name="sequenceNum" align="right"><default-field title="Sequence"><display/></default-field></field>
                        <field name="statusColor"><default-field title="Color"><display text="${statusColor || ec.l10n.localize('(by its name)')}"/></default-field></field>
                        <field name="editStatus"><default-field title="">
                            <container-dialog id="EditStatusDialog" button-text="Edit" icon="sym_o_edit" width="440" title="Status ${description}">
                                <form-single name="EditStatus" transition="updateStatus">
                                    <field name="statusId"><default-field><hidden/></default-field></field>
                                    <field name="statusFlowId" from="context.get('statusFlowId')"><default-field><hidden/></default-field></field>
                                    <field name="description"><default-field title="Name"><text-line size="24"/></default-field></field>
                                    <field name="sequenceNum"><default-field title="Sequence"><text-line size="5" input-type="number"/></default-field></field>
                                    <field name="statusColor"><default-field title="Color">
                                        <drop-down allow-empty="true"><option key="grey-7" text="Grey: draft, proposed"/><option key="primary" text="Blue: in progress"/>
                                            <option key="warning" text="Amber: waiting"/><option key="positive" text="Green: done well"/>
                                            <option key="negative" text="Red: ended badly"/><option key="info" text="Teal: informational"/></drop-down></default-field></field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                </form-single>
                            </container-dialog></default-field></field>
                    </form-list>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
