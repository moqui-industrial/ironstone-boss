<!-- ProjectTeam (design-projects.md §4 ProjectTeam): boxes of the members and their roles (Add member, End for those who manage
    the project), the teams on it (OrgTeam) and the client contacts (Customer, ClientManager, ClientBilling, CustomerBillTo) with
    their email and whether they have a user; client sign-in itself is impl-projects.md P10 (ProjectSettings keeps the choice).
    The allocations box comes with P7. Service: ironstone.ProjectServices get#ProjectTeam, add#ProjectMember, end#ProjectMember. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Team" default-menu-index="9">

    <transition name="addMember">
        <actions>
            <service-call name="ironstone.ProjectServices.add#ProjectMember" out-map="addOut" in-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(addOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endMember">
        <actions>
            <service-call name="ironstone.ProjectServices.end#ProjectMember" out-map="endOut" in-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(endOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="peopleSearch" read-only="true">
        <actions>
            <service-call name="ironstone.TaskServices.search#Assignees" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.optionList || [])</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <!-- organizations (a team, a client) or people (a client contact), not another user's personal contacts -->
    <transition name="partySearch" read-only="true">
        <actions>
            <entity-find entity-name="mantle.party.PartyDetail" list="partyList" limit="20">
                <econdition field-name="partyTypeEnumId" from="kind == 'person' ? 'PtyPerson' : 'PtyOrganization'"/>
                <econditions combine="or">
                    <econdition field-name="organizationName" operator="like" value="%${term}%" ignore-case="true" ignore="!term"/>
                    <econdition field-name="firstName" operator="like" value="%${term}%" ignore-case="true" ignore="!term"/>
                    <econdition field-name="lastName" operator="like" value="%${term}%" ignore-case="true" ignore="!term"/>
                </econditions>
                <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                <econdition field-name="privateOwnerUserId" from="ec.user.userId" or-null="true"/>
                <order-by field-name="^organizationName,^firstName,^lastName"/>
            </entity-find>
            <script>ec.web.sendJsonResponse(Array.from(partyList).map((party) => ({value: party.partyId,
                label: party.organizationName || [party.firstName, party.lastName].filter((part) => part).join(' ') || party.partyId})))</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            if (!recordFound) return
            const team = ec.service.sync().name('ironstone.ProjectServices.get#ProjectTeam').parameters({workEffortId: workEffortId}).call() || {}
            memberList = Array.from(team.memberList || [])
            teamList = Array.from(team.teamList || [])
            clientList = Array.from(team.clientList || [])
            roleOptions = Array.from(team.roleOptions || [])
            canManage = !!team.canManage
        ]]></script>
    </actions>

    <widgets>
        <section name="TeamFound" condition="recordFound"><widgets>
        <container-box><box-header title="Members · ${memberList.length}"/>
            <box-toolbar>
                <container-dialog id="TeamAddMemberDialog" button-text="Add member" icon="sym_o_person_add" width="520" title="Add a member to ${project.workEffortName}" condition="canManage">
                    <form-single name="AddMember" transition="addMember">
                        <field name="workEffortId"><default-field><hidden/></default-field></field>
                        <field name="partyId"><default-field title="Person">
                            <drop-down><dynamic-options transition="peopleSearch" server-search="true" min-length="0"/></drop-down></default-field></field>
                        <field name="roleTypeId" from="'Programmer'"><default-field title="Role">
                            <drop-down><list-options list="roleOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar>
            <box-body-nopad>
            <form-list name="TeamMembers" list="memberList" skip-form="true" paginate="false">
                <field name="name"><default-field title="Person">
                    <render-mode><text type="qvt"><![CDATA[<span class="row inline no-wrap items-center"><m-avatar name="${WebUtilities.encodeHtml(name ?? '')}"${userId ? ' user-id="' + WebUtilities.encodeHtml(userId) + '"' : ''} size="24px" class="q-mr-sm"></m-avatar>${WebUtilities.encodeHtml(name ?? '')}</span>]]></text>
                        <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(name ?? "")}}]]></text></render-mode></default-field></field>
                <field name="roleText"><default-field title="Role"><display/></default-field></field>
                <field name="fromText"><default-field title="From"><display/></default-field></field>
                <field name="statusText"><default-field title="Status"><display/></default-field></field>
                <field name="endLink"><conditional-field condition="canManage" title="">
                    <link url="endMember" link-type="hidden-form-link" text="End" confirmation="Take ${name} off ${project.workEffortName} as ${roleText}?"
                            parameter-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/></conditional-field>
                    <default-field><ignored/></default-field></field>
            </form-list>
            <section name="NoMembers" condition="!memberList.length"><widgets>
                <label type="p" text="No members yet" style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>

        <container-row>
            <row-col md="6">
                <container-box><box-header title="Teams"/>
                    <box-toolbar>
                        <container-dialog id="TeamAddTeamDialog" button-text="Add team" icon="sym_o_groups" width="520" title="Add a team to ${project.workEffortName}" condition="canManage">
                            <form-single name="AddTeam" transition="addMember">
                                <field name="workEffortId"><default-field><hidden/></default-field></field>
                                <field name="roleTypeId" from="'OrgTeam'"><default-field><hidden/></default-field></field>
                                <field name="partyId"><default-field title="Team">
                                    <drop-down><dynamic-options transition="partySearch" server-search="true" min-length="0" parameter-map="{kind:'organization'}"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                    <form-list name="TeamGroups" list="teamList" skip-form="true" skip-header="true" paginate="false">
                        <field name="name"><default-field><display/></default-field></field>
                        <field name="fromText"><default-field><label text="${fromText}" type="span" style="text-caption m-muted"/></default-field></field>
                        <field name="endLink"><conditional-field condition="canManage" title="">
                            <link url="endMember" link-type="hidden-form-link" text="End" confirmation="Take ${name} off ${project.workEffortName}?"
                                    parameter-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/></conditional-field>
                            <default-field><ignored/></default-field></field>
                    </form-list>
                    <section name="NoTeams" condition="!teamList.length"><widgets>
                        <label type="p" text="No teams on it" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
            <row-col md="6">
                <container-box><box-header title="Client contacts"/>
                    <box-toolbar>
                        <container-dialog id="TeamAddClientDialog" button-text="Add contact" icon="sym_o_contact_mail" width="520" title="Add a client contact to ${project.workEffortName}" condition="canManage">
                            <form-single name="AddClientContact" transition="addMember">
                                <field name="workEffortId"><default-field><hidden/></default-field></field>
                                <field name="partyId"><default-field title="Person">
                                    <drop-down><dynamic-options transition="partySearch" server-search="true" min-length="0" parameter-map="{kind:'person'}"/></drop-down></default-field></field>
                                <field name="roleTypeId" from="'ClientManager'"><default-field title="Role">
                                    <drop-down><option key="ClientManager" text="Client manager"/><option key="ClientBilling" text="Client billing"/>
                                        <option key="Customer" text="Customer"/></drop-down></default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                    <form-list name="ClientContacts" list="clientList" skip-form="true" paginate="false">
                        <field name="name"><default-field title="Contact"><display/></default-field></field>
                        <field name="roleText"><default-field title="Role"><display/></default-field></field>
                        <field name="email"><default-field title="Email"><display/></default-field></field>
                        <field name="signInText"><default-field title="Sign-in"><display/></default-field></field>
                        <field name="endLink"><conditional-field condition="canManage" title="">
                            <link url="endMember" link-type="hidden-form-link" text="End" confirmation="Take ${name} off ${project.workEffortName} as ${roleText}?"
                                    parameter-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/></conditional-field>
                            <default-field><ignored/></default-field></field>
                    </form-list>
                    <section name="NoClients" condition="!clientList.length"><widgets>
                        <label type="p" text="No client contacts: an internal project" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
        <label type="p" text="Allocations (who is planned on the project, hours per week) come with Resources." style="text-caption m-muted"/>
        </widgets></section>
    </widgets>
</screen>
