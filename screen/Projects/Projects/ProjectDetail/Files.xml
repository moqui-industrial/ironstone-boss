<!-- ProjectFiles (design-projects.md §4 ProjectFiles): the record-files element over the project (design-drawers-commons §9
    RecordFiles): the WorkEffortContent files under the Records drive's work folder. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Files" default-menu-index="4">
    <widgets>
        <section name="FilesFound" condition="recordFound"><widgets>
            <record-files id="ProjectFiles" record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}"/>
        </widgets></section>
    </widgets>
</screen>
