<!-- MilestoneDetail (design-projects.md §4 MilestoneDetail; style-guide §3.3 Detail): a milestone. The title row: its name, the
    project chip (a link to the project's Roadmap tab), the stages of the Default flow (read only: the moves are the actions), the
    start (a milestone with a start is a phase) and due dates, and its description; for the project's team the next move as the
    primary (Begin, Reach as Complete, Close, Re-open), Edit (name, dates, description) and the More menu (the other moves, Move
    unfinished items to another milestone or out of any). The number cards: Items done of the items, Percent done, Hours (done
    of the estimate) and Remaining hours. The boxes: Work items, by state with the chips Not started, In progress and Done, as
    WorkItems shows them (only those the user may see), Add items (a search of the project's items) and Remove for the team;
    Chatter as the right column from 1440 px. The gate (approval), the billing share and the deliverables come with
    impl-projects.md P8. Services: ironstone.PlanningServices get#PlanItemDetail, save#PlanItem, set#PlanItemItems,
    move#UnfinishedItems, search#PlanItemCandidates. A milestone of a project the user does not see is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Milestone" default-menu-include="false">

    <parameter name="workEffortId" required="true"/>
    <parameter name="state"/>

    <transition name="workItemDetail"><default-response url="//Projects/WorkItems/WorkItemDetail"/></transition>
    <transition name="roadmap"><default-response url="../Roadmap"/></transition>
    <transition name="savePlanItem">
        <actions>
            <service-call name="ironstone.PlanningServices.save#PlanItem" out-map="saveOut" in-map="{workEffortId:workEffortId, workEffortName:workEffortName,
                    description:(description ?? ''), startDay:(startDay ?? ''), dueDay:(dueDay ?? '')}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(saveOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="changeStatus">
        <actions>
            <service-call name="ironstone.PlanningServices.update#PlanItemField" out-map="statusOut" in-map="{workEffortId:workEffortId, field:'status', value:statusId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(statusOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="addItems">
        <actions>
            <service-call name="ironstone.PlanningServices.set#PlanItemItems" out-map="itemsOut" in-map="{workEffortId:workEffortId, workEffortIds:itemWorkEffortIds}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(itemsOut.message, itemsOut.failedCount ? 'warning' : 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="removeItem">
        <actions>
            <service-call name="ironstone.PlanningServices.set#PlanItemItems" out-map="itemsOut" in-map="{workEffortId:workEffortId, workEffortIds:itemWorkEffortId, remove:true}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(itemsOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="moveUnfinished">
        <actions>
            <service-call name="ironstone.PlanningServices.move#UnfinishedItems" out-map="moveOut" in-map="{workEffortId:workEffortId, toWorkEffortId:toWorkEffortId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(moveOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <!-- Add items: the project's work items not in it, by key or words -->
    <transition name="searchItems" read-only="true">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('ironstone.PlanningServices.search#PlanItemCandidates').parameters({workEffortId: workEffortId || '', term: term || ''}).call() || {}
            ec.message.clearErrors()
            ec.web.sendJsonResponse(out.optionList || [])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <actions><script><![CDATA[
        const out = ec.service.sync().name('ironstone.PlanningServices.get#PlanItemDetail').parameters({workEffortId: workEffortId || '', kind: 'milestone'}).call() || {}
        ec.message.clearErrors()
        recordFound = !!out.detail
        if (!recordFound) return
        const L = (text) => ec.l10n.localize(text)
        const enc = (text) => String(text == null ? '' : text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\u0022/g, '&quot;').replace(/\u0027/g, '&#39;')
        milestone = out.detail
        canUpdate = !!milestone.canUpdate
        const states = [['all', 'All', 'sym_o_select_all', milestone.rowList.length], ['notStarted', 'Not started', 'sym_o_radio_button_unchecked', milestone.rowList.filter((row) => row.state === 'notStarted').length],
            ['inProgress', 'In progress', 'sym_o_pending', milestone.rowList.filter((row) => row.state === 'inProgress').length],
            ['done', 'Done', 'sym_o_task_alt', milestone.rowList.filter((row) => row.state === 'done').length]]
        if (!states.some((entry) => entry[0] === state)) state = 'all'
        stateChips = states.map(([key, label, icon, count]) => ({label: L(label) + ' · ' + count, icon: icon, on: key === state, params: {workEffortId: workEffortId, state: key}}))
        itemRows = state === 'all' ? milestone.rowList : milestone.rowList.filter((row) => row.state === state)
        itemRowsCount = itemRows.length
        projectUrl = '/qapps/Projects/Projects/ProjectDetail/Roadmap?workEffortId=' + encodeURIComponent(milestone.rootWorkEffortId)
        const dates = [milestone.startText ? L('Start') + ' ' + milestone.startText : '', milestone.dueText ? L('Due') + ' ' + milestone.dueText : '',
            milestone.reachedText ? L('Reached') + ' ' + milestone.reachedText : ''].filter((part) => part)
        factsHtml = '<div class="row items-center q-gutter-x-md q-mt-xs text-body2">'
            + '<m-link href="' + enc(projectUrl) + '"><q-chip dense square clickable icon="sym_o_folder" class="q-ma-none m-tonal text-primary">'
            + enc(milestone.projectName + ' (' + milestone.rootWorkEffortId + ')') + '</q-chip></m-link>'
            + (dates.length ? '<span class="' + (milestone.overdue ? 'text-warning' : '') + '"><q-icon name="sym_o_date_range" size="xs" class="q-mr-xs m-muted"></q-icon>' + enc(dates.join(' · ')) + '</span>' : '')
            + (milestone.startDay ? '<span class="text-caption m-muted">' + enc(L('A phase on the timeline')) + '</span>' : '') + '</div>'
        factsTui = {t: 'text', id: 'MilestoneFacts', text: [milestone.projectName + ' (' + milestone.rootWorkEffortId + ')'].concat(dates).join(' · ')}
        // the primary move along the flow, and the others in More
        const moveLabels = {WeInProgress: ['WeInPlanning', 'WeApproved'].includes(milestone.statusId) ? 'Begin' : 'Resume', WeComplete: 'Reach', WeClosed: 'Close',
            WeInPlanning: 'Re-open', WeApproved: 'Approve', WeOnHold: 'Hold', WeCancelled: 'Cancel'}
        const primaryBy = {WeInPlanning: 'WeInProgress', WeApproved: 'WeInProgress', WeInProgress: 'WeComplete', WeOnHold: 'WeInProgress', WeComplete: 'WeClosed',
            WeClosed: 'WeInPlanning', WeCancelled: 'WeInPlanning'}
        const moves = canUpdate ? milestone.moveIds.filter((id) => moveLabels[id]) : []
        const primaryId = primaryBy[milestone.statusId]
        primaryMove = primaryId && moves.includes(primaryId) ? {statusId: primaryId, label: L(moveLabels[primaryId])} : null
        otherMoves = moves.filter((id) => id !== primaryId).map((id) => ({statusId: id, label: L(moveLabels[id]), danger: id === 'WeCancelled'}))
        moveIds = otherMoves.map((move) => move.statusId)
        beginLabel = L(moveLabels.WeInProgress)
        unfinishedCount = milestone.rowList.filter((row) => row.state === 'notStarted' || row.state === 'inProgress').length
        moveOptions = [{key: '', text: L('Out of any milestone')}].concat(milestone.otherOptions)
        doneValue = milestone.doneOfTotal
        percentValue = milestone.percentDone + '%'
        hoursValue = milestone.hoursText || '—'
        pointsValue = milestone.pointsText || '—'
    ]]></script></actions>

    <widgets>
        <section name="MilestoneNotFound" condition="!recordFound"><widgets>
            <container-box type="warning"><box-header title="Not available"/><box-body>
                <label type="p" text="Milestone ${workEffortId} is not available: it does not exist, or it is of a project you do not see."/>
                <link url="roadmap" link-type="anchor" text="Back to the roadmap"/>
            </box-body></container-box>
        </widgets></section>

        <section name="MilestoneFound" condition="recordFound"><widgets>
            <context record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}" title="${milestone.workEffortName}"/>
            <container style="row items-start q-col-gutter-sm q-mb-sm m-plan-header">
                <container style="col-12 col-md">
                    <container style="row items-center no-wrap">
                        <render-mode><text type="qvt"><![CDATA[<q-icon name="sym_o_flag" size="sm" class="q-mr-sm m-muted"></q-icon>]]></text><text type="tui" template="false">[]</text></render-mode>
                        <label text="${milestone.workEffortName}" type="h5" style="q-my-none"/>
                        <label text="${workEffortId}" type="span" style="text-caption text-mono m-muted q-ml-sm"/>
                    </container>
                    <status-bar id="MilestoneStatusBar" status-id="${milestone.statusId}" status-flow-id="Default" stages="${milestone.stageStatusIds}" read-only="true"/>
                    <render-mode><text type="qvt"><![CDATA[${factsHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify(factsTui)}]]></text></render-mode>
                </container>
                <container style="col-12 col-md-auto row items-center q-gutter-x-xs q-gutter-y-xs">
                    <section name="MilestonePrimaryMove" condition="primaryMove"><widgets>
                        <link url="changeStatus" link-type="hidden-form" text="${primaryMove.label}" btn-type="primary" icon="sym_o_arrow_forward"
                                confirmation="${primaryMove.label}: ${milestone.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:primaryMove.statusId}"/>
                    </widgets></section>
                    <container-dialog id="MilestoneEditDialog" button-text="Edit" icon="sym_o_edit" width="520" title="Edit ${milestone.workEffortName}" condition="canUpdate">
                        <form-single name="MilestoneForm" transition="savePlanItem" focus-field="workEffortName">
                            <field name="workEffortId"><default-field><hidden/></default-field></field>
                            <field name="workEffortName" from="milestone.workEffortName"><default-field title="Name"><text-line size="40"/></default-field></field>
                            <field name="startDay" from="milestone.startDay"><default-field title="Start (when it marks a phase)"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                            <field name="dueDay" from="milestone.dueDay"><default-field title="Due"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                            <field name="description" from="milestone.description"><default-field title="Description"><text-area rows="3" cols="60"/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            <field-layout><field-ref name="workEffortName"/><field-row><field-ref name="startDay"/><field-ref name="dueDay"/></field-row>
                                <field-ref name="description"/><field-ref name="submitButton"/></field-layout>
                        </form-single>
                    </container-dialog>
                    <button-menu text="More" icon="more_horiz" condition="canUpdate">
                        <link url="changeStatus" link-type="hidden-form-link" text="${beginLabel}" icon="sym_o_play_arrow" condition="moveIds.includes('WeInProgress')"
                                confirmation="${beginLabel}: ${milestone.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeInProgress'}"/>
                        <link url="changeStatus" link-type="hidden-form-link" text="Hold" icon="sym_o_pause" condition="moveIds.includes('WeOnHold')"
                                confirmation="Hold: ${milestone.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeOnHold'}"/>
                        <link url="changeStatus" link-type="hidden-form-link" text="Reach" icon="sym_o_flag_check" condition="moveIds.includes('WeComplete')"
                                confirmation="Reach: ${milestone.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeComplete'}"/>
                        <link url="changeStatus" link-type="hidden-form-link" text="Close" icon="sym_o_archive" condition="moveIds.includes('WeClosed')"
                                confirmation="Close: ${milestone.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeClosed'}"/>
                        <link url="changeStatus" link-type="hidden-form-link" text="Re-open" icon="sym_o_undo" condition="moveIds.includes('WeInPlanning')"
                                confirmation="Re-open: ${milestone.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeInPlanning'}"/>
                        <link url="changeStatus" link-type="hidden-form-link" text="Cancel" icon="sym_o_cancel" btn-type="danger" condition="moveIds.includes('WeCancelled')"
                                confirmation="Cancel: ${milestone.workEffortName}?" parameter-map="{workEffortId:workEffortId, statusId:'WeCancelled'}"/>
                        <container-dialog id="MilestoneMoveDialog" button-text="Move unfinished items" icon="sym_o_low_priority" width="480" title="Move the unfinished items of ${milestone.workEffortName}"
                                condition="unfinishedCount">
                            <label type="p" text="${unfinishedCount} work items are not done."/>
                            <form-single name="MoveUnfinished" transition="moveUnfinished">
                                <field name="workEffortId"><default-field><hidden/></default-field></field>
                                <field name="toWorkEffortId" from="milestone.otherOptions.length ? milestone.otherOptions[0].key : ''"><default-field title="To">
                                    <radio><list-options list="moveOptions" key="${key}" text="${text}"/></radio></default-field></field>
                                <field name="submitButton"><default-field title="Move"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <link url="/qapps/Projects/WorkItems" url-type="plain" text="In Work items" icon="sym_o_checklist" parameter-map="{rootWorkEffortId:milestone.rootWorkEffortId, milestoneId:workEffortId, list:'all'}"/>
                    </button-menu>
                </container>
            </container>
            <section name="MilestoneDescription" condition="milestone.description"><widgets>
                <markdown-view text="${milestone.description}"/>
            </widgets></section>

            <dashboard min-width="150" style="q-mb-sm">
                <number-card title="Items done" value="${doneValue}" icon="sym_o_task_alt" size="sm"/>
                <number-card title="Done" value="${percentValue}" icon="sym_o_percent" size="sm"/>
                <number-card title="${milestone.estimateUnit == 'points' ? 'Points done' : 'Hours done'}" value="${milestone.estimateUnit == 'points' ? pointsValue : hoursValue}" icon="sym_o_schedule" size="sm"/>
                <number-card title="Due" value="${milestone.dueText || '—'}" icon="sym_o_event" size="sm"/>
            </dashboard>

            <container style="row q-col-gutter-sm">
                <container style="col-12 col-lg-8">
                    <container style="row q-gutter-xs q-mb-sm m-task-chips">
                        <section-iterate name="MilestoneStateChip" list="stateChips" entry="chip"><widgets>
                            <section name="MilestoneStateChipOn" condition="chip.on"><widgets>
                                <link url="." link-type="anchor-button" btn-type="primary" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                            </widgets><fail-widgets>
                                <link url="." link-type="anchor-button" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                            </fail-widgets></section>
                        </widgets></section-iterate>
                    </container>
                    <container-box><box-header title="Work items · ${itemRowsCount}"/>
                        <box-toolbar>
                            <container-dialog id="MilestoneAddItemsDialog" button-text="Add items" icon="sym_o_add" width="560" title="Add work items to ${milestone.workEffortName}" condition="canUpdate">
                                <form-single name="AddMilestoneItems" transition="addItems">
                                    <field name="workEffortId"><default-field><hidden/></default-field></field>
                                    <field name="itemWorkEffortIds"><default-field title="Work items (key or words)">
                                        <drop-down allow-multiple="true"><dynamic-options transition="searchItems" server-search="true" min-length="0" parameter-map="{workEffortId:workEffortId}"/></drop-down></default-field></field>
                                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                                </form-single>
                                <label type="p" text="An item is in one milestone at a time: adding it here takes it out of another." style="text-caption m-muted"/>
                            </container-dialog>
                        </box-toolbar>
                        <box-body-nopad>
                        <form-list name="MilestoneItems" list="itemRows" skip-form="true" paginate="false" select-columns="true">
                            <field name="workEffortId"><default-field title="Key">
                                <link url="workItemDetail" text="${workEffortId}" parameter-map="{workEffortId:workEffortId}" link-type="anchor" style="text-mono text-no-wrap"/></default-field></field>
                            <field name="purposeEnumId"><default-field title="Type">
                                <render-mode><text type="qvt"><![CDATA[<q-icon name="${WebUtilities.encodeHtml(typeIcon ?? '')}" size="xs" class="m-muted"><q-tooltip>${WebUtilities.encodeHtml(purposeLabel ?? '')}</q-tooltip></q-icon>]]></text>
                                    <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(purposeLabel ?? "")}}]]></text></render-mode></default-field></field>
                            <field name="workEffortName"><default-field title="Title">
                                <link url="workItemDetail" text="${workEffortName}" parameter-map="{workEffortId:workEffortId}" style="${state == 'done' || state == 'cancelled' ? 'm-muted' : ''}"/></default-field></field>
                            <field name="statusId"><default-field title="Status">
                                <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}" data-status="${statusId}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip>]]></text>
                                    <text type="tui"><![CDATA[{"t": "text", "style": "strong", "text": ${JSON.stringify(statusLabel ?? "")}}]]></text></render-mode></default-field></field>
                            <field name="priority"><default-field title="Priority"><display text="${priorityText || ''}"/></default-field></field>
                            <field name="assigneePartyId"><default-field title="Assignees"><display text="${assigneeText || ''}"/></default-field></field>
                            <field name="dueText"><default-field title="Due"><label text="${dueText || ''}" type="span" style="text-no-wrap ${overdue ? 'text-warning' : ''}"/></default-field></field>
                            <field name="estimatedWorkTime" align="right"><default-field title="Est. (h)"><display format="#,##0.##"/></default-field></field>
                            <field name="actualWorkTime" align="right"><default-field title="Actual (h)"><display format="#,##0.##"/></default-field></field>
                            <field name="removeItem"><conditional-field condition="canUpdate" title="">
                                <link url="removeItem" link-type="hidden-form-link" text="Remove" icon="sym_o_remove_circle_outline"
                                        confirmation="Take ${workEffortId} out of ${milestone.workEffortName}?" parameter-map="{workEffortId:milestone.workEffortId, itemWorkEffortId:workEffortId}"/>
                            </conditional-field><default-field title=""><label text="" type="span"/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="workEffortId"/><field-ref name="workEffortName"/></column>
                                <column><field-ref name="statusId"/><field-ref name="dueText"/></column>
                            </columns>
                        </form-list>
                        <label type="p" text="${milestone.rowList.length ? 'No work items in this state.' : 'No work items in this milestone yet: add them here, or set the milestone on a work item.'}" style="m-muted q-pa-sm q-mb-none" condition="!itemRows.length"/>
                    </box-body-nopad></container-box>
                </container>
                <container style="col-12 col-lg-4">
                    <chatter id="MilestoneChatter" record-entity="mantle.work.effort.WorkEffort" record-id="${workEffortId}" default-tab="message"/>
                </container>
            </container>
        </widgets></section>
    </widgets>
</screen>
