<!-- NewProject step 2, ProjectTeamStep (design-projects.md §4 NewProject): who works on the project, a person and a project role
    each (Add member; a template's members came with it), with End on a row; with hours a week, from and thru the member is also
    allocated on it (mantle.work.ResourceServices.create#Allocation through ironstone.ResourceServices.save#Allocation: allocated at
    once for a Projects manager, else requested; impl-projects.md P7), and the project's allocations are listed below. Next goes on. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Team" default-menu-index="2" menu-image="sym_o_groups" menu-image-type="icon">

    <parameter name="workEffortId"/>

    <transition name="addMember">
        <actions>
            <service-call name="ironstone.ProjectServices.add#ProjectMember" out-map="addOut" in-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(addOut.message, 'success')</script></if>
            <!-- the member's allocation when hours a week are given -->
            <if condition="!ec.message.hasError() &amp;&amp; hoursPerWeek"><then>
                <service-call name="ironstone.ResourceServices.save#Allocation" out-map="allocOut" in-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId,
                        fromDate:allocFromDate, thruDate:allocThruDate, amount:hoursPerWeek, unit:'h'}"/>
                <if condition="!ec.message.hasError()"><script>ec.message.addMessage(allocOut.message, 'success')</script></if>
            </then></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="endMember">
        <actions>
            <service-call name="ironstone.ProjectServices.end#ProjectMember" out-map="endOut" in-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(endOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="workEffortId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="teamDone"><default-response url="."><parameter name="workEffortId"/></default-response></transition>
    <transition name="peopleSearch" read-only="true">
        <actions>
            <service-call name="ironstone.TaskServices.search#Assignees" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.optionList || [])</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            if (!draftProject) return
            const team = ec.service.sync().name('ironstone.ProjectServices.get#ProjectTeam').parameters({workEffortId: workEffortId}).call() || {}
            memberList = Array.from(team.memberList || [])
            roleOptions = Array.from(team.roleOptions || [])
            const allocations = ec.service.sync().name('ironstone.ResourceServices.get#ProjectAllocations').parameters({workEffortId: workEffortId}).call() || {}
            ec.message.clearErrors()
            allocationList = Array.from(allocations.allocationList || [])
            // the allocation's days default to the project's start and target dates, else four weeks from this week
            const day = (value) => value ? ec.l10n.format(value, 'yyyy-MM-dd') : null
            const today = ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')
            allocFromDefault = day(draftProject.estimatedStartDate) || today
            allocThruDefault = day(draftProject.estimatedCompletionDate) || new Date(Date.parse(allocFromDefault + 'T12:00:00Z') + 27 * 86400000).toISOString().slice(0, 10)
        ]]></script>
    </actions>

    <widgets>
        <section name="NotStarted" condition="!draftProject"><widgets>
            <container-box type="warning"><box-body>
                <label type="p" text="Start the project first: this step works on the project the Start step makes." style="q-mb-xs"/>
                <link url="../Start" link-type="anchor" text="Back to Start"/>
            </box-body></container-box>
        </widgets></section>
        <section name="TeamStep" condition="draftProject"><widgets>
            <container-box><box-header title="Who works on it"/>
                <box-toolbar>
                    <container-dialog id="NewProjectAddMember" button-text="Add member" icon="sym_o_person_add" width="520" title="Add a member">
                        <form-single name="AddMember" transition="addMember">
                            <field name="workEffortId"><default-field><hidden/></default-field></field>
                            <field name="partyId"><default-field title="Person">
                                <drop-down><dynamic-options transition="peopleSearch" server-search="true" min-length="0"/></drop-down></default-field></field>
                            <field name="roleTypeId" from="'Programmer'"><default-field title="Role">
                                <drop-down><list-options list="roleOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="hoursPerWeek"><default-field title="Hours a week (optional: allocates them)"><text-line size="6" input-type="number"/></default-field></field>
                            <field name="allocFromDate" from="allocFromDefault"><default-field title="From"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                            <field name="allocThruDate" from="allocThruDefault"><default-field title="Thru"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            <field-layout>
                                <field-ref name="workEffortId"/><field-ref name="partyId"/><field-ref name="roleTypeId"/><field-ref name="hoursPerWeek"/>
                                <field-row><field-ref name="allocFromDate"/><field-ref name="allocThruDate"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body-nopad>
                <form-list name="NewProjectMembers" list="memberList" skip-form="true" paginate="false">
                    <field name="name"><default-field title="Person"><display/></default-field></field>
                    <field name="roleText"><default-field title="Role"><display/></default-field></field>
                    <field name="endLink"><default-field title="">
                        <link url="endMember" link-type="hidden-form-link" text="End" parameter-map="{workEffortId:workEffortId, partyId:partyId, roleTypeId:roleTypeId}"/></default-field></field>
                </form-list>
                <section name="NoMembers" condition="!memberList.length"><widgets>
                    <label type="p" text="No members yet" style="m-muted q-pa-sm q-mb-none"/>
                </widgets></section>
            </box-body-nopad></container-box>
            <container-box><box-header title="Allocations · ${allocationList.length}"/><box-body-nopad>
                <form-list name="NewProjectAllocations" list="allocationList" skip-form="true" paginate="false">
                    <field name="whoText"><default-field title="Person or role"><display/></default-field></field>
                    <field name="periodText"><default-field title="When"><display/></default-field></field>
                    <field name="amountText" align="right"><default-field title="Hours"><display/></default-field></field>
                    <field name="statusLabel"><default-field title="Status">
                        <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip>]]></text>
                            <text type="tui"><![CDATA[{"t": "text", "text": ${JSON.stringify(statusLabel ?? "")}}]]></text></render-mode></default-field></field>
                </form-list>
                <section name="NoAllocations" condition="!allocationList.length"><widgets>
                    <label type="p" text="No one is allocated yet: give a member hours a week, or plan them later in Resources." style="m-muted q-pa-sm q-mb-none"/>
                </widgets></section>
            </box-body-nopad></container-box>
            <form-single name="ProjectTeamStep" transition="teamDone">
                <field name="workEffortId"><default-field><hidden/></default-field></field>
            </form-single>
        </widgets></section>
    </widgets>
</screen>
