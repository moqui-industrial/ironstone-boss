<!-- The client invoice with its time detail (design-projects.md §14; style-guide §8 Print documents; impl-projects.md P8a),
    InvoiceDetail's Print and PDF: with renderMode=html-print the printed invoice (ironstone.BillingServices.get#InvoicePrint: the
    vendor, the client, the dates and terms, the lines and the total, and the time behind each line when the project keeps time detail
    on its invoices), every value escaped; under /fop the same as a PDF, and the attachment of the email Send makes. A sibling of
    InvoiceDetail, so the page has none of the detail's header; in another render mode it links to the printed page. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Invoice print" default-menu-include="false">

    <parameter name="invoiceId" required="true"/>

    <actions>
        <service-call name="ironstone.BillingServices.get#InvoicePrint" in-map="{invoiceId:invoiceId}" out-map="printOut"/>
        <script><![CDATA[
            ec.message.clearErrors()
            printHtml = printOut.printHtml || ''
            printUrl = '/apps/Projects/Billing/InvoicePrint?renderMode=html-print&invoiceId=' + encodeURIComponent(invoiceId)
        ]]></script>
    </actions>

    <widgets>
        <render-mode>
            <text type="html-print"><![CDATA[${printHtml}]]></text>
            <text type="qvt"><![CDATA[<p><a href="${WebUtilities.encodeHtml(printUrl)}" target="_blank">${ec.l10n.localize('Open the printable invoice')}</a></p>]]></text>
            <text type="tui"><![CDATA[${JSON.stringify({t: "link", id: "InvoicePrint", text: ec.l10n.localize("Open the printable invoice"), url: printUrl})}]]></text>
        </render-mode>
    </widgets>
</screen>
