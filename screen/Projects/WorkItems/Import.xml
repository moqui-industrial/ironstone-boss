<!-- WorkItemImport (design-projects.md §5 WorkItemImport; style-guide §3.10 Wizard): work items from a CSV file with Jira, Redmine
    and GitHub issues presets, as a subscreens-panel type="wizard" over the step screens in Import/: Source (the file, its kind,
    character set and the project), Mapping (each target field to a column, the preset's to start, and the file's types, statuses
    and priorities to the project's), Options (make missing milestones, releases, components, sprints and labels; rows already
    imported skipped or updated), Preview (the first 50 rows as they will be made, with their problems) and Import (run it, then
    the result with the failed rows and their reasons). Next submits a step's form to its transition, whose answer carries
    importId on to the next step; the file and the choices are kept in the user's own import folder between the steps
    (service/ironstone/projects/WorkItemImportServices.xml). Managers only (BOSS_PROJECTS_MANAGERS in data/BossSetupData.xml). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Import" default-menu-index="3" server-static="qvt" menu-image="sym_o_drive_folder_upload" menu-image-type="icon">

    <parameter name="importId"/>
    <subscreens default-item="Source"/>

    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h5" text="Import work items" style="q-my-none"/>
            <container style="col"/>
            <link url="../List" text="Work items" icon="sym_o_checklist" style="q-ml-sm"/>
        </container>
        <subscreens-panel id="WorkItemImportWizard" type="wizard" finish-text="Import"/>
    </widgets>
</screen>
