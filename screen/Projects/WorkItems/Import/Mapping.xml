<!-- Import step 2, ImportMapping (design-projects.md §5 WorkItemImport): what each column is. One field per target (original key,
    original id, title, type, status, priority, assignee, reporter, created, start, due, resolved, estimate, story points, description,
    parent, epic, labels, milestone, release, sprint, component), each choosing a column of the file (with its first values; a
    column the file repeats, such as Jira's Labels and Sprint, counts once with its number), started from the preset; the estimate
    in hours or seconds (Jira's Original Estimate); and the value maps: each type, status and priority the file has (up to 20, 20
    and 10) to the project's work item types, the statuses of its flow, and 1 to 9. The step form's fields are fixed in the screen
    (a target's field, val_ fields by position); Auto-map goes back to the preset. saveMapping keeps it all in the import's draft.
    (The design's "each column to a field" is the other way round here, a field to a column: an export with a hundred columns
    would otherwise be a hundred fields, impl-projects.md P4c.) -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Mapping" default-menu-index="2" server-static="qvt">

    <parameter name="importId"/>

    <transition name="saveMapping">
        <actions><script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            const out = ec.service.sync().name('ironstone.WorkItemImportServices.get#ImportMappingInfo').parameters({importId: importId}).call() || {}
            const info = out.info
            if (!info) { ec.message.addError(L('This import is not available; start again from the file')); return }
            const columnMapping = {}
            for (const target of info.targets) {
                const value = context.get('map_' + target.fieldName)
                columnMapping[target.fieldName] = value ? String(value) : ''
            }
            if (!columnMapping.title) { ec.message.addValidationError(null, 'map_title', null, L('Choose the column of the title'), null); return }
            const valueMaps = {type: {}, status: {}, priority: {}}
            info.typeValues.forEach((entry, index) => { const value = context.get('vt_' + index); if (value) valueMaps.type[entry.value] = String(value) })
            info.statusValues.forEach((entry, index) => { const value = context.get('vs_' + index); if (value) valueMaps.status[entry.value] = String(value) })
            info.priorityValues.forEach((entry, index) => { const value = context.get('vp_' + index); if (value) valueMaps.priority[entry.value] = Number(value) })
            ec.service.sync().name('ironstone.WorkItemImportServices.store#ImportDraft').parameters({importId: importId, fields: {columnMapping: columnMapping,
                valueMaps: valueMaps, estimateUnit: estimateUnit === 'seconds' ? 'seconds' : 'hours', status: 'mapped'}}).call()
        ]]></script></actions>
        <default-response url="."><parameter name="importId"/></default-response>
        <error-response url="."/>
    </transition>
    <!-- back to the preset's mapping and the value maps from the words -->
    <transition name="autoMap">
        <actions><script><![CDATA[
            ec.service.sync().name('ironstone.WorkItemImportServices.store#ImportDraft').parameters({importId: importId, fields: {columnMapping: null, valueMaps: null}}).call()
            if (!ec.message.hasError()) ec.message.addMessage(ec.l10n.localize('Mapped from the file kind'), 'success')
        ]]></script></actions>
        <default-response url="."><parameter name="importId"/></default-response>
    </transition>

    <actions><script><![CDATA[
        const out = ec.service.sync().name('ironstone.WorkItemImportServices.get#ImportMappingInfo').parameters({importId: importId}).call() || {}
        if (ec.message.hasError()) { parseError = ec.message.getErrorsString(); ec.message.clearErrors() }
        info = out.info || null
        hasDraft = !!info
        if (!hasDraft) return
        mappingValues = {importId: importId, estimateUnit: info.estimateUnit}
        summaryText = ec.resource.expand('${file}: ${kind}, ${columns} columns, ${mapped} fields mapped, into ${project}. Choose the column of each field; an empty one is left out.', '',
                {file: info.draft.fileName, kind: info.presetLabel, columns: info.columnCount, mapped: info.mappedCount, project: info.projectName})
    ]]></script></actions>
