    it links to the task in Commons. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Work item" default-menu-include="false">
    <parameter name="workEffortId"/>
    <widgets>
        <label text="Placeholder: The work item ${workEffortId || ''}: its place in the tree, fields, sub-items, links, development, time and files." type="p"/>
