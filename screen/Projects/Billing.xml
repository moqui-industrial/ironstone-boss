<!-- Billing (design-projects.md §10): unbilled work, invoices and rates, opening on Unbilled, with the shared invoice detail
    (screen/Shared/InvoiceDetail.xml, in the Projects context) and its printed form (Billing/InvoicePrint.xml, also the PDF and the
    email's attachment), and the shared order detail (screen/Shared/OrderDetail.xml, impl-projects.md P8b). Managers only (the team is refused it), and in it only those who manage money
    (ironstone.projects.BillingServices.check#Money). A client (impl-projects.md P10b: PROJECT_CLIENT) opens Billing, Invoices, InvoiceDetail and
    InvoicePrint only, read only, for its own sent invoices (BillingServices get#ClientInvoices), and lands on Invoices; Unbilled, Rates
    and OrderDetail are refused it (BOSS_PROJECTS_INTERNAL in data/BossSetupData.xml), and the team is refused all of Billing
    (BOSS_PROJECTS_BILLING). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Billing" default-menu-index="8" menu-image="sym_o_receipt_long" menu-image-type="icon">
    <subscreens default-item="Unbilled">
        <conditional-default condition="ec.user.userId &amp;&amp; ec.user.hasPermission('PROJECT_CLIENT')" item="Invoices"/>
        <subscreens-item name="InvoiceDetail" location="component://mr-boss/screen/Shared/InvoiceDetail.xml" menu-include="false"/>
        <subscreens-item name="OrderDetail" location="component://mr-boss/screen/Shared/OrderDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
