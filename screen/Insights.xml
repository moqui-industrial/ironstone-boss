<!-- IronStone Insights: root of the app for owners and management (initial-design.md app table); its sections follow
    design-insights.md when that file is written. Authorized for ADMIN by BOSS_INSIGHTS in data/BossSetupData.xml. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="IronStone Insights" menu-image="sym_o_insights" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="Insights"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
    </always-actions>

    <subscreens default-item="Home" always-use-full-path="true"/>

    <widgets><subscreens-panel id="insights-panel" type="popup"/></widgets>
</screen>
