<#-- The stats panels, each with this and last period against the one before and the average, and a trend chart; a
    click shows the panel with a larger chart. The panels are built in the screen actions; output here is not escaped,
    so an attribute value goes through WebUtilities.encodeHtml. -->
<#if sri.getRenderMode() != "qvt">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.min.js" type="text/javascript"></script>
</#if>
<#list statsPanelRows as panels>
<div class="row">
<#list panels as panel>
    <div class="${statsPanelColStyle}">
<#if sri.getRenderMode() == "qvt">
    <m-container-dialog title="${WebUtilities.encodeHtml(panel.title)}">
        <template v-slot:button>
            <q-card flat bordered class="q-ma-sm"><q-card-section>
                <h5 class="text-center" style="margin-top:0;margin-bottom:8px;">${panel.title}</h5>
<#list panel.rows as row>
                <div class="row q-col-gutter-sm"><div class="col-xs-5 text-right">
                    <div class="small text-muted">${row.label}</div><h6 class="text-primary">${row.value}</h6>
                </div><div class="col-xs-7"><#list row.versus as vs>
                    <div><i class="fa ${vs.down ? 'fa-caret-down text-danger' : 'fa-caret-up text-success'}"></i>
                        <span class="${vs.down ? 'text-danger' : 'text-success'}">${vs.percent}%</span>
                        <span class="small">${vs.label} (${vs.base})</span></div>
                </#list></div></div>
</#list>
                <m-chart height="90px" :config="${WebUtilities.encodeHtml(panel.smallConfig)}"></m-chart>
            </q-card-section></q-card>
        </template>
        <template v-slot:default>
<#list panel.rows as row>
            <div class="row q-col-gutter-sm"><div class="col-xs-5 text-right">
                <div class="small text-muted">${row.label}</div><h6 class="text-primary">${row.value}</h6>
            </div><div class="col-xs-7"><#list row.versus as vs>
                <div><i class="fa ${vs.down ? 'fa-caret-down text-danger' : 'fa-caret-up text-success'}"></i>
                    <span class="${vs.down ? 'text-danger' : 'text-success'}">${vs.percent}%</span>
                    <span class="small">${vs.label} (${vs.base})</span></div>
            </#list></div></div>
</#list>
            <m-chart height="500px" :config="${WebUtilities.encodeHtml(panel.bigConfig)}"></m-chart>
        </template>
    </m-container-dialog>
<#else>
    <div class="panel panel-default"><div class="panel-body" onclick="$('#${panel.id}_Modal').modal('show');">
        <h5 class="text-center" style="margin-top:0;">${panel.title}</h5>
<#list panel.rows as row>
        <div class="row"><div class="col-xs-5 text-right">
            <div class="small text-muted">${row.label}</div><h6 class="text-primary">${row.value}</h6>
        </div><div class="col-xs-7"><#list row.versus as vs>
            <div><i class="fa ${vs.down ? 'fa-caret-down text-danger' : 'fa-caret-up text-success'}"></i>
                <span class="${vs.down ? 'text-danger' : 'text-success'}">${vs.percent}%</span>
                <span class="small">${vs.label} (${vs.base})</span></div>
        </#list></div></div>
</#list>
        <div class="chart-container" style="position:relative; height:90px; width:100%;"><canvas id="${panel.id}_Chart"></canvas></div>
        <script>var ${panel.id}_Chart = new Chart(document.getElementById("${panel.id}_Chart"), ${panel.smallConfig});</script>
    </div></div>
    <div class="modal fade" id="${panel.id}_Modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document"><div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">${panel.title} Detail</h4>
            </div>
            <div class="modal-body">
                <div class="chart-container" style="position:relative; height:500px; width:100%;"><canvas id="${panel.id}_Detail_Chart"></canvas></div>
                <script>var ${panel.id}_Detail_Chart = new Chart(document.getElementById("${panel.id}_Detail_Chart"), ${panel.bigConfig});</script>
            </div>
        </div></div>
    </div>
</#if>
    </div>
</#list>
</div>
</#list>
