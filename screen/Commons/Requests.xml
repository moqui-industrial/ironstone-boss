<!-- Commons Requests (design-drawers-commons.md §8 Requests; impl-drawers-commons.md M6): the requests the user raised, is
    assigned to or watches. The list is the default subscreen Requests/List, so /qapps/Commons/Requests is the list and
    Requests/RequestDetail shows in its place (as Contacts and Tasks: the client loads each screen of the path on its own).
    RequestDetail is the shared request detail (screen/Shared/RequestDetail.xml) in the Commons context (design-projects.md §6
    "Per-app context"). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Requests" default-menu-index="5" menu-image="sym_o_support" menu-image-type="icon">
    <subscreens default-item="List">
        <subscreens-item name="RequestDetail" location="component://ironstone-boss/screen/Shared/RequestDetail.xml" menu-include="false"/>
    </subscreens>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
