<!-- Commons Tasks (design-drawers-commons.md §8 Tasks; impl-drawers-commons.md M6): the user's own slice of tasks. The list is
    the default subscreen Tasks/List, so /qapps/Commons/Tasks is the list and Tasks/TaskDetail shows in its place: the client
    loads each screen of the path on its own, so a screen with subscreens cannot tell which one is shown. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Tasks" default-menu-index="4">
    <subscreens default-item="List"/>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
