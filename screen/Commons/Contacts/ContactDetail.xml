<!-- ContactDetail, the contact record on its own (design-drawers-commons.md §6 ContactDetail, Context passed; style-guide §3.3
    Detail): the link of a contact from the palette's People group, Chatter author links, record cards and the other apps,
    and a phone's full screen. The record is template/ContactRecord.xml's ContactRecordSection, the same one the Contacts split
    shows in its main pane, with Chatter beside the overview from 1440 px. The party is found under the user's filters, so
    another user's personal contact is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contact" default-menu-include="false">

    <parameter name="partyId" required="true"/>
    <parameter name="tab"/>
    <parameter name="showExpired"/>

    <transition-include name="contactUpdate" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactOrganization" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactInfoStore" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactInfoPurpose" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactRelationshipAdd" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactNote" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactAvatarUpload" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactFavorite" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactBooks" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactLink" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactDelete" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactExport" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactAvatar" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactSearch" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactGeoRegions" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition-include name="contactBookGroups" location="component://ironstone-boss/template/ContactRecord.xml"/>
    <transition name="contacts"><default-response url="//Commons/Contacts"/></transition>

    <actions>
        <set field="recordPartyId" from="partyId"/>
        <set field="inSplit" from="false"/>
        <set field="recordBase" value="/qapps/Commons/Contacts/ContactDetail"/>
    </actions>
    <widgets>
        <container style="q-mb-xs">
            <link url="//Commons/Contacts" link-type="anchor" text="Contacts" icon="arrow_back" parameter-map="{partyId:partyId}"/>
        </container>
        <section-include name="ContactRecordSection" location="component://ironstone-boss/template/ContactRecord.xml"/>
    </widgets>
</screen>
