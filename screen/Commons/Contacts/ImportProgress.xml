<!-- How far a contact import that runs as a job is (design-drawers-commons.md §6 ImportResult): ImportProgress.qvue next to
    this file, which the import's Result step loads in a dynamic-container with the importId and the file's row count while the
    draft is running. It listens on the notification socket for the topic contactImportProgress, which
    mantle.party.ContactImportServices.import#Contacts sends the user who runs the import (every 25 rows and at the end), and
    shows "Imported 250 of 2,000" with the counts so far; at the end it shows the Result step again. The messages carry counts
    only, and only to that user; this screen reads nothing itself. No socket: the step says the import goes on, and Refresh
    shows where it is. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Import progress" default-menu-include="false" render-modes="vue,qvue,tui" server-static="vue,qvue">
    <widgets>
        <render-mode><text type="qvue" location="component://mr-boss/screen/Commons/Contacts/ImportProgress.qvue" template="false"/><text type="tui" location="component://mr-boss/screen/Commons/Contacts/ImportProgress.tui.json" template="false"/></render-mode>
    </widgets>
</screen>
