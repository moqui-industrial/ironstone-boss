<!-- RequestDetail (design-drawers-commons.md §8 RequestDetail, Context passed; style-guide §3.3 Detail): one request as Commons
    shows it (service/ironstone/RequestServices.xml get#RequestDetail). The header has the name, the status as a row of stage
    chips (the framework's status-bar) with the requester's next action (Submit a draft; Cancel one's own), Comment, Reassign for
    the assignee, Edit of one's own draft and Attach. The tabs: Overview (name, type, priority, customer, description, dates,
    people), Conversation (Chatter: notes, messages and the comments of add#RequestComment, which are Comment communication
    events joined by RequestCommEvent; the right column of the overview from 1440 px, a tab below), Tasks (the work efforts of
    RequestWorkEffort, add a task), the other records it is on (link#RequestRecord) and Files (record files). No queue, SLA or
    category widgets: those are Customer Service's.
    The request is found under the record visibility rule (R5, R28): one the user may not see is "not available". -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Request" default-menu-include="false">

    <parameter name="requestId" required="true"/>
    <parameter name="tab"/>

    <transition name="requests"><default-response url="../List"/></transition>

    <transition name="changeStatus">
        <actions>
            <service-call name="ironstone.RequestServices.set#RequestStatus" out-map="statusOut" in-map="{requestId:requestId, toStatusId:toStatusId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(statusOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="requestId"/><parameter name="tab"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="updateRequest">
        <actions>
            <service-call name="ironstone.RequestServices.update#MyRequest" out-map="updateOut" in-map="{requestId:requestId, requestName:requestName,
                    requestTypeEnumId:requestTypeEnumId, priority:(priority || null), customerPartyId:(customerPartyId || null), description:description,
                    responseRequiredDate:(responseRequiredDate || null)}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(updateOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="requestId"/><parameter name="tab"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="reassign">
        <actions>
            <service-call name="ironstone.RequestServices.reassign#Request" out-map="reassignOut" in-map="{requestId:requestId, assignToPartyId:assignToPartyId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(reassignOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="requestId"/><parameter name="tab"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="addComment">
        <actions>
            <service-call name="ironstone.RequestServices.comment#Request" out-map="commentOut" in-map="{requestId:requestId, body:(body || '')}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(commentOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="requestId"/><parameter name="tab"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="addTask">
        <actions>
            <service-call name="ironstone.RequestServices.add#RequestTask" out-map="taskOut" in-map="{requestId:requestId, workEffortName:(workEffortName || ''),
                    dueDate:(dueDate || null)}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(taskOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="requestId"/><parameter name="tab" value="tasks"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="linkRecord">
        <actions>
            <service-call name="ironstone.RequestServices.link#RequestRecord" out-map="linkOut" in-map="{requestId:requestId, record:record,
                    recordEntityName:recordEntityName, recordId:recordId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(linkOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="requestId"/><parameter name="tab"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="unlinkRecord">
        <actions>
            <service-call name="ironstone.RequestServices.unlink#RequestRecord" out-map="unlinkOut" in-map="{requestId:requestId,
                    recordEntityName:recordEntityName, recordId:recordId}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(unlinkOut.message, 'success')</script></if>
        </actions>
        <default-response url="."><parameter name="requestId"/><parameter name="tab"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="searchRecords" read-only="true">
        <actions>
            <service-call name="ironstone.InboxServices.search#LinkRecords" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(Array.from(found.optionList || []).map((option) =&gt; ({value: option.value, label: option.label})))</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="assigneeSearch" read-only="true">
        <actions>
            <service-call name="ironstone.TaskServices.search#Assignees" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(found.optionList || [])</script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="customerSearch" read-only="true">
        <actions>
            <entity-find entity-name="mantle.party.PartyDetail" list="partyList" limit="20">
                <econditions combine="or">
                    <econdition field-name="organizationName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="firstName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="pseudoId" operator="like" value="%${term}%" ignore-case="true"/>
                </econditions>
                <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                <econdition field-name="privateOwnerUserId" from="ec.user.userId" or-null="true"/>
                <order-by field-name="^organizationName,^firstName,^lastName"/>
            </entity-find>
            <script><![CDATA[
                ec.web.sendJsonResponse(Array.from(partyList).map((party) => ({value: party.partyId,
                    label: (party.organizationName || [party.firstName, party.lastName].filter((part) => part).join(' ') || party.partyId) +
                        ' (' + (party.pseudoId || party.partyId) + ')'})))
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="tab" from="['overview', 'conversation', 'tasks', 'files'].includes(tab) ? tab : 'overview'"/>
        <service-call name="ironstone.RequestServices.get#RequestDetail" in-map="{requestId:requestId}" out-map="detail"/>
        <set field="recordFound" from="!!detail.visible"/>
        <script><![CDATA[
            if (!recordFound) return
            const L = (text) => ec.l10n.localize(text)
            const enc = (text) => String(text == null ? '' : text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')
            request = detail.request
            canSubmit = !!detail.canSubmit
            canCancel = !!detail.canCancel
            canEdit = !!detail.canEdit
            canReassign = !!detail.canReassign
            canAddTask = !!detail.canAddTask
            canLink = !!detail.canLink
            linkedRecordList = (detail.linkedRecordList || []).map((record) => Object.assign({}, record, {cardHtml: '<m-record-card record-entity="' + enc(record.recordEntityName)
                    + '" record-id="' + enc(record.recordId) + '" card-url="/apps/Commons/Chatter/recordCard" dense></m-record-card>'}))
            // the status-bar: the stages and the requester's Submit and Cancel
            stageStatusIds = detail.stageStatusIds || []
            allowedStatusIds = detail.allowedStatusIds || []
            partyList = detail.partyList || []
            taskList = detail.taskList || []
            captionText = [L('Request') + ' ' + requestId, request.typeLabel, request.filedByName ? L('raised by') + ' ' + request.filedByName : null,
                request.requestDateText].filter((part) => part).join(' · ')
            const fact = (label, value, cls) => '<div class="col-auto"><div class="text-caption m-muted">' + enc(L(label)) + '</div><div class="text-body2' + (cls ? ' ' + cls : '') + '">' + value + '</div></div>'
            const person = (name, userId) => name ? '<span class="row inline items-center no-wrap"><m-avatar name="' + enc(name) + '"'
                    + (userId ? ' user-id="' + enc(userId) + '"' : '') + ' size="22px" class="q-mr-xs"></m-avatar>' + enc(name) + '</span>' : '—'
            factsHtml = '<div class="row q-col-gutter-lg q-mb-sm m-request-facts">'
                + fact('Priority', enc(request.priorityText || '—'), '')
                + fact('Customer', person(request.customerName, request.customerUserId), '')
                + fact('Assigned', person(request.assigneeName, request.assigneeUserId), '')
                + (request.responseRequiredText ? fact('Response wanted by', enc(request.responseRequiredText), '') : '')
                + fact('Updated', enc(request.updatedText || '—'), '')
                + '</div>'
            const tabs = [['overview', 'Overview'], ['conversation', 'Conversation'], ['tasks', 'Tasks' + (taskList.length ? ' (' + taskList.length + ')' : '')], ['files', 'Files']]
            const base = '/qapps/Commons/Requests/RequestDetail?requestId=' + encodeURIComponent(requestId)
            tabsHtml = '<q-tabs dense no-caps inline-label narrow-indicator outside-arrows mobile-arrows align="left" active-color="primary" indicator-color="primary"'
                    + ' class="text-grey-8 m-request-tabs" model-value="' + enc(tab) + '">' + tabs.map(([key, label]) => {
                        // the conversation is beside the overview from 1440 px, a tab below
                        const cls = key === 'conversation' && tab !== 'conversation' ? ' class="lt-lg"' : ''
                        return '<q-tab name="' + key + '" label="' + enc(L(label)) + '"' + cls + ' data-tab="' + key + '" @click="$root.setUrl(\'' + enc(base + '&tab=' + key) + '\')"></q-tab>'
                    }).join('') + '</q-tabs><q-separator class="q-mb-sm"></q-separator>'
            // the terminal's tabs: links to this screen with the tab
            tabsTui = {t: 'row', id: 'RequestTabs', c: tabs.map(([key, label]) => ({t: 'link', id: 'RequestTab_' + key, text: key === tab ? '[' + L(label) + ']' : L(label),
                url: sri.buildUrl('.').path + base.substring(base.indexOf('?')) + '&tab=' + key}))}
            filesUrl = base + '&tab=files'
            requestEdit = {requestId: requestId, requestName: request.requestName, requestTypeEnumId: request.requestTypeEnumId,
                priority: request.priority != null ? String(request.priority) : '5', customerPartyId: request.customerPartyId,
                description: request.description, responseRequiredDate: request.responseRequiredEdit ? request.responseRequiredEdit.substring(0, 10) : ''}
            customerName = request.customerName || ''
        ]]></script>
    </actions>

    <widgets>
        <section name="RequestNotFound" condition="!recordFound"><widgets>
            <container-box type="warning"><box-header title="Not available"/><box-body>
                <label type="p" text="Request ${requestId} is not available: it does not exist, or you are not one of its people or organizations."/>
                <link url="requests" text="Back to Requests" link-type="anchor"/>
            </box-body></container-box>
        </widgets></section>

        <section name="RequestFound" condition="recordFound"><widgets>
            <!-- the record for the shell: quick create's link chip and the activity kind, Today's "Add activity on this record" -->
            <context record-entity="mantle.request.Request" record-id="${requestId}" title="${request.requestName || requestId}"/>
            <container style="q-mb-xs"><link url="requests" link-type="anchor" text="Requests" icon="arrow_back"/></container>

            <!-- ===== header ===== -->
            <container style="row items-start q-col-gutter-sm q-mb-sm m-request-header">
                <container style="col-12 col-md">
                    <label text="${request.requestName || requestId}" type="h5" style="q-my-none"/>
                    <label text="${captionText}" type="div" style="text-caption m-muted q-mb-xs"/>
                    <status-bar id="RequestStatusBar" status-id="${request.statusId}" stages="${stageStatusIds}" allowed-status-ids="${allowedStatusIds}"
                            transition="changeStatus" parameter-name="toStatusId" parameter-map="{requestId:requestId, tab:tab}"
                            title="${request.requestName || requestId}"/>
                </container>
                <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-request-actions">
                    <container-dialog id="RequestCommentDialog" button-text="Comment" icon="sym_o_add_comment" width="560" title="Comment on ${request.requestName || requestId}">
                        <form-single name="RequestComment" transition="addComment" focus-field="body">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="tab"><default-field><hidden/></default-field></field>
                            <field name="body" from="''"><default-field title="Comment"><text-area rows="4" cols="60"/></default-field></field>
                            <field name="submitButton"><default-field title="Comment"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="RequestReassignDialog" button-text="Reassign" icon="sym_o_person_add" width="480" title="Assign ${request.requestName || requestId} to"
                            condition="canReassign">
                        <form-single name="RequestReassign" transition="reassign">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="tab"><default-field><hidden/></default-field></field>
                            <field name="assignToPartyId"><default-field title="Assignee">
                                <drop-down><dynamic-options transition="assigneeSearch" server-search="true" min-length="0"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Reassign"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="RequestEditDialog" button-text="Edit" icon="sym_o_edit" width="640" title="Edit the draft" condition="canEdit">
                        <form-single name="RequestEdit" transition="updateRequest" map="requestEdit" focus-field="requestName">
                            <field name="requestId"><default-field><hidden/></default-field></field>
                            <field name="tab" from="tab"><default-field><hidden/></default-field></field>
                            <field name="requestName"><default-field title="Request"><text-line size="40"/></default-field></field>
                            <field name="requestTypeEnumId"><default-field title="Type">
                                <drop-down><entity-options key="${enumId}" text="${description}">
                                    <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                        <econdition field-name="enumTypeId" value="RequestType"/><order-by field-name="description"/></entity-find>
                                </entity-options></drop-down></default-field></field>
                            <field name="priority"><default-field title="Priority">
                                <drop-down><option key="1" text="1 (highest)"/><option key="2" text="2 (high)"/><option key="3"/><option key="4"/>
                                    <option key="5" text="5 (normal)"/><option key="6"/><option key="7"/><option key="8" text="8 (low)"/><option key="9" text="9 (lowest)"/></drop-down>
                            </default-field></field>
                            <field name="customerPartyId"><default-field title="Customer">
                                <drop-down allow-empty="true" current-description="${customerName}">
                                    <dynamic-options transition="customerSearch" server-search="true" min-length="1"/></drop-down></default-field></field>
                            <field name="responseRequiredDate"><default-field title="Response wanted by"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                            <field name="description"><default-field title="Description"><text-area rows="4" cols="60"/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            <field-layout>
                                <field-ref name="requestName"/>
                                <field-row><field-ref name="requestTypeEnumId"/><field-ref name="priority"/></field-row>
                                <field-row><field-ref name="customerPartyId"/><field-ref name="responseRequiredDate"/></field-row>
                                <field-ref name="description"/><field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container-dialog>
                    <link url="${filesUrl}" url-type="plain" link-type="anchor-button" text="Attach" icon="sym_o_attach_file" style="q-ml-xs"/>
                </container>
            </container>
            <render-mode><text type="qvt"><![CDATA[${factsHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify(Object.assign({t: "html", id: "RequestFacts"}, JSON.parse(sri.htmlText(factsHtml))))}]]></text></render-mode>
            <render-mode><text type="qvt"><![CDATA[${tabsHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify(tabsTui)}]]></text></render-mode>

            <!-- ===== Overview ===== -->
            <section name="OverviewTab" condition="tab == 'overview'"><widgets>
                <container style="row q-col-gutter-sm">
                    <container style="col-12 col-lg-8">
                        <container style="row q-col-gutter-sm">
                            <container style="col-12 col-md-7">
                                <container-box><box-header title="Request"/><box-body>
                                    <label text="${request.description}" type="p" style="text-body2" condition="request.description"/>
                                    <label text="No description" type="p" style="m-muted" condition="!request.description"/>
                                    <form-single name="RequestFacts" map="request">
                                        <field name="typeLabel"><default-field title="Type"><display/></default-field></field>
                                        <field name="statusLabel"><default-field title="Status"><display/></default-field></field>
                                        <field name="priorityText"><default-field title="Priority"><display/></default-field></field>
                                        <field name="customerName"><default-field title="Customer"><display/></default-field></field>
                                        <field name="requestDateText"><default-field title="Raised"><display/></default-field></field>
                                        <field name="responseRequiredText"><conditional-field condition="request.responseRequiredText" title="Response wanted by"><display/></conditional-field>
                                            <default-field><ignored/></default-field></field>
                                        <field name="resolutionLabel"><conditional-field condition="request.resolutionLabel &amp;&amp; request.requestResolutionEnumId != 'RrUnresolved'" title="Resolution">
                                            <display/></conditional-field><default-field><ignored/></default-field></field>
                                        <field-layout>
                                            <field-row><field-ref name="typeLabel"/><field-ref name="statusLabel"/></field-row>
                                            <field-row><field-ref name="priorityText"/><field-ref name="customerName"/></field-row>
                                            <field-row><field-ref name="requestDateText"/><field-ref name="responseRequiredText"/></field-row>
                                            <field-ref name="resolutionLabel"/>
                                        </field-layout>
                                    </form-single>
                                </box-body></container-box>
                            </container>
                            <container style="col-12 col-md-5">
                                <container-box><box-header title="People"/><box-body-nopad>
                                    <form-list name="RequestPeople" list="partyList" skip-form="true" skip-header="true" paginate="false">
                                        <field name="name"><default-field>
                                            <link url="${url || '.'}" url-type="plain" text="${name}${isMe ? ' (' + ec.l10n.localize('you') + ')' : ''}" condition="url"/>
                                            <label text="${name}" type="span" condition="!url"/>
                                        </default-field></field>
                                        <field name="roleText"><default-field><label text="${roleText}" type="span" style="m-muted"/></default-field></field>
                                    </form-list>
                                    <section name="NoPeople" condition="!partyList.length"><widgets>
                                        <label type="p" text="Nobody yet" style="m-muted q-pa-sm q-mb-none"/>
                                    </widgets></section>
                                </box-body-nopad></container-box>
                            </container>
                        </container>
                        <container-box><box-header title="Linked records"/><box-body>
                            <section name="RequestLinked" condition="linkedRecordList.length || canLink"><widgets>
                                <section-iterate name="RequestLinkedItems" list="linkedRecordList" entry="linked"><widgets>
                                    <container style="row items-center no-wrap q-mb-xs">
                                        <container style="col"><render-mode><text type="qvt"><![CDATA[${linked.cardHtml}]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(linked.recordEntityName).split(".").pop() + " " + linked.recordId})}]]></text></render-mode></container>
                                        <link url="unlinkRecord" link-type="hidden-form-link" icon="sym_o_link_off" text="" tooltip="Take the request off this record"
                                                style="m-btn-flat q-ml-xs" condition="linked.canRemove" confirmation="Take the request off this record?"
                                                parameter-map="{requestId:requestId, tab:tab, recordEntityName:linked.recordEntityName, recordId:linked.recordId}"/>
                                    </container>
                                </widgets></section-iterate>
                                <label type="p" text="Not on any record yet" style="m-muted text-caption q-mb-xs" condition="!linkedRecordList.length"/>
                                <section name="RequestLinkAdd" condition="canLink"><widgets>
                                    <form-single name="RequestLinkRecord" transition="linkRecord">
                                        <field name="requestId"><default-field><hidden/></default-field></field>
                                        <field name="tab" from="tab"><default-field><hidden/></default-field></field>
                                        <field name="record"><default-field title="Link to a record (an id or a name)">
                                            <drop-down allow-empty="true"><dynamic-options transition="searchRecords" server-search="true" min-length="2"/></drop-down>
                                        </default-field></field>
                                        <field name="submitButton"><default-field title="Link"><submit/></default-field></field>
                                        <field-layout><field-row-big><field-ref name="record"/><field-ref name="submitButton"/></field-row-big></field-layout>
                                    </form-single>
                                </widgets></section>
                            </widgets><fail-widgets>
                                <label type="p" text="Not on any record yet" style="m-muted q-mb-none"/>
                            </fail-widgets></section>
                        </box-body></container-box>
                    </container>
                    <!-- the conversation beside the overview from 1440 px -->
                    <container style="col-12 col-lg-4 gt-md">
                        <chatter id="RequestChatter" record-entity="mantle.request.Request" record-id="${requestId}" default-tab="log"/>
                    </container>
                </container>
            </widgets></section>

            <!-- ===== Conversation, a tab below 1440 px ===== -->
            <section name="ConversationTab" condition="tab == 'conversation'"><widgets>
                <chatter id="RequestChatterTab" record-entity="mantle.request.Request" record-id="${requestId}" default-tab="log"/>
            </widgets></section>

            <!-- ===== Tasks ===== -->
            <section name="TasksTab" condition="tab == 'tasks'"><widgets>
                <container-box><box-header title="Tasks"/><box-body-nopad>
                    <section name="AddRequestTask" condition="canAddTask"><widgets>
                        <container style="q-px-sm q-pt-sm">
                            <form-single name="NewRequestTask" transition="addTask" focus-field="workEffortName">
                                <field name="requestId"><default-field><hidden/></default-field></field>
                                <field name="workEffortName" from="''"><default-field title="Add a task"><text-line size="36"/></default-field></field>
                                <field name="dueDate" from="''"><default-field title="Due"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                                <field name="addButton"><default-field title="Add"><submit icon="sym_o_add"/></default-field></field>
                                <field-layout><field-row-big><field-ref name="workEffortName"/><field-ref name="dueDate"/><field-ref name="addButton"/></field-row-big></field-layout>
                            </form-single>
                        </container>
                    </widgets></section>
                    <form-list name="RequestTasks" list="taskList" skip-form="true" paginate="false">
                        <field name="workEffortName"><default-field title="Task">
                            <link url="${url}" url-type="plain" text="${workEffortName}" style="${isDone ? 'm-muted' : ''}"/></default-field></field>
                        <field name="purposeLabel"><default-field title="Purpose"><display/></default-field></field>
                        <field name="statusId"><default-field title="Status">
                            <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip>]]></text><text type="tui"><![CDATA[{"t": "text", "style": "strong", "text": ${JSON.stringify(statusLabel ?? "")}}]]></text></render-mode>
                        </default-field></field>
                        <field name="dueText"><default-field title="Due"><label text="${dueText}" type="span" style="text-no-wrap ${overdue ? 'text-warning' : ''}"/></default-field></field>
                        <field name="assigneeText"><default-field title="Assignees"><display/></default-field></field>
                    </form-list>
                    <section name="NoTasks" condition="!taskList.length"><widgets>
                        <label type="p" text="No tasks on this request" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </widgets></section>

            <!-- ===== Files ===== -->
            <section name="FilesTab" condition="tab == 'files'"><widgets>
                <record-files id="RequestFiles" record-entity="mantle.request.Request" record-id="${requestId}"/>
            </widgets></section>
        </widgets></section>
