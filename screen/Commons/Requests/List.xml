<!-- Requests, the list (design-drawers-commons.md §8 Requests; style-guide §3.2 List): the user's own slice of requests
    (service/ironstone/RequestServices.xml find#RequestRows) in the lists All open, Raised by me, Assigned to me, Watching and
    Closed, a chip row with their counts; RequestFind narrows them (text, type, status, priority, date period); each row has
    the id, the name (the link to RequestDetail), the type, the status as a chip, the priority, the customer, the assignee and
    when it was last updated. New request is a dialog (NewRequestContainer, as quick create's request kind, which links to it
    for more options): submitted, or kept as a draft; the new request opens. Queues, SLAs and categories are Customer
    Service's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Requests" default-menu-include="false">

    <parameter name="list"/>
    <parameter name="text"/>
    <parameter name="requestTypeEnumId"/>
    <parameter name="statusId"/>
    <parameter name="priority"/>
    <parameter name="orderByField"/>
    <parameter name="pageIndex"/>
    <parameter name="requestDate_period"/>
    <parameter name="requestDate_poffset"/>
    <parameter name="requestDate_pdate"/>
    <parameter name="requestDate_from"/>
    <parameter name="requestDate_thru"/>

    <transition name="requestDetail"><default-response url="../RequestDetail"/></transition>
    <transition name="createRequest">
        <actions>
            <service-call name="ironstone.RequestServices.raise#Request" out-map="raiseOut" in-map="{requestName:(requestName || ''),
                    requestTypeEnumId:(requestTypeEnumId || null), priority:(priority || null), customerPartyId:(customerPartyId || null),
                    description:(description || null), responseRequiredDate:(responseRequiredDate || null), draft:(draft == 'Y')}"/>
            <if condition="!ec.message.hasError()"><script>ec.message.addMessage(raiseOut.message, 'success')</script></if>
        </actions>
        <conditional-response url="../RequestDetail" condition="raiseOut?.requestId"><parameter name="requestId" from="raiseOut.requestId"/></conditional-response>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <!-- the customer drop-down: parties the user may see, by name or id; another user's personal contact is never found -->
    <transition name="customerSearch" read-only="true">
        <actions>
            <entity-find entity-name="mantle.party.PartyDetail" list="partyList" limit="20">
                <econditions combine="or">
                    <econdition field-name="organizationName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="firstName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="lastName" operator="like" value="%${term}%" ignore-case="true"/>
                    <econdition field-name="pseudoId" operator="like" value="%${term}%" ignore-case="true"/>
                </econditions>
                <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                <econdition field-name="privateOwnerUserId" from="ec.user.userId" or-null="true"/>
                <order-by field-name="^organizationName,^firstName,^lastName"/>
            </entity-find>
            <script><![CDATA[
                ec.web.sendJsonResponse(Array.from(partyList).map((party) => ({value: party.partyId,
                    label: (party.organizationName || [party.firstName, party.lastName].filter((part) => part).join(' ') || party.partyId) +
                        ' (' + (party.pseudoId || party.partyId) + ')'})))
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            const lists = [['all', 'All open', 'sym_o_inbox'], ['raised', 'Raised by me', 'sym_o_outgoing_mail'], ['assigned', 'Assigned to me', 'sym_o_person'],
                ['watching', 'Watching', 'sym_o_visibility'], ['closed', 'Closed', 'sym_o_inventory']]
            if (!lists.some((entry) => entry[0] === list)) list = 'all'
            const param = (name) => { const value = ec.web.parameters[name]; return value == null || value === '' ? null : String(value) }
            let dateFrom = null
            let dateThru = null
            if (param('requestDate_period')) {
                const range = ec.user.getPeriodRange(param('requestDate_period'), param('requestDate_poffset') || '0', param('requestDate_pdate'))
                if (range) { dateFrom = range[0]; dateThru = range[1] }
            } else {
                if (param('requestDate_from')) dateFrom = ec.l10n.parseTimestamp(param('requestDate_from').substring(0, 10) + ' 00:00:00.000', 'yyyy-MM-dd HH:mm:ss.SSS')
                if (param('requestDate_thru')) dateThru = new Date(Number(String(ec.l10n.parseTimestamp(param('requestDate_thru').substring(0, 10) + ' 00:00:00.000', 'yyyy-MM-dd HH:mm:ss.SSS'))) + 86400000)
            }
            const out = ec.service.sync().name('ironstone.RequestServices.find#RequestRows').parameters({list: list, text: text || null,
                requestTypeEnumId: requestTypeEnumId || null, statusId: statusId || null, priority: priority || null, dateFrom: dateFrom, dateThru: dateThru,
                orderByField: orderByField || null, pageIndex: Number(pageIndex || 0) || 0, pageSize: 25}).call() || {}
            requestRows = Array.from(out.rowList || [])
            requestRowsCount = out.rowCount || 0
            requestRowsPageIndex = out.pageIndex || 0
            requestRowsPageSize = out.pageSize || 25
            requestRowsPageMaxIndex = out.pageMaxIndex || 0
            requestRowsPageRangeLow = out.pageRangeLow || 0
            requestRowsPageRangeHigh = out.pageRangeHigh || 0
            const counts = out.counts || {}
            const find = {text: text || null, requestTypeEnumId: requestTypeEnumId || null, statusId: statusId || null, priority: priority || null,
                orderByField: orderByField || null, requestDate_period: param('requestDate_period'), requestDate_poffset: param('requestDate_poffset'),
                requestDate_pdate: param('requestDate_pdate'), requestDate_from: param('requestDate_from'), requestDate_thru: param('requestDate_thru')}
            Object.keys(find).forEach((key) => { if (find[key] == null) delete find[key] })
            filtered = Object.keys(find).some((key) => key !== 'orderByField')
            listChips = lists.map(([key, label, icon]) => ({key: key, label: L(label) + ' · ' + (counts[key] || 0), icon: icon, on: key === list,
                params: Object.assign({}, find, {list: key})}))
            listLabel = L(lists.find((entry) => entry[0] === list)[1])
            const empty = {all: 'No open requests of yours', raised: 'No open requests raised by you', assigned: 'No open requests assigned to you',
                watching: 'You are not watching any open request', closed: 'No closed requests'}
            emptyText = filtered ? L('No requests match') : L(empty[list])
        ]]></script>
    </actions>

    <widgets>
        <context selection-form="Requests"/>

        <!-- title row: the list shown, New request -->
        <container style="row items-center q-mb-sm q-gutter-y-xs">
            <label text="Requests" type="h5" style="q-my-none q-mr-sm"/>
            <container style="col"/>
            <container-dialog id="NewRequestContainer" button-text="New request" icon="sym_o_support" width="640" title="New request">
                <form-single name="NewRequest" transition="createRequest" focus-field="requestName">
                    <field name="requestName"><default-field title="Request"><text-line size="40"/></default-field></field>
                    <field name="requestTypeEnumId"><default-field title="Type">
                        <drop-down no-current-selected-key="RqtSupport"><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                                <econdition field-name="enumTypeId" value="RequestType"/><order-by field-name="description"/></entity-find>
                        </entity-options></drop-down></default-field></field>
                    <field name="priority"><default-field title="Priority"><radio no-current-selected-key="5">
                        <option key="2" text="High"/><option key="5" text="Normal"/><option key="8" text="Low"/></radio></default-field></field>
                    <field name="customerPartyId"><default-field title="Customer">
                        <drop-down allow-empty="true"><dynamic-options transition="customerSearch" server-search="true" min-length="1"/></drop-down></default-field></field>
                    <field name="responseRequiredDate"><default-field title="Response wanted by"><date-time type="date" format="yyyy-MM-dd"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-area rows="4" cols="50"/></default-field></field>
                    <field name="draft"><default-field title=""><check><option key="Y" text="Keep as a draft (submit it later)"/></check></default-field></field>
                    <field name="createButton"><default-field title="Create"><submit/></default-field></field>
                    <field-layout>
                        <field-ref name="requestName"/>
                        <field-row><field-ref name="requestTypeEnumId"/><field-ref name="customerPartyId"/></field-row>
                        <field-row><field-ref name="priority"/><field-ref name="responseRequiredDate"/></field-row>
                        <field-ref name="description"/><field-ref name="draft"/><field-ref name="createButton"/>
                    </field-layout>
                </form-single>
            </container-dialog>
        </container>

        <!-- the lists, each with its count -->
        <container style="row q-gutter-xs q-mb-sm m-request-chips">
            <section-iterate name="ListChip" list="listChips" entry="chip"><widgets>
                <section name="ListChipOn" condition="chip.on"><widgets>
                    <link url="." link-type="anchor-button" btn-type="primary" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                </widgets><fail-widgets>
                    <link url="." link-type="anchor-button" text="${chip.label}" icon="${chip.icon}" parameter-map="chip.params"/>
                </fail-widgets></section>
            </widgets></section-iterate>
        </container>

        <!-- the find: open beside the lists from 600 px; on a phone a "Find" line that opens it (style-guide §3.2 Phone) -->
        <render-mode><text type="qvt"><![CDATA[<q-expansion-item dense switch-toggle-side icon="sym_o_search" label="${WebUtilities.encodeHtml(ec.l10n.localize('Find'))}" header-class="lt-sm" :default-opened="${filtered ? 'true' : '$q.screen.gt.xs'}" class="q-mb-xs m-list-find">]]></text><text type="tui" template="false">[]</text></render-mode>
        <form-single name="RequestFind" transition=".">
            <field name="list"><default-field><hidden/></default-field></field>
            <field name="text"><default-field title="Search"><text-line size="16"/></default-field></field>
            <field name="requestTypeEnumId"><default-field title="Type">
                <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                    <entity-find entity-name="moqui.basic.Enumeration" cache="true">
                        <econdition field-name="enumTypeId" value="RequestType"/><order-by field-name="description"/></entity-find>
                </entity-options></drop-down></default-field></field>
            <field name="statusId"><default-field title="Status">
                <drop-down allow-empty="true"><entity-options key="${statusId}" text="${description}">
                    <entity-find entity-name="moqui.basic.StatusItem" cache="true">
                        <econdition field-name="statusTypeId" value="Request"/><order-by field-name="sequenceNum"/></entity-find>
                </entity-options></drop-down></default-field></field>
            <field name="priority"><default-field title="Priority">
                <drop-down allow-empty="true"><option key="high" text="High (1-3)"/><option key="normal" text="Normal (4-6)"/><option key="low" text="Low (7-9)"/></drop-down>
            </default-field></field>
            <field name="requestDate"><default-field title="Raised"><date-period allow-empty="true"/></default-field></field>
            <field name="findButton"><default-field title="Find"><submit icon="sym_o_search"/></default-field></field>
            <field-layout><field-row-big><field-ref name="text"/><field-ref name="requestTypeEnumId"/><field-ref name="statusId"/><field-ref name="priority"/>
                <field-ref name="requestDate"/><field-ref name="findButton"/></field-row-big></field-layout>
        </form-single>
        <section name="ClearFilters" condition="filtered"><widgets>
            <container style="q-mb-xs"><link url="." link-type="anchor" text="Clear filters" parameter-map="{list:list}"/></container>
        </widgets></section>
        <render-mode><text type="qvt"><![CDATA[</q-expansion-item>]]></text><text type="tui" template="false">[]</text></render-mode>

        <container-box><box-header title="${listLabel} · ${requestRowsCount}"/><box-body-nopad>
            <form-list name="Requests" list="requestRows" skip-form="true" paginate="true" show-page-size="false">
                <field name="requestId"><header-field title="Id" show-order-by="true"/><default-field>
                    <link url="requestDetail" text="${requestId}" parameter-map="{requestId:requestId}"/></default-field></field>
                <field name="requestName"><header-field title="Request" show-order-by="true"/><default-field>
                    <link url="requestDetail" text="${requestName}" parameter-map="{requestId:requestId}" style="${isClosed ? 'm-muted' : ''}"/></default-field></field>
                <field name="typeLabel"><default-field title="Type"><display/></default-field></field>
                <field name="statusId"><header-field title="Status" show-order-by="true"/><default-field>
                    <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${statusColor}" data-status="${statusId}">${WebUtilities.encodeHtml(statusLabel ?? '')}</q-chip>]]></text><text type="tui"><![CDATA[{"t": "text", "style": "strong", "text": ${JSON.stringify(statusLabel ?? "")}}]]></text></render-mode>
                </default-field></field>
                <field name="priority"><header-field title="Priority" show-order-by="true"/><default-field><label text="${priorityText}" type="span"/></default-field></field>
                <field name="customerName"><default-field title="Customer"><display/></default-field></field>
                <field name="assigneeName"><default-field title="Assigned"><label text="${assigneeName}${isMine ? ' (' + ec.l10n.localize('you') + ')' : ''}" type="span"/></default-field></field>
                <field name="lastUpdatedStamp"><header-field title="Updated" show-order-by="true"/><default-field>
                    <label text="${updatedText}" type="span" style="text-no-wrap"/></default-field></field>
            </form-list>
            <section name="NoRequests" condition="!requestRows.length"><widgets>
                <container style="q-pa-sm">
                    <label type="p" text="${emptyText}" style="m-muted q-mb-xs"/>
                    <section name="NoRequestsClear" condition="filtered"><widgets>
                        <link url="." link-type="anchor" text="Clear filters" parameter-map="{list:list}"/>
                    </widgets></section>
                </container>
            </widgets></section>
        </box-body-nopad></container-box>
    </widgets>
</screen>
