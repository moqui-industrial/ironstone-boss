<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Search" default-menu-include="false">
    <!-- One search box over the authorized Mantle documents: mantle.search.UniversalSearchServices.search#Universal -->

    <parameter name="q"/><parameter name="entityType"/><parameter name="mode"/><parameter name="pageIndex"/>

    <!-- autocomplete for the search box: titles that start with the text, or whose words start with its words -->
    <transition name="suggest" read-only="true">
        <parameter name="term"/>
        <actions>
            <if condition="!term || term.length &lt; 2"><script>ec.web.sendJsonResponse([])</script><return/></if>
            <service-call name="mantle.search.UniversalSearchServices.search#Universal" out-map="suggestOut"
                    in-map="{q:term, mode:'autocomplete', limit:10, highlight:false, indexName:searchIndexName, linkSet:searchLinkSets}"/>
            <script>ec.web.sendJsonResponse((suggestOut.results || []).map((result) => ({value: result.title, label: result.entityTypeName + ': ' + result.title})))</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <set field="pageSize" from="20"/>
        <set field="pageIndexNum" from="parseInt(pageIndex || '0', 10) || 0"/>
        <set field="capabilities" from="ec.search.isAvailable() ? ec.search.capabilities() : []"/>
        <if condition="q || entityType">
            <service-call name="mantle.search.UniversalSearchServices.search#Universal" out-map="searchOut"
                    in-map="{q:q, entityType:entityType, mode:(mode || 'lexical'), offset:pageIndexNum * pageSize, limit:pageSize,
                        facets:['entityType', 'category'], indexName:searchIndexName, linkSet:searchLinkSets}"/>
        </if>
        <script><![CDATA[
            results = searchOut ? searchOut.results : []
            total = searchOut ? searchOut.total : 0
            typeFacets = searchOut && searchOut.facetCounts ? (searchOut.facetCounts.entityType || []) : []
            categoryFacets = searchOut && searchOut.facetCounts ? (searchOut.facetCounts.category || []) : []
            hasPrevious = pageIndexNum > 0
            hasNext = (pageIndexNum + 1) * pageSize < total
            modeOptions = [{key: 'lexical', text: 'Words'}].concat(capabilities.includes('hybrid') ? [{key: 'hybrid', text: 'Words and meaning'}] : [])
                    .concat(capabilities.includes('semantic') ? [{key: 'semantic', text: 'Meaning'}] : [])

            // each type's details: the attributes its results show, in order
            const details = {MantleParty: ['partyTypeEnumId'], MantleProduct: ['productTypeEnumId', 'amountFixed'],
                MantleFacility: ['status'], MantleOrder: ['status', 'placedDate', 'grandTotal', 'currencyUomId'],
                MantleInvoice: ['status', 'invoiceDate', 'invoiceTotal', 'unpaidTotal', 'currencyUomId'],
                MantleShipment: ['status', 'entryDate', 'estimatedShipDate'], MantleAsset: ['status', 'productId', 'quantityOnHandTotal'],
                MantleCommunicationEvent: ['entryDate', 'fromPartyId', 'toPartyId'], MantleWikiPage: ['wikiSpaceId']}
            const dateFields = ['placedDate', 'invoiceDate', 'entryDate', 'estimatedShipDate']
            for (const result of results) {
                result.detailText = (details[result.entityType] || []).filter((name) => result.attributes[name] != null)
                        .map((name) => dateFields.includes(name) ? ec.l10n.format(result.attributes[name], 'dd MMM yyyy') : String(result.attributes[name]))
                        .join(' · ')
                // the snippet text is not HTML escaped; only its <em> marks are kept as HTML
                result.snippetHtml = result.snippet ? sri.encodeHtml(result.snippet)
                        .replace(/&lt;em&gt;/g, '<em>').replace(/&lt;\/em&gt;/g, '</em>') : ''
            }
        ]]></script>
    </actions>
    <widgets>
        <form-single name="UniversalSearch" transition="." focus-field="q">
            <field name="q"><default-field title="" tooltip="Words match the start of words; use quotes for a phrase and field:value to search one field">
                <text-line size="60" ac-transition="suggest" ac-min-length="2"/></default-field></field>
            <field name="entityType"><default-field title=""><drop-down allow-empty="true" no-current-selected-key="">
                <option key="" text="Any Type"/>
                <entity-options key="${dataDocumentId}" text="${documentName}">
                    <entity-find entity-name="moqui.entity.document.DataDocument" cache="true">
                        <econdition field-name="indexName" from="searchIndexName"/><order-by field-name="documentName"/>
                    </entity-find>
                </entity-options>
            </drop-down></default-field></field>
            <field name="mode"><conditional-field condition="modeOptions.length &gt; 1" title="">
                <drop-down><list-options list="modeOptions" key="${key}" text="${text}"/></drop-down></conditional-field>
                <default-field><hidden/></default-field></field>
            <field name="submitButton"><default-field title="Search"><submit/></default-field></field>
            <field-layout><field-row-big><field-ref name="q"/><field-ref name="entityType"/><field-ref name="mode"/>
                <field-ref name="submitButton"/></field-row-big></field-layout>
        </form-single>

        <!-- show messages, such as a mode the search backend does not have -->
        <section-iterate name="messageInfos" list="ec.message.messageInfos" entry="messageInfo"><widgets>
            <container><label text="${messageInfo.message}" type="strong" style="text-${messageInfo.typeString}"/></container>
        </widgets></section-iterate>

        <section name="ResultsSection" condition="q || entityType"><widgets>
            <container style="q-my-sm">
                <label text="${total} results" type="strong"/>
                <section-iterate name="TypeFacets" list="typeFacets" entry="facet"><widgets>
                    <link url="." text="${facet.label} (${facet.count})" link-type="anchor" btn-type="${facet.value == entityType ? 'primary' : 'default'}"
                            parameter-map="{q:q, entityType:(facet.value == entityType ? '' : facet.value), mode:mode}"/>
                </widgets></section-iterate>
            </container>
            <container style="q-my-sm" condition="categoryFacets.length &gt; 0">
                <section-iterate name="CategoryFacets" list="categoryFacets" entry="facet"><widgets>
                    <label text="${facet.label} (${facet.count})" type="span" style="q-mr-md text-grey-8"/>
                </widgets></section-iterate>
            </container>

            <section-iterate name="SearchResults" list="results" entry="result"><widgets>
                <container style="q-my-md">
                    <container>
                        <link url="${result.url}" url-type="plain" text="${result.title}" link-type="anchor" condition="result.url"/>
                        <label text="${result.title}" type="strong" condition="!result.url"/>
                        <label text=" ${result.entityTypeName}${result.code ? ' ' + result.code : ''}${result.category ? ' · ' + result.category : ''}" type="span" style="text-grey-7"/>
                    </container>
                    <label text="${result.subtitle}" type="div" condition="result.subtitle"/>
                    <label text="${result.detailText}" type="div" style="text-grey-8" condition="result.detailText"/>
                    <label text="${result.snippetHtml}" type="div" encode="false" condition="result.snippetHtml"/>
                </container>
            </widgets></section-iterate>

            <container>
                <link url="." text="Previous" condition="hasPrevious" parameter-map="{q:q, entityType:entityType, mode:mode, pageIndex:pageIndexNum - 1}"/>
                <link url="." text="Next" condition="hasNext" parameter-map="{q:q, entityType:entityType, mode:mode, pageIndex:pageIndexNum + 1}"/>
            </container>
        </widgets></section>
        <label text="Search syntax: words match the start of words, &quot;a phrase&quot; matches the words in order, field:value searches one field, AND, OR, NOT, and parentheses" type="p" style="text-muted"/>
    </widgets>
</screen>
