<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="IronStone BOSS" menu-image="fa fa-building" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="boss"/>

        <set field="searchIndexName" value="mantle"/>
        <set field="searchLinkSets" value="boss"/>
        <set field="searchProductDocType" value="MantleProduct"/>
        <set field="searchPartyDocType" value="MantleParty"/>

        <service-call name="mantle.party.PartyServices.setup#UserOrganizationInfo" out-map="context"/>
    </always-actions>

    <!-- the search and sales summary screens; the others are not ported to JavaScript yet -->
    <subscreens default-item="QuickSearch" always-use-full-path="true">
        <subscreens-item name="QuickSearch" location="component://ironstone-boss/screen/Base/QuickSearch.xml" menu-index="1"/>
        <subscreens-item name="Search" location="component://ironstone-boss/screen/Base/Search.xml" menu-index="2"/>
        <subscreens-item name="QuickLookup" location="component://ironstone-boss/screen/Base/QuickLookup.xml" menu-include="false"/>

        <subscreens-item name="SalesSummary" location="component://ironstone-boss/screen/Reports/SalesSummary.xml" menu-index="10"/>
    </subscreens>

    <widgets><subscreens-panel id="boss-panel" type="popup"/></widgets>
</screen>
