<!-- Comms Home (design-drawers-commons.md §12 Home; style-guide §3.1 Landing): the counters (the unread of each mail account and
    of the internal messages, flagged, snoozed until today, mentions, and mail that could not be sent), each a number card into
    the Inbox view it counts; Needs reply (the conversations waiting a day or more for the user's answer), the follow-up calls
    and emails due, the meetings of the next days with Join; the shortcuts (Compose, New room, Add a mail account until there
    is one); the mailboxes and chat rooms with unread. A mail account whose sign-in or sync failed is named at the top with
    the way to fix it. ironstone.comms.CommsHomeServices.get#CommsHome reads each part on its own: one that fails is left out and
    said so. Missed calls come with Calls. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">

    <actions>
        <service-call name="ironstone.comms.CommsHomeServices.get#CommsHome" out-map="home"/>
        <script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            cardList = Array.from(home?.cardList || [])
            needsReplyList = Array.from(home?.needsReplyList || [])
            followUpList = Array.from(home?.followUpList || [])
            meetingList = Array.from(home?.meetingList || [])
            mailboxList = Array.from(home?.mailboxList || [])
            roomList = Array.from(home?.roomList || [])
            hasMailAccount = home?.hasMailAccount === true
            problemAccountList = Array.from(home?.problemAccountList || [])
            failedParts = Array.from(home?.failedParts || [])
            todayLabel = ec.l10n.format(new Date(Number(ec.user.nowTimestamp)), 'EEEE, MMMM d')
            roomList.forEach((room) => { room.countText = room.mentionCount ? ec.resource.expand(room.mentionCount === 1 ? '${n} unread, 1 mention' : '${n} unread, ${m} mentions', '',
                    {n: room.unreadCount, m: room.mentionCount})
                : ec.resource.expand('${n} unread', '', {n: room.unreadCount}) })
            mailboxList.forEach((box) => { box.countText = ec.resource.expand('${n} unread', '', {n: box.unreadCount}) })
        ]]></script>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <label type="h5" text="Comms" style="q-my-none"/>
            <label type="div" text="${todayLabel}" style="text-caption m-muted"/>
        </container>

        <section-iterate name="ProblemAccounts" list="problemAccountList" entry="problem"><widgets>
            <render-mode><text type="qvt"><![CDATA[<q-banner dense rounded class="m-tonal text-negative q-mb-sm"><template v-slot:avatar><q-icon name="sym_o_sync_problem"></q-icon></template>]]></text><text type="tui" template="false">[]</text></render-mode>
            <label type="span" text="${problem.accountName}: ${problem.problemText}; its mail is not syncing.${problem.canManage ? '' : ' Its owner can fix it.'}"/>
            <section name="ProblemFix" condition="problem.canManage"><widgets>
                <render-mode><text type="qvt"><![CDATA[<template v-slot:action>]]></text><text type="tui" template="false">[]</text></render-mode>
                <link url="${problem.link}" url-type="plain" text="Fix" icon="sym_o_key" btn-type="primary"/>
                <render-mode><text type="qvt"><![CDATA[</template>]]></text><text type="tui" template="false">[]</text></render-mode>
            </widgets></section>
            <render-mode><text type="qvt"><![CDATA[</q-banner>]]></text><text type="tui" template="false">[]</text></render-mode>
        </widgets></section-iterate>

        <!-- no mail account yet: the way in -->
        <section name="AddAccount" condition="!hasMailAccount"><widgets>
            <container-box type="info"><box-header title="Read your email here"/><box-body>
                <label type="p" text="Add your email account (Gmail, Outlook.com, Yahoo, iCloud, your own domain) and your mail is here next to your internal messages, chat and calendar."/>
                <link url="/qapps/Comms/Settings/MailAccounts/Add?fresh=Y" url-type="plain" text="Add your email account" icon="sym_o_mail" btn-type="primary"/>
            </box-body></container-box>
        </widgets></section>

        <!-- the counters, each into the Inbox view it counts -->
        <dashboard min-width="170" style="q-mb-md">
            <section-iterate name="Counters" list="cardList" entry="card"><widgets>
                <number-card title="${card.title}" value="${card.value}" icon="${card.icon}" link="${card.link}"/>
            </widgets></section-iterate>
        </dashboard>

        <section name="Failed" condition="failedParts.length"><widgets>
            <label type="p" text="Some parts could not be read just now and are left out." style="text-caption text-warning"/>
        </widgets></section>

        <container-row>
            <row-col md="8">
                <container-box><box-header title="Needs reply"/><box-toolbar>
                    <link url="/qapps/Comms/Inbox" url-type="plain" link-type="anchor" text="Inbox"/>
                </box-toolbar><box-body-nopad>
                    <form-list name="NeedsReply" list="needsReplyList" skip-form="true" skip-header="true" paginate="false">
                        <field name="subject"><default-field><link url="${link}" url-type="plain" text="${subject}"/></default-field></field>
                        <field name="who"><default-field><display style="text-caption"/></default-field></field>
                        <field name="whenText" align="right"><default-field><display style="text-caption m-muted text-no-wrap"/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="subject"/><field-ref name="who"/></column>
                            <column><field-ref name="whenText"/></column>
                        </columns>
                    </form-list>
                    <section name="NoNeedsReply" condition="!needsReplyList.length"><widgets>
                        <label type="p" text="Nothing waiting for your answer" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>

                <container-box><box-header title="Follow-ups due"/><box-toolbar>
                    <link url="/qapps/Commons/Tasks" url-type="plain" link-type="anchor" text="Tasks"/>
                </box-toolbar><box-body-nopad>
                    <form-list name="FollowUps" list="followUpList" skip-form="true" skip-header="true" paginate="false">
                        <field name="title"><default-field><link url="${link}" url-type="plain" text="${title}"/></default-field></field>
                        <field name="kindLabel"><default-field><display style="text-caption"/></default-field></field>
                        <field name="dueText" align="right"><conditional-field condition="overdue"><label text="${dueText}" style="text-warning text-no-wrap"/></conditional-field>
                            <default-field><label text="${dueText}" style="text-no-wrap"/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="title"/><field-ref name="kindLabel"/></column>
                            <column><field-ref name="dueText"/></column>
                        </columns>
                    </form-list>
                    <section name="NoFollowUps" condition="!followUpList.length"><widgets>
                        <label type="p" text="No calls or emails to follow up this week" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>

                <container-box><box-header title="Upcoming meetings"/><box-toolbar>
                    <link url="/qapps/Commons/Calendar" url-type="plain" link-type="anchor" text="Calendar"/>
                </box-toolbar><box-body-nopad>
                    <form-list name="Meetings" list="meetingList" skip-form="true" skip-header="true" paginate="false">
                        <field name="title"><default-field><link url="${link}" url-type="plain" text="${title}"/></default-field></field>
                        <field name="whenText"><default-field><display style="${isNow ? 'text-caption text-positive text-weight-medium' : 'text-caption'}"/></default-field></field>
                        <field name="join" align="right"><conditional-field condition="joinUrl">
                            <link url="${joinUrl}" url-type="plain" text="Join" icon="sym_o_videocam" link-type="anchor-button" target-window="_blank"/></conditional-field>
                            <default-field><display text=""/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="title"/><field-ref name="whenText"/></column>
                            <column><field-ref name="join"/></column>
                        </columns>
                    </form-list>
                    <section name="NoMeetings" condition="!meetingList.length"><widgets>
                        <label type="p" text="No meetings today or in the next two days" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
            <row-col md="4">
                <container-box><box-header title="Shortcuts"/><box-body>
                    <render-mode><text type="qvt"><![CDATA[<div class="row q-gutter-sm">
                        <q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_edit_square" @click="$root.openQuickCreate && $root.openQuickCreate(($root.quickCreateItems || []).find((kind) => kind.kind === 'email'))">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="Compose" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn><q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_add_comment" @click="$root.setUrl('/qapps/Comms/Chat')">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="New room" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn><q-btn v-if="${hasMailAccount ? 'false' : 'true'}" unelevated dense no-caps class="m-btn-tonal" icon="sym_o_add" @click="$root.setUrl('/qapps/Comms/Settings/MailAccounts/Add?fresh=Y')">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="Add a mail account" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn><q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_settings" @click="$root.setUrl('/qapps/Comms/Settings')">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="Settings" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn></div>]]></text><text type="tui" template="false">[]</text></render-mode>
                </box-body></container-box>

                <container-box><box-header title="Mailboxes with unread"/><box-body-nopad>
                    <form-list name="MailboxesUnread" list="mailboxList" skip-form="true" skip-header="true" paginate="false">
                        <field name="name"><default-field><link url="${link}" url-type="plain" text="${name}"/></default-field></field>
                        <field name="countText" align="right"><default-field><display style="text-caption text-weight-medium text-no-wrap"/></default-field></field>
                    </form-list>
                    <section name="NoMailboxes" condition="!mailboxList.length"><widgets>
                        <label type="p" text="Nothing new in your mailboxes" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>

                <container-box><box-header title="Rooms with unread"/><box-toolbar>
                    <link url="/qapps/Comms/Chat" url-type="plain" link-type="anchor" text="Chat"/>
                </box-toolbar><box-body-nopad>
                    <form-list name="RoomsUnread" list="roomList" skip-form="true" skip-header="true" paginate="false">
                        <field name="name"><default-field><link url="${link}" url-type="plain" text="${name}"/></default-field></field>
                        <field name="countText" align="right"><default-field><display style="${mentionCount ? 'text-caption text-primary text-weight-medium text-no-wrap' : 'text-caption text-no-wrap'}"/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="name"/></column>
                            <column><field-ref name="countText"/></column>
                        </columns>
                    </form-list>
                    <section name="NoRooms" condition="!roomList.length"><widgets>
                        <label type="p" text="Nothing new in your rooms" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
