<!-- The Comms settings index (design-drawers-commons.md §17 Settings; style-guide §3.9 Settings): a card per settings group with
    a line about it and the links into its pages: Mail accounts (how many, and how many need attention), Identities and
    signatures, Rules, Out of office (on or off), Text blocks, Chat, Calls (later), and a last card for the reading defaults
    and the keys in Commons Preferences. The counts are failure tolerant: a part that fails leaves its line out. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="All settings" default-menu-include="false">
    <actions><script><![CDATA[
        const L = (text) => ec.l10n.localize(text)
        accountsText = null
        accountsProblem = false
        oooText = null
        ec.message.pushErrors()
        try {
            const list = ec.service.sync().name('ironstone.MailSettingsServices.get#MailAccountList').call()
            if (ec.message.hasError()) throw new Error(ec.message.getErrorsString())
            const count = list?.mailAccountCount || 0, problems = list?.problemCount || 0
            accountsText = count === 0 ? L('No mail account yet') : (count === 1 ? L('1 account') : ec.resource.expand('${n} accounts', '', {n: count}))
                + (problems ? ' · ' + (problems === 1 ? L('1 needs your attention') : ec.resource.expand('${n} need your attention', '', {n: problems})) : '')
            accountsProblem = problems > 0
            const ooo = ec.service.sync().name('ironstone.MailSettingsServices.get#OutOfOfficeSettings').call()
            if (ec.message.hasError()) throw new Error(ec.message.getErrorsString())
            const on = Array.from(ooo?.accountList || []).filter((account) => account.isOn).length
            oooText = on ? L('On now') : L('Off')
        } catch (err) {
            ec.logger.warn(`Comms settings index of ${ec.user.username}: the counts are left out: ${err && err.message ? err.message : err}`)
        } finally { ec.message.clearErrors(); ec.message.popErrors() }
    ]]></script></actions>
    <widgets>
        <label type="h5" text="Settings" style="q-mt-none q-mb-sm"/>
        <container-row>
            <row-col md="4" sm="6"><container-box type="${accountsProblem ? 'warning' : 'default'}"><box-header title="Mail accounts"/><box-body>
                <label type="p" text="Your email accounts: add Gmail, Outlook.com, your own domain or a shared team address; sign-in, servers, sync and members." style="m-muted"/>
                <label type="p" text="${accountsText}" style="${accountsProblem ? 'text-negative text-weight-medium' : 'text-body2'}" condition="accountsText"/>
                <container style="row q-gutter-sm">
                    <link url="../MailAccounts" text="Mail accounts" icon="sym_o_mail"/>
                    <link url="../MailAccounts/Add" text="Add an account" icon="sym_o_add" parameter-map="{fresh:'Y'}"/>
                </container>
            </box-body></container-box></row-col>
            <row-col md="4" sm="6"><container-box><box-header title="Identities and signatures"/><box-body>
                <label type="p" text="The name and address people see on your mail, where their replies go, and your signatures." style="m-muted"/>
                <link url="../Identities" text="Identities" icon="sym_o_badge"/>
            </box-body></container-box></row-col>
            <row-col md="4" sm="6"><container-box><box-header title="Rules"/><box-body>
                <label type="p" text="Sort mail as it arrives: into folders, with labels, flagged, forwarded or out of the Inbox; and the senders you blocked." style="m-muted"/>
                <link url="../Rules" text="Rules" icon="sym_o_filter_alt"/>
            </box-body></container-box></row-col>
            <row-col md="4" sm="6"><container-box><box-header title="Out of office"/><box-body>
                <label type="p" text="An automatic reply while you are away, with a different one for people inside the organization." style="m-muted"/>
                <label type="p" text="${oooText}" style="text-body2" condition="oooText"/>
                <link url="../OutOfOffice" text="Out of office" icon="sym_o_beach_access"/>
            </box-body></container-box></row-col>
            <row-col md="4" sm="6"><container-box><box-header title="Text blocks"/><box-body>
                <label type="p" text="Text you write often, one click or a / and a shortcut away in a message; yours or shared with a group." style="m-muted"/>
                <link url="../TextBlocks" text="Text blocks" icon="sym_o_short_text"/>
            </box-body></container-box></row-col>
            <row-col md="4" sm="6"><container-box><box-header title="Chat"/><box-body>
                <label type="p" text="Notifications, sounds, Enter to send, message previews and when you show as away." style="m-muted"/>
                <link url="../Chat" text="Chat settings" icon="sym_o_chat"/>
            </box-body></container-box></row-col>
            <row-col md="4" sm="6"><container-box><box-header title="Calls"/><box-body>
                <label type="p" text="Camera, microphone and ringtone: coming with calls." style="m-muted"/>
                <link url="../Calls" text="Calls" icon="sym_o_call"/>
            </box-body></container-box></row-col>
            <row-col md="4" sm="6"><container-box><box-header title="Reading and keys"/><box-body>
                <label type="p" text="Where the reading pane goes, marking mail read, undo send, pictures in mail, and the keyboard shortcuts are in Commons Preferences." style="m-muted"/>
                <container style="row q-gutter-sm">
                    <render-mode><text type="qvt"><![CDATA[<m-link href="/qapps/Commons/Settings/Preferences"><q-btn dense unelevated no-caps class="m-btn-tonal" icon="sym_o_tune">]]></text></render-mode>
                    <label type="span" text="Preferences" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn></m-link><m-link href="/qapps/Commons/Settings/Notifications"><q-btn dense unelevated no-caps class="m-btn-tonal" icon="sym_o_notifications">]]></text></render-mode>
                    <label type="span" text="Notifications" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn></m-link>]]></text></render-mode>
                </container>
            </box-body></container-box></row-col>
        </container-row>
    </widgets>
</screen>
