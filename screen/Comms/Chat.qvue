                        :aria-label="room.t('React with') + ' ' + key" @click="room.react(item, key)"></q-btn>
                <q-btn flat round dense size="sm" icon="sym_o_add_reaction" :aria-label="room.t('React')"><q-tooltip>{{room.t('React')}}</q-tooltip>
                    <q-menu anchor="bottom right" self="top right"><div class="q-pa-xs row" style="width:236px">
                        <q-btn v-for="key in room.emoji" :key="key" flat dense size="sm" class="q-px-xs" :label="key" v-close-popup @click="room.react(item, key)"></q-btn>
                    </div></q-menu>
                </q-btn>
                <q-btn v-if="!inThread" flat round dense size="sm" icon="sym_o_reply" :aria-label="room.t('Reply')" @click="room.startReply(item)"><q-tooltip>{{room.t('Reply')}}</q-tooltip></q-btn>
                <q-btn v-if="!inThread" flat round dense size="sm" icon="sym_o_forum" :aria-label="room.t('Reply in thread')" @click="room.openThread(item.eventSeq)">
                    <q-tooltip>{{room.t('Reply in thread')}}</q-tooltip></q-btn>
            </template>
            <q-btn flat round dense size="sm" icon="sym_o_more_vert" :aria-label="room.t('More')"><q-tooltip>{{room.t('More')}}</q-tooltip>
                <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:230px">
                    <q-item v-if="room.canEdit(item)" clickable v-close-popup @click="room.startEdit(item)">
                        <q-item-section avatar><q-icon name="sym_o_edit"></q-icon></q-item-section><q-item-section>{{room.t('Edit')}}</q-item-section></q-item>
                    <q-item v-if="room.canPost" clickable v-close-popup @click="room.pin(item, !item.pinned)">
                        <q-item-section avatar><q-icon name="sym_o_keep"></q-icon></q-item-section>
                        <q-item-section>{{item.pinned ? room.t('Unpin') : room.t('Pin to the room')}}</q-item-section></q-item>
                    <q-item clickable v-close-popup @click="room.copyLink(item)">
                        <q-item-section avatar><q-icon name="sym_o_link"></q-icon></q-item-section><q-item-section>{{room.t('Copy link')}}</q-item-section></q-item>
                    <q-item clickable v-close-popup @click="room.copyText(item)">
                        <q-item-section avatar><q-icon name="sym_o_content_copy"></q-icon></q-item-section><q-item-section>{{room.t('Copy text')}}</q-item-section></q-item>
                    <q-item v-if="room.isMember && !inThread" clickable v-close-popup @click="room.markUnreadFrom(item)">
                        <q-item-section avatar><q-icon name="sym_o_mark_chat_unread"></q-icon></q-item-section><q-item-section>{{room.t('Mark unread from here')}}</q-item-section></q-item>
                    <q-separator></q-separator>
                    <q-item clickable v-close-popup @click="room.createFrom(item, 'task')">
                        <q-item-section avatar><q-icon name="sym_o_task_alt"></q-icon></q-item-section><q-item-section>{{room.t('Create a task')}}</q-item-section></q-item>
                    <q-item clickable v-close-popup @click="room.createFrom(item, 'request')">
                        <q-item-section avatar><q-icon name="sym_o_support"></q-icon></q-item-section><q-item-section>{{room.t('Create a request')}}</q-item-section></q-item>
                    <q-item clickable v-close-popup @click="room.createFrom(item, 'event')">
                        <q-item-section avatar><q-icon name="sym_o_event"></q-icon></q-item-section><q-item-section>{{room.t('Create an event')}}</q-item-section></q-item>
                    <q-item clickable v-close-popup @click="room.openFileOn(item)">
                        <q-item-section avatar><q-icon name="sym_o_link"></q-icon></q-item-section><q-item-section>{{room.t('File on a record…')}}</q-item-section></q-item>
                    <template v-if="room.canRedact(item)">
                        <q-separator></q-separator>
                        <q-item clickable v-close-popup @click="room.redact(item)">
                            <q-item-section avatar><q-icon name="sym_o_delete" color="negative"></q-icon></q-item-section>
                            <q-item-section class="text-negative">{{room.t('Delete message')}}</q-item-section></q-item>
                    </template>
                </q-list></q-menu>
            </q-btn>
        </q-card>
    </div>
</div>`;

// ---- a message being edited in place: Enter saves (as the composer sends), Esc cancels ----
const editTemplate = `
<div class="q-my-xs" @keydown.esc.stop="room.cancelEdit()">
    <m-rich-text ref="editor" v-model="body" :name="'chatEdit' + item.eventSeq" light rows="1" autofocus :enter="room.prefs.enterSends === false ? 'newline' : 'submit'"
            :mention-url="room.url('mentionUsers')" :mention-parameters="{chatRoomId: room.roomId}" @submit="save"></m-rich-text>
    <div class="row items-center q-gutter-x-sm q-mt-xs">
        <q-btn dense unelevated no-caps color="primary" size="sm" :label="room.t('Save')" :loading="busy" @click="save"></q-btn>
        <q-btn dense flat no-caps size="sm" :label="room.t('Cancel')" @click="room.cancelEdit()"></q-btn>
        <span class="text-caption m-muted">{{room.t('Esc to cancel')}}</span>
    </div>
</div>`;

// ---- the composer of the room or of a thread ----
const composerTemplate = `
<div class="m-chat-composer" @keydown.capture="onKeydown" @paste="onPaste">
    <div v-if="!threadRoot && room.replyTo" class="row items-center no-wrap q-pl-sm q-mb-xs text-caption rounded-borders">
        <div class="self-stretch bg-primary" style="width:3px;border-radius:2px"></div>
        <q-icon name="sym_o_reply" size="16px" class="q-mx-xs text-primary"></q-icon>
        <span class="ellipsis col">{{room.t('Replying to')}} <span class="text-weight-medium">{{room.replyTo.senderName}}</span>: {{room.replyTo.snippet}}</span>
        <q-btn flat round dense size="sm" icon="sym_o_close" :aria-label="room.t('Cancel the reply')" @click="room.cancelReply()"></q-btn>
    </div>
    <div v-if="files.length" class="row q-mb-xs">
        <q-chip v-for="file in files" :key="file.key" dense square removable class="m-tonal q-ml-none q-mr-xs" :icon="file.uploading ? undefined : room.fileIcon(file)"
                @remove="removeFile(file)"><q-spinner v-if="file.uploading" size="14px" class="q-mr-xs"></q-spinner>
            <span class="ellipsis" style="max-width:180px">{{file.fileName}}</span></q-chip>
    </div>
    <m-rich-text ref="editor" v-model="body" :name="'chatBody' + uid" light rows="1" :enter="room.prefs.enterSends === false ? 'newline' : 'submit'"
            :placeholder="placeholder" :mention-url="room.url('mentionUsers')" :mention-parameters="{chatRoomId: room.roomId}" @submit="send"></m-rich-text>
    <div class="row items-center no-wrap q-mt-xs">
        <q-btn flat round dense size="sm" icon="sym_o_attach_file" :aria-label="room.t('Attach files')" @click="pickFiles"><q-tooltip>{{room.t('Attach files')}}</q-tooltip></q-btn>
        <q-btn flat round dense size="sm" icon="sym_o_mood" :aria-label="room.t('Emoji')"><q-tooltip>{{room.t('Emoji')}}</q-tooltip>
            <q-menu anchor="top left" self="bottom left"><div class="q-pa-xs row" style="width:236px">
                <q-btn v-for="key in room.emoji" :key="key" flat dense size="sm" class="q-px-xs" :label="key" v-close-popup @click="insert(key)"></q-btn>
            </div></q-menu>
        </q-btn>
        <q-btn flat round dense size="sm" icon="sym_o_alternate_email" :aria-label="room.t('Mention someone')" @click="insert('@')"><q-tooltip>{{room.t('Mention someone')}}</q-tooltip></q-btn>
        <span class="text-caption m-muted q-ml-sm ellipsis gt-xs" v-if="!room.compact && !threadRoot">{{hint}}</span>
        <q-space></q-space>
        <q-btn dense unelevated no-caps color="primary" icon="sym_o_send" :label="room.compact ? undefined : room.t('Send')" :aria-label="room.t('Send')"
                :disable="!canSend" :loading="sending" @click="send"></q-btn>
    </div>
    <div class="hidden"><m-file ref="picker" v-model="picked" :name="'chatFile' + uid" multiple @update:model-value="onPicked"></m-file></div>
</div>`;

let composerCount = 0;
const chatComposer = {
    name: 'BossChatComposer',
    props: { room: Object, threadRoot: [Number, String], placeholder: String },
    data() {
        composerCount += 1;
        return { uid: composerCount, body: '', files: [], picked: null, sending: false, draftTimer: null };
    },
    computed: {
        draftKey() { return DRAFT_PREFIX + this.room.roomId + (this.threadRoot ? ':' + this.threadRoot : ''); },
        uploading() { return this.files.some((file) => file.uploading); },
        canSend() { return !this.sending && !this.uploading && (!isEmptyHtml(this.body) || this.files.some((file) => file.chatAttachmentId)); },
        hint() {
            return this.room.prefs.enterSends === false ? t('Ctrl+Enter to send') : t('Enter to send, Shift+Enter for a new line');
        }
    },
    watch: {
        body(value) {
            if (!isEmptyHtml(value)) this.room.typingNow();
            clearTimeout(this.draftTimer);
            this.draftTimer = setTimeout(() => this.saveDraft(), 400);
        }
    },
    methods: {
        t,
        saveDraft() {
            const has = !isEmptyHtml(this.body);
            storage.set(this.draftKey, has ? this.body : null);
            window.dispatchEvent(new CustomEvent('boss-chat-draft', { detail: { chatRoomId: this.room.roomId } }));
        },
        focus() {
            const editor = this.$refs.editor && this.$refs.editor.editor;
            if (editor) editor.commands.focus('end');
        },
        insert(text) {
            const editor = this.$refs.editor && this.$refs.editor.editor;
            if (editor) editor.chain().focus().insertContent(text).run();
            else this.body = (this.body || '') + text;
        },
        onKeydown(event) {
            if (event.isComposing) return;
            const editorVm = this.$refs.editor;
            const mentionOpen = editorVm && editorVm.mention && editorVm.mention.open;
            if (event.key === 'ArrowUp' && !event.shiftKey && !event.altKey && !event.ctrlKey && !event.metaKey && !mentionOpen && !this.threadRoot
                    && isEmptyHtml(this.body) && !this.files.length) {
                if (this.room.editLast()) { event.preventDefault(); event.stopPropagation(); }
            } else if (event.key === 'Escape' && !mentionOpen) {
                if (!this.threadRoot && this.room.replyTo) { this.room.cancelReply(); event.stopPropagation(); }
            }
        },
        send() {
            if (this.uploading) { moqui.notifyMessages([{ type: 'info', message: t('Wait for the files to finish uploading') }]); return; }
            if (!this.canSend) return;
            const text = plainOf(this.body);
            const command = /^\/(task|request|event)\b\s*([\s\S]*)$/.exec(text);
            if (command && !this.files.length) {
                this.room.quickCreateText(command[1], command[2].trim());
                this.clear();
                return;
            }
            const body = this.body;
            const ids = this.files.filter((file) => file.chatAttachmentId).map((file) => file.chatAttachmentId);
            const files = this.files;
            this.sending = true;
            this.clear();
            this.room.sendMessage({ body: isEmptyHtml(body) ? '' : body, attachmentIds: ids, threadRoot: this.threadRoot || null }).then(() => {
                this.sending = false;
                this.$nextTick(() => this.focus());
            }, () => {
                // nothing sent: the text and files come back
                this.sending = false;
                this.body = body;
                this.files = files;
            });
        },
        clear() {
            this.body = '';
            this.files = [];
            storage.set(this.draftKey, null);
            window.dispatchEvent(new CustomEvent('boss-chat-draft', { detail: { chatRoomId: this.room.roomId } }));
            this.room.typingStop();
        },
        pickFiles() {
            const input = this.$refs.picker && this.$refs.picker.$el && this.$refs.picker.$el.querySelector('input[type=file]');
            if (input) input.click();
        },
        onPicked(files) {
            const list = Array.isArray(files) ? files : (files ? [files] : []);
            this.picked = null;
            if (list.length) this.upload(list);
        },
        onPaste(event) {
            const list = Array.from((event.clipboardData && event.clipboardData.files) || []);
            if (!list.length) return;
            event.preventDefault();
            this.upload(list);
        },
        // each file goes up at once (upload#ChatFiles); the message names them when it is sent
        upload(list) {
            list.forEach((file) => {
                const entry = { key: 'f' + Date.now() + Math.random(), fileName: file.name, contentType: file.type, fileSize: file.size, uploading: true, chatAttachmentId: null };
                this.files.push(entry);
                const form = new FormData();
                form.append('chatRoomId', this.room.roomId);
                form.append('file', file, file.name);
                if (moqui.sessionToken) form.append('moquiSessionToken', moqui.sessionToken);
                moqui.request(this.room.url('upload'), { method: 'POST', params: form }).then((result) => {
                    const json = result.json || {};
                    const stored = (json.uploadList || [])[0];
                    if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos);
                    const index = this.files.indexOf(entry);
                    if (index < 0) return;
                    if (stored) this.files.splice(index, 1, Object.assign({}, entry, stored, { uploading: false }));
                    else this.files.splice(index, 1);
                }, (err) => {
                    const index = this.files.indexOf(entry);
                    if (index >= 0) this.files.splice(index, 1);
                    moqui.handleAjaxError(err);
                });
            });
        },
        removeFile(file) { this.files = this.files.filter((item) => item !== file); }
    },
    mounted() {
        const saved = storage.get(this.draftKey);
        if (saved) this.body = saved;
        this.room.registerComposer(this, this.threadRoot);
    },
    beforeUnmount() {
        clearTimeout(this.draftTimer);
        this.saveDraft();
        this.room.unregisterComposer(this, this.threadRoot);
    },
    template: composerTemplate
};

const chatEdit = {
    name: 'BossChatEdit',
    props: { room: Object, item: Object },
    data() { return { body: this.room.editing ? this.room.editing.body : '', busy: false }; },
    methods: {
        save() {
            if (this.busy) return;
            if (isEmptyHtml(this.body)) { moqui.notifyMessages([{ type: 'info', message: t('Delete the message to remove its text') }]); return; }
            this.busy = true;
            this.room.saveEdit(this.item, this.body).then(() => { this.busy = false; }, () => { this.busy = false; });
        }
    },
    template: editTemplate
};

const chatMessage = {
    name: 'BossChatMessage',
    props: { item: Object, room: Object, inThread: Boolean },
    components: { 'chat-edit': chatEdit },
    template: messageTemplate
};

// ---- the room view: header, timeline, composer and the side pane (thread, members, pinned, search, record); the Chat screen
// and the tray's Chat tab (compact) both show it ----
const roomTemplate = `
<div class="column no-wrap relative-position" style="height:100%;min-height:0" @dragover.prevent="onDragOver" @dragleave.self="dragOver = false" @drop.prevent="onDrop">
    <div class="row items-center no-wrap q-px-sm q-py-xs" style="min-height:52px">
        <q-btn v-if="canGoBack" flat round dense icon="sym_o_arrow_back" :aria-label="t('Back')" class="q-mr-xs" @click="$emit('back')"><q-tooltip>{{t('Back')}}</q-tooltip></q-btn>
        <template v-if="room">
            <m-avatar v-if="isDirect && room.otherUserId" :name="displayName" :user-id="room.otherUserId" size="34px"></m-avatar>
            <q-avatar v-else size="34px" rounded class="m-tonal text-primary" :icon="roomIcon"></q-avatar>
            <div class="col q-ml-sm" style="min-width:0">
                <div class="row items-center no-wrap">
                    <span class="text-subtitle1 text-weight-medium ellipsis" :title="displayName">{{displayName}}</span>
                    <q-icon v-if="member && member.isPinned" name="sym_o_keep" size="14px" class="q-ml-xs m-muted"><q-tooltip>{{t('Pinned to the top of my rooms')}}</q-tooltip></q-icon>
                    <q-icon v-if="member && (member.isMuted || member.notificationLevelEnumId === 'CnlNone')" name="sym_o_notifications_off" size="14px" class="q-ml-xs m-muted">
                        <q-tooltip>{{t('Muted')}}</q-tooltip></q-icon>
                    <q-chip v-if="room.archivedDate" dense square class="m-tonal text-warning q-ml-xs">{{t('Archived')}}</q-chip>
                </div>
                <div class="text-caption m-muted ellipsis">
                    <template v-if="isDirect && room.otherUserId"><span class="m-status-dot q-mr-xs" style="width:8px;height:8px" :class="'m-presence-' + (presenceOf(room.otherUserId) || 'offline')"></span>{{presenceText(room.otherUserId)}}</template>
                    <template v-else-if="room.record"><a v-if="room.record.url" href="#" class="text-primary" @click.prevent="go(room.record.url)">{{recordLabel}}</a><span v-else>{{recordLabel}}</span><span v-if="room.topic && room.topic !== recordLabel"> · {{room.topic}}</span></template>
                    <template v-else>{{room.topic || roomKindText}}</template>
                </div>
            </div>
            <div v-if="!isDirect && !narrow" class="row no-wrap items-center cursor-pointer q-mx-xs" @click="openSide('members')">
                <m-avatar v-for="person in members.slice(0, 4)" :key="person.userId" :name="person.name" :user-id="person.userId" size="24px" class="q-ml-xs"></m-avatar>
                <span class="text-caption m-muted q-ml-xs">{{members.length}}</span><q-tooltip>{{t('Members')}}</q-tooltip>
            </div>
            <q-btn v-if="access.canJoin" dense unelevated no-caps color="primary" :label="t('Join')" class="q-mx-xs" @click="join"></q-btn>
            <q-btn v-if="!narrow" flat round dense icon="sym_o_search" :aria-label="t('Search in the room')" @click="openSide('search')"><q-tooltip>{{t('Search in the room')}}</q-tooltip></q-btn>
            <q-btn v-if="!narrow" flat round dense icon="sym_o_keep" :aria-label="t('Pinned messages')" @click="openSide('pinned')"><q-tooltip>{{t('Pinned messages')}}</q-tooltip></q-btn>
            <q-btn v-if="compact" flat round dense icon="sym_o_open_in_new" :aria-label="t('Open in Chat')" @click="openInChat"><q-tooltip>{{t('Open in Chat')}}</q-tooltip></q-btn>
            <q-btn flat round dense icon="sym_o_more_vert" :aria-label="t('Room')"><q-tooltip>{{t('Room')}}</q-tooltip>
                <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:250px">
                    <template v-if="isMember">
                        <q-item-label header class="q-py-xs">{{t('Notify me of')}}</q-item-label>
                        <q-item v-for="level in levels" :key="level.value" clickable v-close-popup :active="(member && member.notificationLevelEnumId || 'CnlAll') === level.value" @click="setLevel(level.value)">
                            <q-item-section avatar><q-icon :name="level.icon"></q-icon></q-item-section><q-item-section>{{t(level.label)}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="toggleMute">
                            <q-item-section avatar><q-icon :name="member && member.isMuted ? 'sym_o_volume_up' : 'sym_o_volume_off'"></q-icon></q-item-section>
                            <q-item-section>{{member && member.isMuted ? t('Unmute') : t('Mute')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="togglePin">
                            <q-item-section avatar><q-icon name="sym_o_keep"></q-icon></q-item-section>
                            <q-item-section>{{member && member.isPinned ? t('Unpin from my rooms') : t('Pin to the top of my rooms')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="markRead(true)">
                            <q-item-section avatar><q-icon name="sym_o_done_all"></q-icon></q-item-section><q-item-section>{{t('Mark as read')}}</q-item-section></q-item>
                        <q-separator></q-separator>
                    </template>
                    <q-item v-if="!isDirect" clickable v-close-popup @click="openSide('members')">
                        <q-item-section avatar><q-icon name="sym_o_group"></q-icon></q-item-section><q-item-section>{{t('Members')}}</q-item-section></q-item>
                    <q-item v-if="narrow" clickable v-close-popup @click="openSide('pinned')">
                        <q-item-section avatar><q-icon name="sym_o_keep"></q-icon></q-item-section><q-item-section>{{t('Pinned messages')}}</q-item-section></q-item>
                    <q-item v-if="narrow" clickable v-close-popup @click="openSide('search')">
                        <q-item-section avatar><q-icon name="sym_o_search"></q-icon></q-item-section><q-item-section>{{t('Search in the room')}}</q-item-section></q-item>
                    <q-item v-if="room.record" clickable v-close-popup @click="openSide('record')">
                        <q-item-section avatar><q-icon :name="room.record.icon || 'sym_o_description'"></q-icon></q-item-section><q-item-section>{{t('The record')}}</q-item-section></q-item>
                    <q-item v-if="canModerate" clickable v-close-popup @click="openSettings">
                        <q-item-section avatar><q-icon name="sym_o_settings"></q-icon></q-item-section><q-item-section>{{t('Room settings')}}</q-item-section></q-item>
                    <template v-if="isMember">
                        <q-separator></q-separator>
                        <q-item clickable v-close-popup @click="leave">
                            <q-item-section avatar><q-icon name="sym_o_logout" color="negative"></q-icon></q-item-section>
                            <q-item-section class="text-negative">{{isDirect ? t('Hide this conversation') : t('Leave the room')}}</q-item-section></q-item>
                    </template>
                </q-list></q-menu>
            </q-btn>
        </template>
    </div>
    <q-separator></q-separator>

    <div class="col row no-wrap" style="min-height:0">
        <!-- the timeline and the composer -->
        <div v-show="!sideOverlay || !side" class="col column no-wrap" style="min-width:0">
            <div v-if="state === 'loading'" class="col q-pa-md">
                <div v-for="n in 6" :key="n" class="row no-wrap q-gutter-x-sm q-mb-md">
                    <q-skeleton type="QAvatar" size="32px"></q-skeleton>
                    <div class="col"><q-skeleton type="text" width="30%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
                </div>
            </div>
            <div v-else-if="state === 'missing'" class="col column items-center justify-center q-pa-lg text-center m-muted">
                <q-icon name="sym_o_lock" size="48px"></q-icon>
                <div class="text-subtitle2 q-mt-sm">{{t('This conversation is not available')}}</div>
                <div class="text-caption">{{t('It does not exist, or you are not in it.')}}</div>
            </div>
            <template v-else>
                <div class="col relative-position" style="min-height:0">
                    <div ref="scroller" class="absolute-full scroll q-pb-xs" @scroll="onScroll" @wheel.passive="anchor = null" @touchstart.passive="anchor = null">
                        <div v-if="hasMoreBefore" class="text-center q-py-sm">
                            <q-btn flat dense no-caps size="sm" color="primary" :loading="loadingOlder" :label="t('Earlier messages')" @click="loadOlder"></q-btn></div>
                        <div v-else class="q-px-md q-pt-lg q-pb-sm">
                            <m-avatar v-if="isDirect && room.otherUserId" :name="displayName" :user-id="room.otherUserId" size="48px"></m-avatar>
                            <q-avatar v-else size="48px" rounded class="m-tonal text-primary" :icon="roomIcon"></q-avatar>
                            <div class="text-subtitle1 text-weight-medium q-mt-sm">{{displayName}}</div>
                            <div class="text-caption m-muted">{{startText}}</div>
                        </div>
                        <template v-for="item in items" :key="item.key">
                            <div v-if="item.kind === 'day'" class="row items-center no-wrap q-my-sm q-px-sm">
                                <q-separator class="col"></q-separator><span class="text-caption text-weight-medium m-muted q-px-sm">{{item.label}}</span><q-separator class="col"></q-separator></div>
                            <div v-else-if="item.kind === 'unread'" :id="domId('unread', false)" class="row items-center no-wrap q-my-xs q-px-sm text-negative">
                                <q-separator class="col" color="negative"></q-separator><span class="text-caption text-weight-medium q-px-sm">{{t('New messages')}}</span></div>
                            <div v-else-if="item.kind === 'system'" class="text-center text-caption m-muted q-py-xs q-px-md" :class="item.target ? 'cursor-pointer' : ''"
                                    :id="domId(item.eventSeq, false)" @click="item.target ? jumpTo(item.target) : null">
                                <q-icon :name="item.icon" size="14px" class="q-mr-xs"></q-icon>{{item.text}} · {{item.time}}</div>
                            <chat-message v-else :item="item" :room="self"></chat-message>
                        </template>
                        <div v-for="pending in pendingList" :key="pending.clientRef" class="row no-wrap q-pl-xs q-pr-sm q-mt-sm" style="opacity:0.6">
                            <div style="width:46px;min-width:46px"></div>
                            <div class="col text-body2" style="min-width:0"><div class="ellipsis-2-lines">{{pending.text}}</div>
                                <div class="text-caption m-muted"><q-spinner size="12px" class="q-mr-xs"></q-spinner>{{t('Sending…')}}</div></div>
                        </div>
                    </div>
                    <q-btn v-if="!atBottom || hasMoreAfter" round unelevated size="sm" color="primary" icon="sym_o_arrow_downward" class="absolute"
                            style="right:16px;bottom:10px" :aria-label="t('Jump to the latest')" @click="jumpToLatest">
                        <q-badge v-if="newBelow" floating rounded color="negative">{{newBelow}}</q-badge><q-tooltip>{{t('Jump to the latest')}}</q-tooltip></q-btn>
                    <div v-if="dragOver && canPost" class="absolute-full q-pa-sm" style="z-index:3">
                        <q-card flat bordered class="full-height column items-center justify-center text-primary text-subtitle1" style="border-style:dashed;border-width:2px">
                            <q-icon name="sym_o_upload_file" size="40px"></q-icon>{{t('Drop the files to send them')}}</q-card></div>
                </div>
                <div class="q-px-md text-caption m-muted ellipsis" style="min-height:20px">{{typingText}}</div>
                <div class="q-px-sm q-pb-sm">
                    <q-banner v-if="access.isArchived" dense rounded class="text-caption m-muted"><template v-slot:avatar><q-icon name="sym_o_archive"></q-icon></template>
                        {{t('This room is archived: it is read only.')}}</q-banner>
                    <q-banner v-else-if="access.canJoin" dense rounded class="text-caption"><template v-slot:avatar><q-icon name="sym_o_visibility" color="info"></q-icon></template>
                        {{t('You are reading this room. Join it to post and to hear of its messages.')}}
                        <template v-slot:action><q-btn dense unelevated no-caps color="primary" :label="t('Join')" @click="join"></q-btn></template></q-banner>
                    <chat-composer v-else-if="access.canPost" :room="self" :placeholder="composerPlaceholder"></chat-composer>
                </div>
            </template>
        </div>

        <!-- the side pane: a thread, the members, the pinned messages, search in the room, the record -->
        <q-separator v-if="side && !sideOverlay" vertical></q-separator>
        <div v-if="side" class="column no-wrap" :class="sideOverlay ? 'col' : ''" :style="sideOverlay ? 'min-width:0' : 'width:360px;min-width:360px'">
            <div class="row items-center no-wrap q-px-sm" style="min-height:44px">
                <q-btn v-if="sideOverlay" flat round dense icon="sym_o_arrow_back" :aria-label="t('Back')" @click="closeSide"></q-btn>
                <div class="text-subtitle2 q-ml-xs col ellipsis">{{sideTitle}}</div>
                <q-btn v-if="!sideOverlay" flat round dense icon="sym_o_close" :aria-label="t('Close')" @click="closeSide"><q-tooltip>{{t('Close')}} (Esc)</q-tooltip></q-btn>
            </div>
            <q-separator></q-separator>

            <template v-if="side === 'thread'">
                <div ref="threadScroller" class="col scroll q-pb-sm" style="min-height:0">
                    <q-linear-progress v-if="threadView.loading" indeterminate color="primary"></q-linear-progress>
                    <template v-for="(item, index) in threadItems" :key="item.key">
                        <div v-if="item.kind === 'day'" class="row items-center no-wrap q-my-sm q-px-sm">
                            <q-separator class="col"></q-separator><span class="text-caption m-muted q-px-sm">{{item.label}}</span><q-separator class="col"></q-separator></div>
                        <template v-else-if="item.kind === 'message'">
                            <chat-message :item="item" :room="self" in-thread></chat-message>
                            <div v-if="item.eventSeq === threadView.rootSeq" class="row items-center no-wrap q-my-xs q-px-md text-caption m-muted">
                                <span>{{repliesText(threadItems.filter((row) => row.kind === 'message').length - 1)}}</span><q-separator class="col q-ml-sm"></q-separator></div>
                        </template>
                    </template>
                </div>
                <div v-if="access.canPost" class="q-px-sm q-pb-sm"><chat-composer :room="self" :thread-root="threadView.rootSeq" :placeholder="t('Reply in the thread…')"></chat-composer></div>
            </template>

            <div v-else-if="side === 'members'" class="col scroll" style="min-height:0">
                <div v-if="isMember && !isDirect && !access.isArchived" class="q-pa-sm row no-wrap items-end q-gutter-x-xs">
                    <div class="col"><m-drop-down v-model="addPeople.userIds" name="addUserIds" multiple server-search :options-url="url('searchUsers')" :label="t('Add people')"></m-drop-down></div>
                    <q-btn dense unelevated no-caps color="primary" :label="t('Add')" :loading="addPeople.busy" :disable="!addPeople.userIds.length" @click="addMembers"></q-btn>
                </div>
                <q-list dense>
                    <q-item v-for="person in members" :key="person.userId">
                        <q-item-section avatar><m-avatar :name="person.name" :user-id="person.userId" size="32px"></m-avatar></q-item-section>
                        <q-item-section><q-item-label>{{person.name}}<span v-if="person.userId === me.userId" class="m-muted"> ({{t('you')}})</span></q-item-label>
                            <q-item-label caption>{{presenceText(person.userId)}}</q-item-label></q-item-section>
                        <q-item-section side class="row no-wrap items-center">
                            <q-chip v-if="person.roleEnumId === 'CmrOwner' && !isDirect" dense square class="m-tonal">{{t('Owner')}}</q-chip>
                            <q-chip v-else-if="person.roleEnumId === 'CmrModerator'" dense square class="m-tonal text-info">{{t('Moderator')}}</q-chip>
                            <q-btn v-if="canModerate && person.userId !== me.userId && (isOwner || person.roleEnumId !== 'CmrOwner')" flat round dense size="sm" icon="sym_o_more_vert" :aria-label="t('Member')">
                                <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:200px">
                                    <q-item v-if="person.roleEnumId !== 'CmrModerator'" clickable v-close-popup @click="setRole(person, 'CmrModerator')"><q-item-section>{{t('Make a moderator')}}</q-item-section></q-item>
                                    <q-item v-if="person.roleEnumId !== 'CmrMember'" clickable v-close-popup @click="setRole(person, 'CmrMember')"><q-item-section>{{t('Make a member')}}</q-item-section></q-item>
                                    <q-item v-if="isOwner && person.roleEnumId !== 'CmrOwner'" clickable v-close-popup @click="setRole(person, 'CmrOwner')"><q-item-section>{{t('Make an owner')}}</q-item-section></q-item>
                                    <q-separator></q-separator>
                                    <q-item clickable v-close-popup @click="removeMember(person)"><q-item-section class="text-negative">{{t('Take out of the room')}}</q-item-section></q-item>
                                </q-list></q-menu>
                            </q-btn>
                        </q-item-section>
                    </q-item>
                </q-list>
            </div>

            <div v-else-if="side === 'pinned'" class="col scroll" style="min-height:0">
                <q-linear-progress v-if="pinned.loading" indeterminate color="primary"></q-linear-progress>
                <q-list dense separator>
                    <q-item v-for="event in pinned.list" :key="event.eventSeq" clickable @click="jumpTo(event.eventSeq)">
                        <q-item-section avatar top><m-avatar :name="nameOf(event.senderUserId, event.senderName)" :user-id="event.senderUserId || undefined" size="28px"></m-avatar></q-item-section>
                        <q-item-section><q-item-label class="text-weight-medium">{{nameOf(event.senderUserId, event.senderName)}}
                                <span class="text-caption m-muted"> · {{shortWhen(event.sentDate)}}</span></q-item-label>
                            <q-item-label caption class="ellipsis-3-lines">{{event.bodyText || filesText(event)}}</q-item-label></q-item-section>
                        <q-item-section v-if="canPost" side top><q-btn flat round dense size="sm" icon="sym_o_keep_off" :aria-label="t('Unpin')" @click.stop="pin({eventSeq: event.eventSeq, event: event}, false)">
                            <q-tooltip>{{t('Unpin')}}</q-tooltip></q-btn></q-item-section>
                    </q-item>
                    <q-item v-if="!pinned.loading && !pinned.list.length"><q-item-section class="m-muted text-caption">{{t('No pinned messages. Pin one from its menu to keep it here.')}}</q-item-section></q-item>
                </q-list>
            </div>

            <div v-else-if="side === 'search'" class="col column no-wrap" style="min-height:0">
                <div class="q-pa-sm row no-wrap items-center" @keydown.enter.prevent="runSearch">
                    <div class="col"><m-text-line v-model="searchPane.text" :name="'roomSearch' + uid" :label="t('Search this room')"></m-text-line></div>
                    <q-btn flat round dense icon="sym_o_search" :aria-label="t('Search')" @click="runSearch"></q-btn>
                </div>
                <div class="col scroll" style="min-height:0">
                    <q-linear-progress v-if="searchPane.loading" indeterminate color="primary"></q-linear-progress>
                    <q-list dense separator>
                        <q-item v-for="hit in searchPane.results" :key="hit.eventSeq" clickable @click="jumpTo(hit.eventSeq)">
                            <q-item-section><q-item-label class="text-weight-medium">{{hit.senderName}} <span class="text-caption m-muted"> · {{shortWhen(hit.sentDate)}}</span></q-item-label>
                                <q-item-label caption class="ellipsis-3-lines">{{hit.snippet}}</q-item-label></q-item-section>
                        </q-item>
                        <q-item v-if="searchPane.searched && !searchPane.loading && !searchPane.results.length"><q-item-section class="m-muted text-caption">{{t('No messages match')}}</q-item-section></q-item>
                    </q-list>
                </div>
            </div>

            <div v-else-if="side === 'record' && room && room.record" class="col scroll q-pa-sm" style="min-height:0">
                <m-record-card :record-entity="room.record.entity" :record-id="room.record.id" :card-url="url('recordCard')"></m-record-card>
                <q-btn v-if="room.record.url" unelevated no-caps color="primary" icon="sym_o_open_in_new" :label="t('Open the record')" class="q-mt-sm" @click="go(room.record.url)"></q-btn>
                <div class="text-caption m-muted q-mt-sm">{{t('Everyone who can see this record can read this room and join it.')}}</div>
            </div>
        </div>
    </div>

    <!-- RoomSettings: name and topic (moderators), who may join and the archive (owners) -->
    <m-dialog v-model="settings.open" :title="t('Room settings')" width="560">
        <m-text-line v-model="settings.roomName" :name="'settingsName' + uid" :label="t('Name')"></m-text-line>
        <m-text-area v-model="settings.topic" :name="'settingsTopic' + uid" rows="2" :label="t('Topic')" class="q-mt-xs"></m-text-area>
        <template v-if="isOwner">
            <m-drop-down v-model="settings.visibility" :name="'settingsVisibility' + uid" :options="visibilityOptions" :label="t('Who may join')" class="q-mt-xs"></m-drop-down>
        </template>
        <div class="row q-gutter-sm q-mt-md items-center">
            <q-btn unelevated no-caps color="primary" :label="t('Save')" :loading="settings.busy" @click="saveSettings"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
            <q-space></q-space>
            <q-btn v-if="isOwner" unelevated no-caps class="m-btn-tonal text-negative" :icon="room && room.archivedDate ? 'sym_o_unarchive' : 'sym_o_archive'"
                    :label="room && room.archivedDate ? t('Take out of the archive') : t('Archive the room')" @click="setArchived(!(room && room.archivedDate))"></q-btn>
        </div>
    </m-dialog>

    <!-- LinkToRecord: a message filed on a record, whose Chatter shows it -->
    <m-dialog v-model="fileOn.open" :title="t('File on a record')" width="520">
        <div v-if="fileOn.item" class="text-caption m-muted ellipsis-2-lines q-mb-sm">{{fileOn.item.senderName}}: {{snippetOf(fileOn.item.event)}}</div>
        <m-drop-down v-model="fileOn.value" :name="'fileOnRecord' + uid" server-search :server-min-length="2" :options-url="url('searchRecords')" :label="t('Record by id or name')"></m-drop-down>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" :label="t('File')" :disable="!fileOn.value" :loading="fileOn.busy" @click="fileOnRecord"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>

    <!-- a picture, shown here -->
    <m-dialog v-model="previewBox.open" :title="previewBox.name" width="900">
        <div class="text-center"><img v-if="previewBox.src" :src="previewBox.src" :alt="previewBox.name" style="max-width:100%;max-height:70vh"></div>
        <div class="row q-mt-sm"><q-space></q-space>
            <q-btn flat dense no-caps color="primary" icon="sym_o_download" :label="t('Download')" @click="downloadUrl(previewBox.download, previewBox.name)"></q-btn></div>
    </m-dialog>
</div>`;

let roomCount = 0;
const chatRoom = {
    name: 'BossChatRoom',
    props: { base: String, roomId: String, me: Object, prefs: { type: Object, default: () => ({}) }, seq: [Number, String], thread: [Number, String],
        compact: Boolean, canGoBack: Boolean, linkBase: { type: String, default: '/qapps/Comms/Chat' } },
    emits: ['back', 'thread', 'changed', 'left', 'open-room', 'read'],
    components: { 'chat-message': chatMessage, 'chat-composer': chatComposer },
    data() {
        roomCount += 1;
        return {
            uid: roomCount, state: 'loading', room: null, member: null, access: {}, members: [], names: {},
            events: [], hasMoreBefore: false, hasMoreAfter: false, loadingOlder: false, loadingNewer: false,
            myLastRead: 0, dividerSeq: null, highlightSeq: null, atBottom: true, newBelow: 0, holdRead: false,
            pendingList: [], hoverKey: null, tapKey: null, editing: null, replyTo: null, side: null,
            threadView: { rootSeq: null, events: [], loading: false }, pinned: { list: [], loading: false },
            searchPane: { text: '', results: [], loading: false, searched: false }, addPeople: { userIds: [], busy: false },
            settings: { open: false, roomName: '', topic: '', visibility: '', busy: false }, previewBox: { open: false, src: '', name: '', download: '' },
            tick: Date.now(), width: 0, dragOver: false, anchor: null,
            fileOn: { open: false, item: null, value: null, busy: false },
            quickReactions: QUICK_REACTIONS, emoji: EMOJI, levels: LEVELS
        };
    },
    computed: {
        self() { return this; },
        isDirect() { return !!this.room && this.room.roomTypeEnumId === 'CrtDirect'; },
        isMember() { return !!this.access.isMember; },
        canPost() { return !!this.access.canPost; },
        canModerate() { return !!this.access.canModerate; },
        isOwner() { return !!this.access.isOwner; },
        displayName() { return this.room ? (this.room.displayName || this.room.roomName || this.room.chatRoomId) : ''; },
        roomIcon() { return this.room ? ((this.room.record && this.room.record.icon) || ROOM_ICONS[this.room.roomTypeEnumId] || 'sym_o_chat') : 'sym_o_chat'; },
        recordLabel() { const record = this.room && this.room.record; return record ? [record.typeLabel, record.title].filter((part) => part).join(' · ') : ''; },
        roomKindText() {
            if (!this.room) return '';
            const type = this.room.roomTypeEnumId;
            if (type === 'CrtPublic') return t('Public room');
            if (type === 'CrtPrivate') return t('Private room');
            if (type === 'CrtRecord') return t('Record room');
            return fill(t('Group message with {count} people'), { count: this.members.length });
        },
        startText() {
            if (!this.room) return '';
            if (this.isDirect) return this.room.otherUserId ? fill(t('This is the start of your conversation with {name}.'), { name: this.displayName })
                : t('This is the start of your group conversation.');
            if (this.room.record) return fill(t('This room is about {record}. Everyone who can see the record can read it.'), { record: this.recordLabel });
            return fill(t('This is the start of {name}.'), { name: this.displayName }) + (this.room.topic ? ' ' + this.room.topic : '');
        },
        narrow() { return this.compact || (this.width > 0 && this.width < 640); },
        sideOverlay() { return this.compact || (this.width > 0 && this.width < 900); },
        sideTitle() {
            return { thread: t('Thread'), members: fill(t('Members ({count})'), { count: this.members.length }), pinned: t('Pinned messages'),
                search: t('Search in the room'), record: t('The record') }[this.side] || '';
        },
        composerPlaceholder() { return fill(this.isDirect ? t('Message {name}') : t('Message {name}… @ to mention'), { name: this.displayName }); },
        visibilityOptions() {
            if (this.room && this.room.roomTypeEnumId === 'CrtRecord')
                return [{ value: 'CrvRecord', label: t('Anyone who can see the record') }, { value: 'CrvMembers', label: t('Members only: added by a member') }];
            return [{ value: 'CrvMembers', label: t('Members only: added by a member (private)') }, { value: 'CrvUsers', label: t('Anyone in the organization (public)') }];
        },
        readersBySeq() {
            const out = {};
            if (this.prefs.readReceipts === false || !this.events.length) return out;
            const me = this.me.userId;
            const seqs = this.events.filter((event) => event.type === 'message').map((event) => Number(event.eventSeq));
            for (const person of this.members) {
                if (person.userId === me || person.isAgent) continue;
                const read = Number(person.lastReadEventSeq || 0);
                if (!read) continue;
                let at = null;
                for (const seq of seqs) { if (seq <= read) at = seq; else break; }
                if (at == null) continue;
                (out[at] = out[at] || []).push({ userId: person.userId, name: person.name });
            }
            return out;
        },
        items() { return this.buildItems(this.events, { divider: true, readers: true }); },
        threadItems() { return this.buildItems(this.threadView.events, { divider: false, readers: false }); },
        typingText() {
            void this.tick;
            if (!moqui.chat || this.prefs.typing === false) return '';
            const ids = moqui.chat.typingIn(this.roomId).filter((id) => id !== this.me.userId);
            if (!ids.length) return '';
            const names = ids.map((id) => this.nameOf(id).split(' ')[0]);
            if (names.length === 1) return fill(t('{name} is typing…'), { name: names[0] });
            if (names.length === 2) return fill(t('{a} and {b} are typing…'), { a: names[0], b: names[1] });
            return t('Several people are typing…');
        }
    },
    watch: {
        seq(value) { if (value && this.state === 'ready') this.jumpTo(Number(value)); },
        thread(value) {
            if (this.state !== 'ready') return;
            if (value && Number(value) !== this.threadView.rootSeq) this.openThread(Number(value), true);
            else if (!value && this.side === 'thread') this.side = null;
        }
    },
    methods: {
        t,
        shortWhen,
        sizeText,
        isImage,
        fileIcon,
        url(name) { return this.base + '/' + name; },
        get(name, params) {
            return moqui.request(this.url(name), { params: params || {} }).then((result) => result.json || {}, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        post(name, params) {
            return moqui.request(this.url(name), { method: 'POST', params: params || {} }).then((result) => {
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                return json;
            }, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        go(target) { if (target) this.$root.setUrl(target); },
        domId(seq, inThread) { return 'chat-' + this.uid + (inThread ? '-t-' : '-m-') + seq; },
        nameOf(userId, fallback) {
            if (!userId) return fallback || t('Someone');
            if (this.names[userId]) return this.names[userId];
            const person = this.members.find((item) => item.userId === userId);
            return (person && person.name) || fallback || userId;
        },
        mergeNames(map) { if (map) Object.keys(map).forEach((id) => { if (map[id]) this.names[id] = map[id]; }); },
        presenceOf(userId) { return moqui.chat ? moqui.chat.presenceOf(userId) : ''; },
        presenceText(userId) {
            const dot = this.presenceOf(userId) || 'offline';
            const status = moqui.chat ? moqui.chat.statusOf(userId) : null;
            const text = { online: t('Active'), away: t('Away'), dnd: t('Do not disturb'), offline: t('Offline') }[dot] || '';
            return status && status.statusText ? text + ' · ' + (status.emoji ? status.emoji + ' ' : '') + status.statusText : text;
        },
        repliesText(count) { return count === 1 ? t('1 reply') : fill(t('{count} replies'), { count }); },
        filesText(event) { return (event.attachments || []).map((file) => file.fileName).join(', '); },
        reactorsText(reaction) { return (reaction.userIds || []).map((id) => (id === this.me.userId ? t('You') : this.nameOf(id))).join(', '); },
        // the rows shown: day separators, the "new messages" divider, system rows in words and messages grouped by sender
        buildItems(events, opts) {
            const me = this.me.userId;
            const out = [];
            let prev = null;
            let lastDay = null;
            let dividerPlaced = false;
            for (const event of events) {
                const sent = Number(event.sentDate || 0);
                const day = new Date(sent).toDateString();
                if (day !== lastDay) { out.push({ kind: 'day', key: 'd' + event.eventSeq, label: dayLabel(sent) }); lastDay = day; prev = null; }
                if (opts.divider && !dividerPlaced && this.dividerSeq != null && Number(event.eventSeq) > this.dividerSeq && event.type === 'message' && event.senderUserId !== me) {
                    out.push({ kind: 'unread', key: 'unread' });
                    dividerPlaced = true;
                    prev = null;
                }
                if (event.type !== 'message') {
                    const words = systemText(event, (id) => this.nameOf(id));
                    out.push({ kind: 'system', key: 'e' + event.eventSeq, eventSeq: event.eventSeq, text: words[0], icon: words[1], time: timeText(sent),
                        target: event.type === 'pin' && event.content && event.content.pinned ? event.relatesToEventSeq : null });
                    prev = null;
                    continue;
                }
                const grouped = !!prev && prev.senderUserId === event.senderUserId && sent - prev.sentDate < GROUP_MILLIS && event.replyToEventSeq == null;
                const item = { kind: 'message', key: 'e' + event.eventSeq, eventSeq: Number(event.eventSeq), event, senderUserId: event.senderUserId,
                    senderName: this.nameOf(event.senderUserId, event.senderName), sentDate: sent, timeText: timeText(sent), timeShort: timeText(sent), fullTime: fullTime(sent),
                    bodyHtml: event.redacted ? null : (event.body ? decorateBody(event.body, me) : null), redacted: !!event.redacted, removedLabel: event.removedLabel,
                    edited: !!event.edited, editedText: event.editedDate ? fill(t('Edited {when}'), { when: fullTime(event.editedDate) }) : t('Edited'),
                    attachments: event.attachments || [], records: event.records || [], reactions: event.reactions || [],
                    replyTo: event.replyToEventSeq != null ? this.replyOf(event) : null, threadReplyCount: Number(event.threadReplyCount || 0),
                    threadLastDate: event.threadLastDate, pinned: !!event.pinned, grouped, mine: event.senderUserId === me,
                    highlight: this.highlightSeq === Number(event.eventSeq), readers: opts.readers ? (this.readersBySeq[event.eventSeq] || null) : null };
                out.push(item);
                prev = item;
            }
            return out;
        },
        replyOf(event) {
            const loaded = this.events.find((item) => Number(item.eventSeq) === Number(event.replyToEventSeq));
            if (loaded) return { eventSeq: loaded.eventSeq, senderName: this.nameOf(loaded.senderUserId, loaded.senderName), redacted: !!loaded.redacted,
                snippet: this.snippetOf(loaded) };
            if (event.replyTo) return Object.assign({}, event.replyTo, { senderName: this.nameOf(event.replyTo.senderUserId, event.replyTo.senderName) });
            return { eventSeq: event.replyToEventSeq, senderName: null, redacted: false, snippet: t('An earlier message') };
        },
        snippetOf(event) {
            const text = String(event.bodyText || plainOf(event.body) || '').replace(/\s+/g, ' ').trim();
            return (text.length > 100 ? text.slice(0, 99) + '…' : text) || this.filesText(event);
        },

        // ---- loading and paging ----
        load() {
            this.state = 'loading';
            const aroundSeq = this.seq ? Number(this.seq) : null;
            this.get('roomView', { chatRoomId: this.roomId, aroundSeq: aroundSeq || '', limit: 50 }).then((json) => {
                if (!json.room) { this.state = 'missing'; return; }
                this.applyMeta(json);
                const page = json.timeline || {};
                this.mergeNames(page.userNames);
                this.events = page.eventList || [];
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.hasMoreAfter = !!page.hasMoreAfter;
                this.myLastRead = Number((json.member && json.member.lastReadEventSeq) || 0);
                const last = Number(json.room.lastEventSeq || 0);
                this.dividerSeq = this.isMember && this.myLastRead < last && this.events.some((event) => Number(event.eventSeq) > this.myLastRead
                    && event.type === 'message' && event.senderUserId !== this.me.userId) ? this.myLastRead : null;
                this.state = 'ready';
                if (moqui.chat) moqui.chat.openRoom(this.roomId);
                this.opened = true;
                this.$emit('read', this.roomId);
                this.$nextTick(() => {
                    if (aroundSeq) this.scrollToSeq(aroundSeq, true);
                    else if (this.dividerSeq != null) this.scrollToDivider();
                    else this.scrollToBottom();
                    this.maybeMarkRead();
                    if (this.thread) this.openThread(Number(this.thread), true);
                    else if (!this.compact) this.focusComposer();
                });
            }, () => { this.state = 'missing'; });
        },
        applyMeta(json) {
            this.room = json.room;
            this.member = json.member || null;
            this.access = json.access || {};
            this.members = json.memberList || [];
            this.members.forEach((person) => { if (person.name) this.names[person.userId] = person.name; });
            if (moqui.chat) moqui.chat.watchUsers(this.members.map((person) => person.userId));
        },
        reloadMeta() {
            return this.get('room', { chatRoomId: this.roomId }).then((json) => { if (json.room) this.applyMeta(json); }, () => {});
        },
        loadOlder() {
            if (!this.hasMoreBefore || this.loadingOlder || !this.events.length) return;
            this.loadingOlder = true;
            const el = this.$refs.scroller;
            const fromEnd = el ? el.scrollHeight - el.scrollTop : 0;
            this.get('timeline', { chatRoomId: this.roomId, beforeSeq: this.events[0].eventSeq, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                const have = new Set(this.events.map((event) => Number(event.eventSeq)));
                this.events = (page.eventList || []).filter((event) => !have.has(Number(event.eventSeq))).concat(this.events);
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.loadingOlder = false;
                this.$nextTick(() => { if (el) el.scrollTop = el.scrollHeight - fromEnd; });
            }, () => { this.loadingOlder = false; });
        },
        loadNewer() {
            if (!this.hasMoreAfter || this.loadingNewer || !this.events.length) return;
            this.loadingNewer = true;
            this.get('timeline', { chatRoomId: this.roomId, afterSeq: this.events[this.events.length - 1].eventSeq, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                const have = new Set(this.events.map((event) => Number(event.eventSeq)));
                this.events = this.events.concat((page.eventList || []).filter((event) => !have.has(Number(event.eventSeq))));
                this.hasMoreAfter = !!page.hasMoreAfter;
                this.loadingNewer = false;
                if (!this.hasMoreAfter) this.maybeMarkRead();
            }, () => { this.loadingNewer = false; });
        },
        jumpTo(seq) {
            if (!seq) return;
            if (this.sideOverlay && this.side && this.side !== 'thread') this.side = null;
            const loaded = this.events.some((event) => Number(event.eventSeq) === Number(seq));
            if (loaded) { this.$nextTick(() => this.scrollToSeq(Number(seq), true)); return; }
            this.get('timeline', { chatRoomId: this.roomId, aroundSeq: seq, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                this.events = page.eventList || [];
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.hasMoreAfter = !!page.hasMoreAfter;
                this.$nextTick(() => this.scrollToSeq(Number(seq), true));
            }, () => {});
        },
        jumpToLatest() {
            this.newBelow = 0;
            if (!this.hasMoreAfter) { this.scrollToBottom(); this.maybeMarkRead(); return; }
            this.get('timeline', { chatRoomId: this.roomId, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                this.events = page.eventList || [];
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.hasMoreAfter = false;
                this.$nextTick(() => { this.scrollToBottom(); this.maybeMarkRead(); });
            }, () => {});
        },
        scrollToBottom() {
            const el = this.$refs.scroller;
            if (!el) return;
            el.scrollTop = el.scrollHeight;
            this.atBottom = true;
        },
        scrollToDivider(again) {
            if (!again) this.holdAnchor({ kind: 'divider' });
            const el = this.$refs.scroller;
            const divider = document.getElementById(this.domId('unread', false));
            if (!el || !divider) { this.scrollToBottom(); return; }
            el.scrollTop = Math.max(0, divider.offsetTop - el.clientHeight / 3);
            this.onScroll();
        },
        scrollToSeq(seq, highlight, again) {
            if (!again) this.holdAnchor({ kind: 'seq', seq: Number(seq) });
            const node = document.getElementById(this.domId(seq, false));
            if (node && node.scrollIntoView) node.scrollIntoView({ block: 'center' });
            if (highlight) {
                this.highlightSeq = Number(seq);
                clearTimeout(this.highlightTimer);
                this.highlightTimer = setTimeout(() => { this.highlightSeq = null; }, 4000);
            }
            this.onScroll();
        },
        // a picture that loads after the room opened at its divider or at a message keeps that in view; at the bottom, the bottom
        imageLoaded() {
            if (this.anchor && this.anchor.kind === 'divider') this.scrollToDivider(true);
            else if (this.anchor && this.anchor.kind === 'seq') this.scrollToSeq(this.anchor.seq, false, true);
            else if (this.atBottom && !this.hasMoreAfter) this.scrollToBottom();
        },
        holdAnchor(anchor) {
            this.anchor = anchor;
            clearTimeout(this.anchorTimer);
            this.anchorTimer = setTimeout(() => { this.anchor = null; }, 4000);
        },
        onScroll() {
            const el = this.$refs.scroller;
            if (!el) return;
            const fromBottom = el.scrollHeight - el.scrollTop - el.clientHeight;
            this.atBottom = fromBottom < 40;
            if (this.atBottom) { this.newBelow = 0; this.maybeMarkRead(); }
            if (el.scrollTop < 60 && this.hasMoreBefore && !this.loadingOlder) this.loadOlder();
            if (fromBottom < 80 && this.hasMoreAfter && !this.loadingNewer) this.loadNewer();
        },

        // ---- read markers ----
        maybeMarkRead() {
            if (!this.isMember || this.holdRead || this.hasMoreAfter || !this.atBottom || this.state !== 'ready' || !this.room) return;
            if (document.visibilityState && document.visibilityState !== 'visible') return;
            if (Number(this.room.lastEventSeq || 0) <= this.myLastRead) return;
            clearTimeout(this.readTimer);
            this.readTimer = setTimeout(() => this.markRead(false), 600);
        },
        markRead(now) {
            if (!this.isMember) return;
            if (now) this.holdRead = false;
            this.post('markRead', { chatRoomId: this.roomId }).then((json) => {
                if (json.lastReadEventSeq != null) this.myLastRead = Math.max(this.myLastRead, Number(json.lastReadEventSeq));
                if (now) this.dividerSeq = null;
                this.$emit('read', this.roomId);
            }, () => {});
        },
        markUnreadFrom(item) {
            this.post('markRead', { chatRoomId: this.roomId, eventSeq: item.eventSeq, markUnread: 'true' }).then((json) => {
                this.holdRead = true;
                this.myLastRead = Number(json.lastReadEventSeq || 0);
                this.dividerSeq = this.myLastRead;
                moqui.notifyMessages([{ type: 'info', message: t('Marked unread from this message') }]);
            }, () => {});
        },

        // ---- live: the page's chat store ----
        onEvent(payload) {
            const event = payload && payload.event;
            if (!event || payload.chatRoomId !== this.roomId || this.state !== 'ready') return;
            const me = this.me.userId;
            const seq = Number(event.eventSeq);
            if (this.room) this.room.lastEventSeq = Math.max(Number(this.room.lastEventSeq || 0), seq);
            if (event.senderUserId && event.senderName && !this.names[event.senderUserId]) this.names[event.senderUserId] = event.senderName;
            const isRow = ['message', 'membership', 'system', 'pin', 'call', 'poll'].includes(event.type);
            const mainTimeline = event.threadRootEventSeq == null;
            if (this.hasMoreAfter && isRow && mainTimeline) {
                if (event.type === 'pin') {
                    const target = this.events.find((item) => Number(item.eventSeq) === Number(event.relatesToEventSeq));
                    if (target) target.pinned = !!(event.content && event.content.pinned);
                }
                if (event.type === 'message' && event.senderUserId !== me) this.newBelow++;
            } else {
                const wasAtBottom = this.atBottom;
                applyEvent(this.events, event, me);
                if (isRow && mainTimeline) this.$nextTick(() => {
                    if (wasAtBottom || event.senderUserId === me) this.scrollToBottom();
                    else if (event.type === 'message') this.newBelow++;
                });
            }
            if (this.side === 'thread' && this.threadView.rootSeq != null) {
                const before = this.threadView.events.length;
                applyEvent(this.threadView.events, event, me, this.threadView.rootSeq);
                if (this.threadView.events.length !== before) this.$nextTick(() => { const el = this.$refs.threadScroller; if (el) el.scrollTop = el.scrollHeight; });
            }
            if (event.type === 'message') {
                const person = this.members.find((item) => item.userId === event.senderUserId);
                if (person) person.lastReadEventSeq = Math.max(Number(person.lastReadEventSeq || 0), seq);
                if (event.senderUserId === me) this.myLastRead = Math.max(this.myLastRead, seq);
                else {
                    this.maybeMarkRead();
                    const mentioned = (event.mentions || []).includes(me);
                    const level = (this.member && this.member.notificationLevelEnumId) || 'CnlAll';
                    const wants = mentioned || (level === 'CnlAll' && !(this.member && this.member.isMuted));
                    if (wants && this.prefs.sounds !== false && !(moqui.chat && moqui.chat.quiet()) && document.visibilityState !== 'visible') chime();
                }
            }
            if (event.type === 'membership' || event.type === 'system') { this.reloadMeta(); this.$emit('changed'); }
            if (this.side === 'pinned' && (event.type === 'pin' || event.type === 'redaction')) this.loadPinned();
        },
        onReadSignal(payload) {
            if (!payload || payload.chatRoomId !== this.roomId) return;
            if (payload.userId && payload.userId !== this.me.userId) {
                const person = this.members.find((item) => item.userId === payload.userId);
                if (person) person.lastReadEventSeq = Number(payload.lastReadEventSeq || 0);
            } else if (payload.lastReadEventSeq != null) this.myLastRead = Math.max(this.myLastRead, Number(payload.lastReadEventSeq));
        },
        onRoomSignal(payload) {
            if (!payload || payload.chatRoomId !== this.roomId) return;
            if (payload.action === 'left') { this.$emit('left', this.roomId); return; }
            this.reloadMeta();
        },
        onVisible() { if (document.visibilityState === 'visible') this.maybeMarkRead(); },
        typingNow() { if (this.prefs.typing !== false && this.canPost && moqui.chat) moqui.chat.typing(this.roomId); },
        typingStop() { if (moqui.chat) moqui.chat.typing(this.roomId, false); },

        // ---- the composers ----
        registerComposer(vm, threadRoot) { (this.composers = this.composers || {})[threadRoot ? 'thread' : 'main'] = vm; },
        unregisterComposer(vm, threadRoot) { const key = threadRoot ? 'thread' : 'main'; if (this.composers && this.composers[key] === vm) this.composers[key] = null; },
        focusComposer() { const vm = this.composers && this.composers.main; if (vm) vm.focus(); },
        sendMessage(message) {
            const me = this.me.userId;
            const threadRoot = message.threadRoot ? Number(message.threadRoot) : null;
            const replyTo = threadRoot ? null : this.replyTo;
            const clientRef = 'c' + Date.now() + Math.random().toString(36).slice(2, 6);
            const pending = { clientRef, text: plainOf(message.body) || t('Files') };
            if (!threadRoot) {
                this.pendingList.push(pending);
                this.replyTo = null;
                if (!this.hasMoreAfter) this.$nextTick(() => this.scrollToBottom());
            }
            return this.post('send', { chatRoomId: this.roomId, body: message.body || '', replyToEventSeq: replyTo ? replyTo.eventSeq : '',
                threadRootEventSeq: threadRoot || '', chatAttachmentIds: (message.attachmentIds || []).join(','), clientRef }).then((json) => {
                this.pendingList = this.pendingList.filter((item) => item !== pending);
                const event = json.event;
                if (!event) return json;
                const seq = Number(event.eventSeq);
                this.myLastRead = Math.max(this.myLastRead, seq);
                if (this.room) this.room.lastEventSeq = Math.max(Number(this.room.lastEventSeq || 0), seq);
                this.dividerSeq = null;
                this.holdRead = false;
                // a thread reply counts on its root through its push only, so it is not counted twice
                if (threadRoot) {
                    if (Number(this.threadView.rootSeq) === threadRoot) {
                        applyEvent(this.threadView.events, event, me, threadRoot);
                        this.$nextTick(() => { const el = this.$refs.threadScroller; if (el) el.scrollTop = el.scrollHeight; });
                    }
                } else if (this.hasMoreAfter) this.jumpToLatest();
                else {
                    applyEvent(this.events, event, me);
                    this.$nextTick(() => this.scrollToBottom());
                }
                return json;
            }, (err) => {
                this.pendingList = this.pendingList.filter((item) => item !== pending);
                if (replyTo) this.replyTo = replyTo;
                throw err;
            });
        },
        startReply(item) {
            this.replyTo = { eventSeq: item.eventSeq, senderName: item.senderName, snippet: this.snippetOf(item.event) };
            this.$nextTick(() => this.focusComposer());
        },
        cancelReply() { this.replyTo = null; },
        quickCreateText(kind, text) {
            const query = { kind };
            if (text) query[kind === 'request' ? 'requestName' : 'workEffortName'] = text;
            if (this.room && this.room.record && this.room.record.visible) {
                query.recordEntity = this.room.record.entity;
                query.recordId = this.room.record.id;
                query.recordTitle = this.room.record.title;
            }
            this.openQuickCreate('/qapps/Commons/QuickCreate?' + moqui.objToSearch(query), { task: t('New task'), request: t('New request'), event: t('New event') }[kind]);
        },
        openQuickCreate(url, title) {
            this.$root.quickCreateTitle = title || '';
            this.$root.quickCreateUrl = this.$root.shellLoadPath ? this.$root.shellLoadPath(url) : url.replace(/^\/qapps/, '/apps');
            this.$root.quickCreateShow = true;
        },

        // ---- message actions ----
        hover(item, inThread) { if (!this.isTouch()) this.hoverKey = (inThread ? 't' : 'm') + item.eventSeq; },
        unhover(item, inThread) { const key = (inThread ? 't' : 'm') + item.eventSeq; if (this.hoverKey === key) this.hoverKey = null; },
        isHovered(item, inThread) { return this.hoverKey === (inThread ? 't' : 'm') + item.eventSeq; },
        tap(item, inThread) {
            if (!this.isTouch()) return;
            const key = (inThread ? 't' : 'm') + item.eventSeq;
            this.tapKey = this.tapKey === key ? null : key;
        },
        isTouch() { return !!(this.$q.platform && this.$q.platform.has && this.$q.platform.has.touch) && this.$q.screen.lt.md; },
        showActions(item, inThread) {
            if (item.redacted || this.isEditing(item) || this.state !== 'ready') return false;
            const key = (inThread ? 't' : 'm') + item.eventSeq;
            return this.hoverKey === key || this.tapKey === key;
        },
        canEdit(item) { return item.mine && !item.redacted && this.canPost && Date.now() - item.sentDate < EDIT_WINDOW; },
        canRedact(item) { return !item.redacted && this.isMember && (item.mine || (this.canModerate && !this.isDirect)); },
        isEditing(item) { return !!this.editing && this.editing.seq === item.eventSeq; },
        startEdit(item) { this.tapKey = null; this.editing = { seq: item.eventSeq, body: item.event.body || '' }; },
        cancelEdit() { this.editing = null; this.$nextTick(() => this.focusComposer()); },
        editLast() {
            const me = this.me.userId;
            for (let i = this.events.length - 1; i >= 0; i--) {
                const event = this.events[i];
                if (event.type !== 'message' || event.senderUserId !== me || event.redacted) continue;
                if (Date.now() - Number(event.sentDate || 0) >= EDIT_WINDOW || !this.canPost) return false;
                this.editing = { seq: Number(event.eventSeq), body: event.body || '' };
                this.$nextTick(() => this.scrollToSeq(Number(event.eventSeq), false));
                return true;
            }
            return false;
        },
        saveEdit(item, body) {
            return this.post('edit', { chatRoomId: this.roomId, eventSeq: item.eventSeq, body }).then((json) => {
                if (json.event) {
                    applyEvent(this.events, json.event, this.me.userId);
                    if (this.threadView.rootSeq != null) applyEvent(this.threadView.events, json.event, this.me.userId, this.threadView.rootSeq);
                }
                this.editing = null;
                this.$nextTick(() => this.focusComposer());
                return json;
            });
        },
        react(item, key) {
            if (!this.canPost) return;
            this.tapKey = null;
            const me = this.me.userId;
            const reactions = item.event.reactions = item.event.reactions || [];
            let entry = reactions.find((reaction) => reaction.key === key);
            const mine = !!entry && entry.mine;
            // shown at once; the push of the reaction (or of its removal) leaves it as it is
            if (mine) {
                entry.userIds = entry.userIds.filter((id) => id !== me);
                entry.count = Math.max(0, entry.count - 1);
                entry.mine = false;
                if (entry.count <= 0) reactions.splice(reactions.indexOf(entry), 1);
            } else {
                if (!entry) { entry = { key, count: 0, userIds: [], mine: false }; reactions.push(entry); }
                if (!entry.userIds.includes(me)) { entry.userIds.push(me); entry.count++; }
                entry.mine = true;
            }
            this.post('react', { chatRoomId: this.roomId, eventSeq: item.eventSeq, key }).catch(() => {});
        },
        pin(item, pinned) {
            this.tapKey = null;
            if (item.event) item.event.pinned = pinned;
            this.post('pin', { chatRoomId: this.roomId, eventSeq: item.eventSeq, pinned: pinned ? 'true' : 'false' }).then(() => {
                moqui.notifyMessages([{ type: 'success', message: pinned ? t('Pinned to the room') : t('Unpinned') }]);
                if (this.side === 'pinned') this.loadPinned();
            }, () => {});
        },
        redact(item) {
            this.confirm(t('Delete the message?'), t('It is removed for everyone; the room shows that a message was removed.'), t('Delete'), true).then(() => {
                this.post('redact', { chatRoomId: this.roomId, eventSeq: item.eventSeq }).then(() => {
                    const event = { type: 'redaction', eventSeq: -1, relatesToEventSeq: item.eventSeq, content: { target: 'message' }, sentDate: Date.now(), threadRootEventSeq: null };
                    if (item.event.threadRootEventSeq == null) applyEvent(this.events, event, this.me.userId);
                    if (this.threadView.rootSeq != null) applyEvent(this.threadView.events, event, this.me.userId, this.threadView.rootSeq);
                }, () => {});
            });
        },
        copyText(item) {
            const text = item.event.bodyText || plainOf(item.event.body);
            if (navigator.clipboard) navigator.clipboard.writeText(text || '').then(() => moqui.notifyMessages([{ type: 'success', message: t('Copied') }]), () => {});
        },
        copyLink(item) {
            const link = window.location.origin + this.linkBase + '?chatRoomId=' + encodeURIComponent(this.roomId) + '&eventSeq=' + item.eventSeq;
            if (navigator.clipboard) navigator.clipboard.writeText(link).then(() => moqui.notifyMessages([{ type: 'success', message: t('Link copied') }]), () => {});
        },
        // the record is made at once and the message filed on it (create#RecordFromChatMessage); the toast opens it
        createFrom(item, kind) { this.tapKey = null; this.post('createFrom', { chatRoomId: this.roomId, eventSeq: item.eventSeq, kind }).catch(() => {}); },
        openFileOn(item) { this.tapKey = null; this.fileOn = { open: true, item, value: null, busy: false }; },
        fileOnRecord() {
            const value = String(this.fileOn.value || '');
            const at = value.indexOf('|');
            if (at <= 0) return;
            this.fileOn.busy = true;
            this.post('fileOnRecord', { chatRoomId: this.roomId, eventSeq: this.fileOn.item.eventSeq, recordEntityName: value.substring(0, at),
                recordId: value.substring(at + 1) }).then(() => { this.fileOn = { open: false, item: null, value: null, busy: false }; },
                () => { this.fileOn.busy = false; });
        },
        // a link in a message: a /qapps one opens in the canvas, any other in a new tab
        bodyClick(event) {
            const link = event.target && event.target.closest ? event.target.closest('a') : null;
            if (!link) return;
            const href = link.getAttribute('href') || '';
            event.preventDefault();
            const origin = window.location.origin;
            const local = href.indexOf(origin + '/qapps') === 0 ? href.slice(origin.length) : href;
            if (local.indexOf('/qapps') === 0) this.$root.setUrl(local);
            else if (/^(https?:|mailto:|tel:)/i.test(href)) window.open(href, '_blank', 'noopener');
        },
        fileUrl(file, inline) { return this.url('attachment') + '?chatAttachmentId=' + encodeURIComponent(file.chatAttachmentId) + (inline ? '&inline=true' : ''); },
        download(file) { this.downloadUrl(this.fileUrl(file, false), file.fileName); },
        downloadUrl(href, name) {
            const a = document.createElement('a');
            a.href = href;
            a.download = name || '';
            document.body.appendChild(a);
            a.click();
            setTimeout(() => document.body.removeChild(a), 0);
        },
        preview(file) { this.previewBox = { open: true, src: this.fileUrl(file, true), name: file.fileName, download: this.fileUrl(file, false) }; },
        onDragOver(event) { if (this.canPost && event.dataTransfer && Array.from(event.dataTransfer.types || []).includes('Files')) this.dragOver = true; },
        onDrop(event) {
            this.dragOver = false;
            const files = Array.from((event.dataTransfer && event.dataTransfer.files) || []);
            const vm = this.side === 'thread' && this.composers && this.composers.thread ? this.composers.thread : this.composers && this.composers.main;
            if (files.length && vm && this.canPost) vm.upload(files);
        },

        // ---- the side pane ----
        openSide(name) {
            if (name === 'thread') return;
            this.side = name;
            if (name === 'pinned') this.loadPinned();
            if (name === 'search') this.$nextTick(() => { const input = this.$el.querySelector('input[name="roomSearch' + this.uid + '"]'); if (input) input.focus(); });
        },
        closeSide() {
            if (this.side === 'thread') { this.threadView = { rootSeq: null, events: [], loading: false }; this.$emit('thread', null); }
            this.side = null;
        },
        openThread(seq, fromParent) {
            this.tapKey = null;
            this.side = 'thread';
            this.threadView = { rootSeq: Number(seq), events: [], loading: true };
            if (!fromParent) this.$emit('thread', Number(seq));
            this.get('timeline', { chatRoomId: this.roomId, threadRootEventSeq: seq, limit: 200 }).then((page) => {
                if (this.threadView.rootSeq !== Number(seq)) return;
                this.mergeNames(page.userNames);
                this.threadView.events = page.eventList || [];
                this.threadView.loading = false;
                this.$nextTick(() => {
                    const el = this.$refs.threadScroller;
                    if (el) el.scrollTop = el.scrollHeight;
                    const vm = this.composers && this.composers.thread;
                    if (vm && !this.compact) vm.focus();
                });
            }, () => { this.threadView.loading = false; });
        },
        loadPinned() {
            this.pinned.loading = true;
            this.get('timeline', { chatRoomId: this.roomId, pinnedOnly: 'true', limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                this.pinned = { list: page.eventList || [], loading: false };
            }, () => { this.pinned.loading = false; });
        },
        runSearch() {
            const text = String(this.searchPane.text || '').trim();
            if (!text) return;
            this.searchPane.loading = true;
            this.get('search', { searchText: text, chatRoomId: this.roomId }).then((json) => {
                this.searchPane = { text, results: json.eventList || [], loading: false, searched: true };
            }, () => { this.searchPane.loading = false; });
        },
        addMembers() {
            this.addPeople.busy = true;
            this.post('addMembers', { chatRoomId: this.roomId, userIds: this.addPeople.userIds.join(',') }).then(() => {
                this.addPeople = { userIds: [], busy: false };
                this.reloadMeta();
            }, () => { this.addPeople.busy = false; });
        },
        setRole(person, roleEnumId) { this.post('setRole', { chatRoomId: this.roomId, userId: person.userId, roleEnumId }).then(() => this.reloadMeta(), () => {}); },
        removeMember(person) {
            this.confirm(t('Take out of the room?'), fill(t('{name} no longer sees the room or hears of it.'), { name: person.name }), t('Take out'), true).then(() => {
                this.post('removeMember', { chatRoomId: this.roomId, userId: person.userId }).then(() => this.reloadMeta(), () => {});
            });
        },

        // ---- my settings in the room, the room's settings ----
        setLevel(level) {
            this.post('setNotification', { chatRoomId: this.roomId, notificationLevelEnumId: level }).then(() => {
                if (this.member) this.member.notificationLevelEnumId = level;
                this.$emit('changed');
            }, () => {});
        },
        toggleMute() {
            const muted = !(this.member && this.member.isMuted);
            this.post('setNotification', { chatRoomId: this.roomId, isMuted: muted ? 'true' : 'false' }).then(() => {
                if (this.member) this.member.isMuted = muted;
                this.$emit('changed');
            }, () => {});
        },
        togglePin() {
            const pinned = !(this.member && this.member.isPinned);
            this.post('setNotification', { chatRoomId: this.roomId, isPinned: pinned ? 'true' : 'false' }).then(() => {
                if (this.member) this.member.isPinned = pinned;
                this.$emit('changed');
            }, () => {});
        },
        join() { this.post('join', { chatRoomId: this.roomId }).then(() => { this.$emit('changed'); this.load(); }, () => {}); },
        leave() {
            const direct = this.isDirect;
            this.confirm(direct ? t('Hide this conversation?') : t('Leave the room?'),
                direct ? t('It comes back with the next message.') : t('You no longer hear of its messages; a public room you can join again.'),
                direct ? t('Hide') : t('Leave'), !direct).then(() => {
                this.post('leave', { chatRoomId: this.roomId }).then(() => this.$emit('left', this.roomId), () => {});
            });
        },
        openSettings() {
            this.settings = { open: true, roomName: this.room.roomName || '', topic: this.room.topic || '', visibility: this.room.visibilityEnumId || '', busy: false };
        },
        saveSettings() {
            const params = { chatRoomId: this.roomId, roomName: this.settings.roomName, topic: this.settings.topic || '' };
            if (this.isOwner && this.settings.visibility && this.settings.visibility !== this.room.visibilityEnumId) params.visibilityEnumId = this.settings.visibility;
            this.settings.busy = true;
            this.post('updateRoom', params).then(() => {
                this.settings = Object.assign({}, this.settings, { open: false, busy: false });
                this.reloadMeta();
                this.$emit('changed');
            }, () => { this.settings.busy = false; });
        },
        setArchived(archived) {
            this.confirm(archived ? t('Archive the room?') : t('Take the room out of the archive?'),
                archived ? t('An archived room is read only and leaves the members\' room lists.') : t('Its members can post again.'),
                archived ? t('Archive') : t('Take out'), archived).then(() => {
                this.post('updateRoom', { chatRoomId: this.roomId, archived: archived ? 'true' : 'false' }).then(() => {
                    this.settings.open = false;
                    this.reloadMeta();
                    this.$emit('changed');
                }, () => {});
            });
        },
        openInChat() { this.$root.setUrl(this.linkBase + '?chatRoomId=' + encodeURIComponent(this.roomId)); },
        // Esc: the edit, then the side pane, then mark the room read
        onEscape() {
            if (this.editing) { this.cancelEdit(); return true; }
            if (this.side) { this.closeSide(); return true; }
            this.markRead(true);
            return true;
        },
        // a confirmation (Quasar's Dialog plugin): resolves on OK; Cancel, Esc or a click outside resolves nothing
        confirm(title, message, okLabel, danger) {
            return new Promise((resolve) => {
                this.$q.dialog({ title, message, ok: { label: okLabel || t('OK'), color: danger ? 'negative' : 'primary', unelevated: true, noCaps: true },
                    cancel: { label: t('Cancel'), flat: true, noCaps: true } }).onOk(() => resolve());
            });
        }
    },
    mounted() {
        this.composers = {};
        this.unsubscribe = [];
        if (moqui.chat) {
            this.unsubscribe.push(moqui.chat.on('event', (payload) => this.onEvent(payload)));
            this.unsubscribe.push(moqui.chat.on('read', (payload) => this.onReadSignal(payload)));
            this.unsubscribe.push(moqui.chat.on('room', (payload) => this.onRoomSignal(payload)));
        }
        this.onVisibleBound = () => this.onVisible();
        document.addEventListener('visibilitychange', this.onVisibleBound);
        this.ticker = setInterval(() => { this.tick = Date.now(); }, 1000);
        if (window.ResizeObserver) {
            this.resizer = new window.ResizeObserver(() => { if (this.$el && this.$el.clientWidth) this.width = this.$el.clientWidth; });
            this.resizer.observe(this.$el);
        }
        this.width = this.$el.clientWidth || 0;
        this.load();
    },
    beforeUnmount() {
        (this.unsubscribe || []).forEach((off) => off());
        document.removeEventListener('visibilitychange', this.onVisibleBound);
        clearInterval(this.ticker);
        clearTimeout(this.readTimer);
        clearTimeout(this.highlightTimer);
        clearTimeout(this.anchorTimer);
        if (this.resizer) this.resizer.disconnect();
        if (this.opened && moqui.chat) moqui.chat.closeRoom(this.roomId);
        this.typingStop();
    },
    template: roomTemplate
};

module.exports = {
    name: 'BossChat',
    components: { 'chat-room': chatRoom },
    data() {
        return {
            loaded: false, height: 600, me: {}, prefs: {}, rooms: [], filter: 'all', search: '', drafts: {}, roomId: null, seq: null, thread: null,
            newDirect: { open: false, userIds: [], busy: false }, newRoom: { open: false, type: 'private', name: '', topic: '', userIds: [], busy: false },
            browse: { open: false, search: '', list: [], loading: false }
        };
    },
    computed: {
        params() { return this.$root.currentParameters || {}; },
        // below 1024 px the rail and the room are one pane (style-guide §3.8)
        stacked() { return this.$q.screen.lt.md; },
        base() { return this.$root.basePath + '/' + this.chatPath(); },
        linkBase() { return this.$root.linkBasePath + '/' + this.chatPath(); },
        myStatus() { return (moqui.chat && moqui.chat.state.me) || {}; },
        statusOptions() {
            return [{ value: 'online', dot: 'online', label: t('Online') }, { value: 'away', dot: 'away', label: t('Away') },
                { value: 'dnd', dot: 'dnd', label: t('Do not disturb') }, { value: 'invisible', dot: 'offline', label: t('Invisible') }];
        },
        myStatusText() {
            const me = this.myStatus;
            const option = this.statusOptions.find((item) => item.value === (me.status || 'online')) || this.statusOptions[0];
            return me.statusText || me.emoji ? ((me.emoji ? me.emoji + ' ' : '') + (me.statusText || '')) : option.label;
        },
        memberRooms() { return this.rooms.filter((room) => room.isMember); },
        filterItems() {
            const unread = this.memberRooms.filter((room) => this.countsOf(room).unread || this.countsOf(room).mentions).length;
            const mentions = this.memberRooms.filter((room) => this.countsOf(room).mentions).length;
            return [{ value: 'all', label: t('All') }, { value: 'unread', label: t('Unread'), count: unread }, { value: 'mentions', label: t('Mentions'), count: mentions },
                { value: 'direct', label: t('Direct') }, { value: 'rooms', label: t('Rooms') }, { value: 'records', label: t('Records') }];
        },
        shownRooms() {
            const text = String(this.search || '').trim().toLowerCase();
            return this.rooms.filter((room) => {
                const counts = this.countsOf(room);
                if (this.filter === 'unread' && !(counts.unread || counts.mentions)) return false;
                if (this.filter === 'mentions' && !counts.mentions) return false;
                if (this.filter === 'direct' && room.roomTypeEnumId !== 'CrtDirect') return false;
                if (this.filter === 'rooms' && !(room.roomTypeEnumId === 'CrtPrivate' || room.roomTypeEnumId === 'CrtPublic')) return false;
                if (this.filter === 'records' && room.roomTypeEnumId !== 'CrtRecord') return false;
                if (text) {
                    const hay = [room.displayName, room.topic, room.record && room.record.title, room.lastMessage && room.lastMessage.snippet].join(' ').toLowerCase();
                    if (hay.indexOf(text) < 0) return false;
                }
                return true;
            });
        },
        groups() {
            const shown = this.shownRooms;
            if (this.filter !== 'all' || String(this.search || '').trim()) return [{ key: 'found', label: null, rows: shown }];
            const pinned = shown.filter((room) => room.isPinned);
            const rest = shown.filter((room) => !room.isPinned);
            const out = [];
            if (pinned.length) out.push({ key: 'pinned', label: t('Pinned'), rows: pinned });
            if (rest.length) out.push({ key: 'recent', label: pinned.length ? t('Recent') : null, rows: rest });
            return out;
        }
    },
    watch: {
        // a room change opens that room; the screen is not remounted for it
        '$root.currentParameters': { handler() { if (this.isCurrent()) this.applyParams(); }, deep: true }
    },
    methods: {
        t,
        shortWhen,
        chatPath() {
            const list = this.$root.currentPathList || [];
            const at = list.indexOf('Chat');
            return at > 0 && list[at - 1] !== 'Panel' ? list.slice(0, at + 1).join('/') : 'Comms/Chat';
        },
        isCurrent() { const list = this.$root.currentPathList || []; return list[list.length - 1] === 'Chat' && list[list.length - 2] !== 'Panel'; },
        url(name) { return this.base + '/' + name; },
        go(target) { if (target) this.$root.setUrl(target); },
        get(name, params) {
            return moqui.request(this.url(name), { params: params || {} }).then((result) => result.json || {}, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        post(name, params) {
            return moqui.request(this.url(name), { method: 'POST', params: params || {} }).then((result) => {
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                return json;
            }, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        roomIcon(room) { return (room.record && room.record.icon) || ROOM_ICONS[room.roomTypeEnumId] || 'sym_o_chat'; },
        countsOf(room) {
            if (!room.isMember) return { unread: 0, mentions: 0 };
            if (moqui.chat && moqui.chat.state.unread[room.chatRoomId]) return moqui.chat.unreadOf(moqui.chat.state, room.chatRoomId);
            return { unread: room.unreadCount || 0, mentions: room.mentionCount || 0 };
        },
        snippetOf(room) {
            const last = room.lastMessage;
            if (!room.isMember) return t('Public room: not joined');
            if (!last) return room.topic || t('No messages yet');
            const who = last.senderUserId === this.me.userId ? t('You') : String(last.senderName || '').split(' ')[0];
            const text = last.redacted || !last.snippet ? t('Message removed') : last.snippet;
            return room.roomTypeEnumId === 'CrtDirect' && last.senderUserId !== this.me.userId && room.otherUserId ? text : (who ? who + ': ' : '') + text;
        },
        clearLabel(value) { return t(CLEAR_LABELS[String(value)] || CLEAR_LABELS['0']); },
        clearFilters() { this.filter = 'all'; this.search = ''; },

        // ---- the room in the URL ----
        applyParams() {
            const p = this.params;
            if (p.dm) { this.startDirect(String(p.dm).split(','), true); return; }
            if (p.recordEntity && p.recordId) { this.openRecordRoom(p.recordEntity, p.recordId); return; }
            this.roomId = p.chatRoomId || null;
            this.seq = p.eventSeq ? Number(p.eventSeq) : null;
            this.thread = p.thread ? Number(p.thread) : null;
        },
        openRoom(id) {
            if (!id) return;
            if (id === this.roomId && !this.seq) return;
            this.$root.setUrl(this.linkBase + '?chatRoomId=' + encodeURIComponent(id));
        },
        // the room a dm or record link found, in place of that link in the history
        replaceRoom(id) {
            const target = this.linkBase + (id ? '?chatRoomId=' + encodeURIComponent(id) : '');
            this.$root.setUrl(target, null, null, false);
            try { window.history.replaceState(null, document.title, target); } catch (err) { /* the history stays */ }
        },
        closeRoom() { this.$root.setUrl(this.linkBase); },
        setThread(seq) { this.$root.setParameters({ thread: seq || null }); },
        onLeft(id) { if (this.roomId === id) this.closeRoom(); this.scheduleRooms(); },
        onRoomRead(id) {
            if (moqui.chat) moqui.chat.state.unread[id] = { unread: 0, mentions: 0 };
            const room = this.rooms.find((item) => item.chatRoomId === id);
            if (room) { room.unreadCount = 0; room.mentionCount = 0; }
        },

        // ---- the rooms ----
        loadRooms() {
            return this.get('chatData').then((json) => {
                this.me = json.me || {};
                this.prefs = json.prefs || {};
                this.rooms = json.roomList || [];
                if (moqui.chat) this.rooms.forEach((room) => {
                    if (room.isMember && room.chatRoomId !== this.roomId) moqui.chat.state.unread[room.chatRoomId] = { unread: room.unreadCount || 0, mentions: room.mentionCount || 0 };
                    if (room.otherUserId && room.presence && !moqui.chat.state.presence[room.otherUserId]) moqui.chat.state.presence[room.otherUserId] = { presence: room.presence, at: Date.now() };
                });
                this.loaded = true;
            }, () => { this.loaded = true; });
        },
        scheduleRooms() { clearTimeout(this.roomsTimer); this.roomsTimer = setTimeout(() => this.loadRooms(), 400); },
        sortRooms() {
            this.rooms.sort((left, right) => {
                if (left.isMember !== right.isMember) return left.isMember ? -1 : 1;
                if (left.isPinned !== right.isPinned) return left.isPinned ? -1 : 1;
                return (right.lastEventDate || 0) - (left.lastEventDate || 0);
            });
        },
        // a push of the page's chat store: the room's last message and its place in the rail
        onEvent(payload) {
            const event = payload && payload.event;
            if (!event) return;
            const room = this.rooms.find((item) => item.chatRoomId === payload.chatRoomId);
            if (!room) { this.scheduleRooms(); return; }
            const me = this.me.userId;
            room.lastEventSeq = Math.max(Number(room.lastEventSeq || 0), Number(event.eventSeq));
            if (event.type === 'message' && event.threadRootEventSeq == null) {
                const text = String(event.bodyText || '').replace(/\s+/g, ' ').trim();
                room.lastMessage = { eventSeq: event.eventSeq, senderUserId: event.senderUserId, senderName: event.senderName, sentDate: event.sentDate,
                    snippet: (text.length > 140 ? text.slice(0, 139) + '…' : text) || (event.attachments || []).map((file) => '📎 ' + file.fileName).join(', '), redacted: false };
                room.lastEventDate = event.sentDate;
            } else if (event.type === 'edit' && room.lastMessage && Number(event.editsEventSeq) === Number(room.lastMessage.eventSeq)) {
                room.lastMessage.snippet = String(event.bodyText || '').replace(/\s+/g, ' ').trim();
            } else if (event.type === 'redaction' && room.lastMessage && Number(event.relatesToEventSeq) === Number(room.lastMessage.eventSeq)) {
                this.scheduleRooms();
            }
            if (event.type === 'message' && event.senderUserId !== me && room.chatRoomId !== this.roomId) {
                const mentioned = (event.mentions || []).includes(me);
                const wants = mentioned || ((room.notificationLevelEnumId || 'CnlAll') === 'CnlAll' && !room.isMuted);
                if (wants && this.prefs.sounds !== false && !(moqui.chat && moqui.chat.quiet())) chime();
            }
            this.sortRooms();
        },
        onRoomSignal() { this.scheduleRooms(); },
        onReadSignal(payload) {
            if (!payload || (payload.userId && payload.userId !== this.me.userId)) return;
            if (payload.all) this.rooms.forEach((room) => { room.unreadCount = 0; room.mentionCount = 0; });
            else {
                const room = this.rooms.find((item) => item.chatRoomId === payload.chatRoomId);
                if (room) { room.unreadCount = 0; room.mentionCount = 0; }
            }
        },
        readDrafts() {
            const out = {};
            storage.keys(DRAFT_PREFIX).forEach((key) => { const id = key.slice(DRAFT_PREFIX.length); if (id.indexOf(':') < 0) out[id] = true; });
            this.drafts = out;
        },
        markAllRead() {
            this.post('markAllRead', {}).then(() => {
                if (moqui.chat) Object.keys(moqui.chat.state.unread).forEach((id) => { moqui.chat.state.unread[id] = { unread: 0, mentions: 0 }; });
                this.rooms.forEach((room) => { room.unreadCount = 0; room.mentionCount = 0; });
            }, () => {});
        },
        moveRoom(step, unreadOnly) {
            const list = this.shownRooms.filter((room) => !unreadOnly || this.countsOf(room).unread || this.countsOf(room).mentions || room.chatRoomId === this.roomId);
            if (!list.length) return false;
            const at = list.findIndex((room) => room.chatRoomId === this.roomId);
            let next = at < 0 ? (step > 0 ? 0 : list.length - 1) : at + step;
            if (unreadOnly && at >= 0) {
                next = -1;
                for (let i = at + step; i >= 0 && i < list.length; i += step) if (list[i].chatRoomId !== this.roomId) { next = i; break; }
            }
            if (next < 0 || next >= list.length) return true;
            this.openRoom(list[next].chatRoomId);
            return true;
        },

        // ---- my status ----
        setStatus(status) { if (moqui.chat) moqui.chat.setStatus({ status }); },
        usePreset(preset) {
            if (!moqui.chat) return;
            const clear = String(preset.clearAfter || '0');
            const params = { statusText: preset.text || '', emoji: preset.emoji || '' };
            if (clear === '0') params.clearAfterMinutes = 0;
            else params.clearAt = /^\d+$/.test(clear) ? Number(clear) : clear;
            moqui.chat.setStatus(params);
        },
        clearStatus() { if (moqui.chat) moqui.chat.setStatus({ clearStatus: true }); },

        // ---- new conversations ----
        openNewDirect() { this.newDirect = { open: true, userIds: [], busy: false }; },
        openNewRoom() { this.newRoom = { open: true, type: 'private', name: '', topic: '', userIds: [], busy: false }; },
        startDirect(userIds, fromLink) {
            const ids = (userIds || this.newDirect.userIds || []).map((id) => String(id).trim()).filter((id) => id);
            if (!ids.length) return;
            this.newDirect.busy = true;
            this.post('createDirect', { userIds: ids.join(',') }).then((json) => {
                this.newDirect = { open: false, userIds: [], busy: false };
                this.scheduleRooms();
                if (fromLink) this.replaceRoom(json.chatRoomId); else this.openRoom(json.chatRoomId);
            }, () => { this.newDirect.busy = false; if (fromLink) this.replaceRoom(null); });
        },
        createRoom() {
            this.newRoom.busy = true;
            this.post('createRoom', { roomTypeEnumId: this.newRoom.type, roomName: this.newRoom.name, topic: this.newRoom.topic || '',
                memberUserIds: (this.newRoom.userIds || []).join(',') }).then((json) => {
                this.newRoom = { open: false, type: 'private', name: '', topic: '', userIds: [], busy: false };
                this.scheduleRooms();
                this.openRoom(json.chatRoomId);
            }, () => { this.newRoom.busy = false; });
        },
        openRecordRoom(recordEntity, recordId) {
            this.post('recordRoom', { recordEntity, recordId }).then((json) => {
                this.scheduleRooms();
                this.replaceRoom(json.chatRoomId);
            }, () => this.replaceRoom(null));
        },
        openBrowse() { this.browse = { open: true, search: '', list: [], loading: false }; this.loadBrowse(); },
        loadBrowse() {
            this.browse.loading = true;
            this.get('rooms', { joinableOnly: 'true', searchText: this.browse.search || '' }).then((json) => {
                this.browse.list = json.roomList || [];
                this.browse.loading = false;
            }, () => { this.browse.loading = false; });
        },
        viewBrowsed(room) { this.browse.open = false; this.openRoom(room.chatRoomId); },
        joinBrowsed(room) {
            this.post('join', { chatRoomId: room.chatRoomId }).then(() => {
                this.browse.open = false;
                this.scheduleRooms();
                this.openRoom(room.chatRoomId);
            }, () => {});
        },

        // ---- the page ----
        measure() {
            const box = this.$el && this.$el.querySelector ? this.$el.querySelector('.m-chat') : null;
            if (!box || !box.getBoundingClientRect) return;
            const top = box.getBoundingClientRect().top + (window.scrollY || 0);
            const footer = document.querySelector('.q-footer');
            this.height = Math.max(this.stacked ? 420 : 480, window.innerHeight - top - (footer ? footer.offsetHeight : 0) - 6);
            this.$nextTick(() => {
                const over = document.documentElement.scrollHeight - window.innerHeight;
                if (over > 0 && over < 80 && this.height - over >= (this.stacked ? 420 : 480)) this.height -= over;
            });
        },
        escape() { const room = this.$refs.room; return room ? room.onEscape() : false; },
        registerKeys() {
            if (!moqui.keymap || !moqui.keymap.registerScope) return;
            const key = (keys, label, run, action, when) => ({ keys, label, action: action || keys, when, run: (event) => run(event) !== false });
            this.unregisterKeys = moqui.keymap.registerScope('Chat', [
                key('Alt+Up', t('Previous room'), () => this.moveRoom(-1, false), 'previousRoom'),
                key('Alt+Down', t('Next room'), () => this.moveRoom(1, false), 'nextRoom'),
                key('Alt+Shift+Up', t('Previous unread room'), () => this.moveRoom(-1, true), 'previousUnreadRoom'),
                key('Alt+Shift+Down', t('Next unread room'), () => this.moveRoom(1, true), 'nextUnreadRoom'),
                key('Esc', t('Mark the room read and close the side pane'), () => this.escape(), 'markRoomRead', () => !this.$root.trayOpen && !!this.$refs.room),
                key('Shift+Esc', t('Mark every room read'), () => { this.markAllRead(); return true; }, 'markAllRead')
            ]);
        }
    },
    mounted() {
        this.measure();
        this.onResize = () => this.measure();
        window.addEventListener('resize', this.onResize);
        this.onDraft = () => this.readDrafts();
        window.addEventListener('boss-chat-draft', this.onDraft);
        this.readDrafts();
        this.unsubscribe = [];
        if (moqui.chat) {
            this.unsubscribe.push(moqui.chat.on('event', (payload) => this.onEvent(payload)));
            this.unsubscribe.push(moqui.chat.on('room', (payload) => this.onRoomSignal(payload)));
            this.unsubscribe.push(moqui.chat.on('read', (payload) => this.onReadSignal(payload)));
        }
        this.registerKeys();
        this.loadRooms().then(() => this.$nextTick(() => this.measure()));
        this.applyParams();
        setTimeout(() => this.measure(), 300);
    },
    beforeUnmount() {
        window.removeEventListener('resize', this.onResize);
        window.removeEventListener('boss-chat-draft', this.onDraft);
        (this.unsubscribe || []).forEach((off) => off());
        if (this.unregisterKeys) this.unregisterKeys();
        clearTimeout(this.roomsTimer);
    }
};
</script>
