<!-- Chat (design-drawers-commons.md §13 Chat), the component Chat.xml serves in the qvue render mode: the rail (my status with
    its presets, New direct message, New room, Browse rooms, a find line, the filter chips All, Unread, Mentions, Direct,
    Rooms and Records, the pinned rooms and then the rest by their last message, each with its avatar or presence dot, last
    message, draft pen and unread and mention badges) and the room view (chat-room, below in the script, which the tray's Chat
    tab also shows). The room is in the URL (chatRoomId, eventSeq, thread; dm and recordEntity with recordId to start a direct
    message or open a record's room), read from $root.currentParameters, so a room is a link and Back works; below 1024 px
    the rail is the screen and a room opens over it with a back arrow. The live parts come from the page's chat store
    (moqui.chat.on: events, room changes, read markers, typing), the rest from the JSON transitions of Chat.xml. The Chat key
    scope: Alt+Up and Alt+Down change room, with Shift the unread ones, Esc marks the room read and closes the side pane,
    Shift+Esc marks every room read, Up in an empty composer edits my last message. Brand color names and Quasar classes
    only (style-guide §4.8, §5); the m-* inputs for what is typed. -->
<template><div class="m-chat-root"><div class="m-chat row no-wrap" :style="{height: height + 'px'}">
    <!-- the rail -->
    <div v-show="!stacked || !roomId" class="column no-wrap" :style="stacked ? 'width:100%' : 'width:300px;min-width:300px'">
        <div class="row items-center no-wrap q-px-sm q-pt-sm q-pb-xs">
            <q-btn flat dense no-caps align="left" class="col q-px-xs" :aria-label="t('My status')">
                <div class="row items-center no-wrap full-width" style="min-width:0">
                    <m-avatar :name="me.name || ''" :user-id="me.userId || undefined" size="30px"></m-avatar>
                    <div class="col q-ml-sm text-left" style="min-width:0">
                        <div class="text-subtitle2 ellipsis">{{t('Chat')}}</div>
                        <div class="text-caption m-muted ellipsis">{{myStatusText}}</div>
                    </div>
                    <q-icon name="sym_o_expand_more" size="18px" class="m-muted"></q-icon>
                </div>
                <q-menu anchor="bottom left" self="top left">
                    <q-list dense style="min-width:260px">
                        <q-item v-for="option in statusOptions" :key="option.value" clickable v-close-popup :active="myStatus.status === option.value"
                                @click="setStatus(option.value)">
                            <q-item-section avatar style="min-width:28px"><span class="m-status-dot" :class="'m-presence-' + option.dot"></span></q-item-section>
                            <q-item-section>{{option.label}}</q-item-section>
                        </q-item>
                        <q-separator spaced></q-separator>
                        <q-item-label header class="q-py-xs">{{t('Set a status')}}</q-item-label>
                        <q-item v-for="(preset, index) in prefs.statusPresets || []" :key="'preset' + index" clickable v-close-popup @click="usePreset(preset)">
                            <q-item-section avatar style="min-width:28px"><span>{{preset.emoji || '💬'}}</span></q-item-section>
                            <q-item-section><q-item-label>{{preset.text}}</q-item-label>
                                <q-item-label caption>{{clearLabel(preset.clearAfter)}}</q-item-label></q-item-section>
                        </q-item>
                        <q-item v-if="myStatus.statusText || myStatus.emoji" clickable v-close-popup @click="clearStatus">
                            <q-item-section avatar style="min-width:28px"><q-icon name="sym_o_close" size="18px"></q-icon></q-item-section>
                            <q-item-section>{{t('Clear status')}}</q-item-section>
                        </q-item>
                        <q-separator spaced></q-separator>
                        <q-item clickable v-close-popup @click="go('/qapps/Comms/Settings/Chat')">
                            <q-item-section avatar style="min-width:28px"><q-icon name="sym_o_settings" size="18px"></q-icon></q-item-section>
                            <q-item-section>{{t('Chat settings')}}</q-item-section>
                        </q-item>
                    </q-list>
                </q-menu>
            </q-btn>
            <q-btn flat round dense icon="sym_o_edit_square" color="primary" :aria-label="t('New message or room')">
                <q-tooltip>{{t('New message or room')}}</q-tooltip>
                <q-menu anchor="bottom right" self="top right">
                    <q-list dense style="min-width:220px">
                        <q-item clickable v-close-popup @click="openNewDirect()"><q-item-section avatar><q-icon name="sym_o_person_add"></q-icon></q-item-section>
                            <q-item-section>{{t('New direct message')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="openNewRoom()"><q-item-section avatar><q-icon name="sym_o_group_add"></q-icon></q-item-section>
                            <q-item-section>{{t('New room')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="openBrowse()"><q-item-section avatar><q-icon name="sym_o_travel_explore"></q-icon></q-item-section>
                            <q-item-section>{{t('Browse rooms')}}</q-item-section></q-item>
                        <q-separator></q-separator>
                        <q-item clickable v-close-popup @click="markAllRead"><q-item-section avatar><q-icon name="sym_o_done_all"></q-icon></q-item-section>
                            <q-item-section>{{t('Mark all read')}}</q-item-section></q-item>
                    </q-list>
                </q-menu>
            </q-btn>
        </div>
        <div class="q-px-sm q-pb-xs" @keydown.esc="search = ''">
            <m-text-line v-model="search" name="chatRoomSearch" id="ChatRoomSearch" :label="t('Find a room or person')"></m-text-line>
        </div>
        <div class="row q-px-sm q-pb-xs">
            <q-chip v-for="item in filterItems" :key="item.value" dense clickable :outline="filter !== item.value" :color="filter === item.value ? 'primary' : undefined"
                    :text-color="filter === item.value ? 'white' : undefined" class="q-ml-none q-mr-xs q-my-none" :data-filter="item.value" @click="filter = item.value">
                {{item.label}}<span v-if="item.count" class="q-ml-xs text-weight-bold">{{item.count}}</span></q-chip>
        </div>
        <q-separator></q-separator>
        <div class="col scroll" style="min-height:0">
            <div v-if="!loaded" class="q-pa-sm">
                <div v-for="n in 7" :key="n" class="row items-center no-wrap q-py-sm q-gutter-x-sm">
                    <q-skeleton type="QAvatar" size="32px"></q-skeleton>
                    <div class="col"><q-skeleton type="text" width="50%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
                </div>
            </div>
            <q-list v-else dense>
                <template v-for="group in groups" :key="group.key">
                    <q-item-label v-if="group.label" header class="q-py-xs q-px-md text-caption text-weight-medium">{{group.label}}</q-item-label>
                    <q-item v-for="room in group.rows" :key="room.chatRoomId" clickable :active="room.chatRoomId === roomId" active-class="m-tonal text-primary"
                            class="q-py-xs q-px-sm" :data-room="room.chatRoomId" @click="openRoom(room.chatRoomId)">
                        <q-item-section avatar style="min-width:42px">
                            <m-avatar v-if="room.roomTypeEnumId === 'CrtDirect' && room.otherUserId" :name="room.displayName" :user-id="room.otherUserId" size="32px"></m-avatar>
                            <q-avatar v-else size="32px" rounded class="m-tonal text-primary" :icon="roomIcon(room)"></q-avatar>
                        </q-item-section>
                        <q-item-section style="min-width:0">
                            <q-item-label class="row no-wrap items-center">
                                <span class="ellipsis" :class="countsOf(room).unread || countsOf(room).mentions ? 'text-weight-bold' : ''">{{room.displayName}}</span>
                                <q-icon v-if="room.isPinned" name="sym_o_keep" size="12px" class="m-muted q-ml-xs"></q-icon>
                                <q-space></q-space>
                                <span class="text-caption m-muted text-no-wrap q-ml-xs">{{shortWhen(room.lastMessage ? room.lastMessage.sentDate : room.lastEventDate)}}</span>
                            </q-item-label>
                            <q-item-label caption class="row no-wrap items-center">
                                <q-icon v-if="drafts[room.chatRoomId]" name="sym_o_edit" size="12px" class="text-negative q-mr-xs"><q-tooltip>{{t('Draft')}}</q-tooltip></q-icon>
                                <span class="ellipsis col">{{snippetOf(room)}}</span>
                                <q-icon v-if="room.isMuted || room.notificationLevelEnumId === 'CnlNone'" name="sym_o_notifications_off" size="12px" class="m-muted q-ml-xs"></q-icon>
                                <q-badge v-if="countsOf(room).mentions" color="negative" rounded class="q-ml-xs">@{{countsOf(room).mentions}}</q-badge>
                                <q-badge v-else-if="countsOf(room).unread" :color="room.isMuted || room.notificationLevelEnumId !== 'CnlAll' ? 'grey-6' : 'primary'" rounded
                                        class="q-ml-xs">{{countsOf(room).unread}}</q-badge>
                            </q-item-label>
                        </q-item-section>
                    </q-item>
                </template>
            </q-list>
            <div v-if="loaded && !rooms.length" class="column items-center q-pa-lg text-center">
                <q-icon name="sym_o_forum" size="48px" class="m-muted"></q-icon>
                <div class="text-subtitle2 q-mt-sm">{{t('Start a conversation')}}</div>
                <div class="text-caption m-muted q-mb-md">{{t('Message a colleague, or make a room for a team or a topic.')}}</div>
                <q-btn unelevated no-caps color="primary" icon="sym_o_person_add" :label="t('New direct message')" @click="openNewDirect()"></q-btn>
                <q-btn flat no-caps color="primary" icon="sym_o_travel_explore" :label="t('Browse rooms')" class="q-mt-xs" @click="openBrowse()"></q-btn>
            </div>
            <div v-else-if="loaded && !shownRooms.length" class="q-pa-md text-caption m-muted text-center">
                {{t('No rooms match')}} <a href="#" class="text-primary" @click.prevent="clearFilters">{{t('Clear filters')}}</a>
            </div>
        </div>
    </div>
    <q-separator v-if="!stacked" vertical></q-separator>

    <!-- the room -->
    <div v-show="!stacked || roomId" class="col column no-wrap" style="min-width:0">
        <chat-room v-if="roomId && loaded" :key="roomId" ref="room" :base="base" :room-id="roomId" :me="me" :prefs="prefs" :seq="seq" :thread="thread"
                :can-go-back="stacked" :link-base="linkBase" @back="closeRoom" @thread="setThread" @changed="scheduleRooms" @left="onLeft"
                @open-room="openRoom" @create-from="openQuickCreate" @read="onRoomRead"></chat-room>
        <div v-else class="col column items-center justify-center q-pa-lg text-center m-muted">
            <q-icon name="sym_o_chat" size="56px"></q-icon>
            <div class="text-subtitle1 q-mt-sm">{{t('Pick a conversation')}}</div>
            <div class="text-caption q-mb-md">{{t('Or start a new one: a direct message or a room.')}}</div>
            <div class="row q-gutter-sm justify-center">
                <q-btn unelevated no-caps color="primary" icon="sym_o_person_add" :label="t('New direct message')" @click="openNewDirect()"></q-btn>
                <q-btn unelevated no-caps class="m-btn-tonal" icon="sym_o_group_add" :label="t('New room')" @click="openNewRoom()"></q-btn>
            </div>
        </div>
    </div>
</div>

    <!-- NewDirect: one person, or several for a group message -->
    <m-dialog v-model="newDirect.open" :title="t('New direct message')" width="520">
        <m-drop-down v-model="newDirect.userIds" name="directUserIds" multiple server-search :options-url="url('searchUsers')" :label="t('To')"></m-drop-down>
        <div class="text-caption m-muted q-mt-xs">{{t('One person, or several for a group message. A conversation you already have with them opens again.')}}</div>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" icon="sym_o_chat" :label="t('Start')" :loading="newDirect.busy" :disable="!newDirect.userIds.length" @click="startDirect"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>

    <!-- NewRoom: name, topic, private or public, members -->
    <m-dialog v-model="newRoom.open" :title="t('New room')" width="560">
        <q-btn-toggle v-model="newRoom.type" spread dense no-caps unelevated toggle-color="primary" class="q-mb-xs"
                :options="[{label: t('Private'), value: 'private', icon: 'sym_o_lock'}, {label: t('Public'), value: 'public', icon: 'sym_o_tag'}]"></q-btn-toggle>
        <div class="text-caption m-muted q-mb-sm">{{newRoom.type === 'public' ? t('Anyone can find this room, read it and join.') : t('Only the people in it see it; members add others.')}}</div>
        <m-text-line v-model="newRoom.name" name="roomName" :label="t('Name')" required></m-text-line>
        <m-text-area v-model="newRoom.topic" name="roomTopic" rows="2" :label="t('Topic')" class="q-mt-xs"></m-text-area>
        <m-drop-down v-model="newRoom.userIds" name="roomUserIds" multiple server-search :options-url="url('searchUsers')" :label="t('Members')" class="q-mt-xs"></m-drop-down>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" icon="sym_o_add" :label="t('Create')" :loading="newRoom.busy" :disable="!String(newRoom.name || '').trim()" @click="createRoom"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>

    <!-- Browse rooms: the public rooms I am not in, to read or join -->
    <m-dialog v-model="browse.open" :title="t('Browse rooms')" width="620">
        <div class="row no-wrap items-center q-gutter-x-xs" @keydown.enter.prevent="loadBrowse">
            <div class="col"><m-text-line v-model="browse.search" name="browseSearch" :label="t('Find a room')"></m-text-line></div>
            <q-btn flat round dense icon="sym_o_search" :aria-label="t('Search')" @click="loadBrowse"></q-btn>
        </div>
        <q-list dense separator class="q-mt-sm">
            <q-item v-for="room in browse.list" :key="room.chatRoomId" class="q-px-xs">
                <q-item-section avatar><q-avatar size="32px" rounded class="m-tonal text-primary" :icon="roomIcon(room)"></q-avatar></q-item-section>
                <q-item-section><q-item-label class="text-weight-medium">{{room.displayName}}</q-item-label>
                    <q-item-label caption class="ellipsis-2-lines">{{room.topic || (room.record ? room.record.typeLabel + ' ' + room.record.title : t('No topic'))}}</q-item-label></q-item-section>
                <q-item-section side><div class="row no-wrap q-gutter-x-xs">
                    <q-btn flat dense no-caps color="primary" :label="t('View')" @click="viewBrowsed(room)"></q-btn>
                    <q-btn unelevated dense no-caps color="primary" :label="t('Join')" @click="joinBrowsed(room)"></q-btn>
                </div></q-item-section>
            </q-item>
            <q-item v-if="!browse.loading && !browse.list.length"><q-item-section class="m-muted">{{t('No public rooms to join')}}</q-item-section></q-item>
        </q-list>
        <q-inner-loading :showing="browse.loading"></q-inner-loading>
    </m-dialog>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const DAY = 86400000;
const GROUP_MILLIS = 5 * 60000;
const EDIT_WINDOW = 24 * 3600000;
const QUICK_REACTIONS = ['👍', '❤️', '😂', '🎉', '👀', '✅'];
const EMOJI = ['😀', '😃', '😄', '😁', '😅', '😂', '🙂', '😉', '😊', '😍', '🤔', '😐', '😴', '😎', '🥳', '😢', '😮', '😬', '🙃', '🤝',
    '👍', '👎', '👏', '🙌', '🙏', '💪', '👀', '🎉', '🔥', '✅', '❌', '⚠️', '❤️', '💡', '📌', '📎', '🚀', '☕', '🍕', '💬'];
const CLEAR_LABELS = { '0': "Don't clear", '30': 'Clears in 30 minutes', '60': 'Clears in an hour', '240': 'Clears in 4 hours', today: 'Clears today', week: 'Clears this week' };
const ROOM_ICONS = { CrtDirect: 'sym_o_group', CrtPrivate: 'sym_o_lock', CrtPublic: 'sym_o_tag', CrtRecord: 'sym_o_description' };
const LEVELS = [{ value: 'CnlAll', label: 'All messages', icon: 'sym_o_notifications_active' }, { value: 'CnlMentions', label: 'Mentions only', icon: 'sym_o_alternate_email' },
    { value: 'CnlNone', label: 'Nothing', icon: 'sym_o_notifications_off' }];
const DRAFT_PREFIX = 'boss.chat.draft.';
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));
const timeText = (millis) => (millis ? new Date(Number(millis)).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }) : '');
const fullTime = (millis) => (millis ? new Date(Number(millis)).toLocaleString(undefined, { dateStyle: 'full', timeStyle: 'short' }) : '');
const dayLabel = (millis) => {
    const d = new Date(Number(millis));
    const now = new Date();
    if (d.toDateString() === now.toDateString()) return t('Today');
    if (d.toDateString() === new Date(now.getTime() - DAY).toDateString()) return t('Yesterday');
    const opts = { weekday: 'long', month: 'long', day: 'numeric' };
    if (d.getFullYear() !== now.getFullYear()) opts.year = 'numeric';
    return d.toLocaleDateString(undefined, opts);
};
const shortWhen = (millis) => {
    if (!millis) return '';
    const d = new Date(Number(millis));
    const now = new Date();
    if (d.toDateString() === now.toDateString()) return timeText(millis);
    if (now.getTime() - d.getTime() < 6 * DAY) return d.toLocaleDateString(undefined, { weekday: 'short' });
    if (d.getFullYear() === now.getFullYear()) return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
};
const sizeText = (bytes) => {
    const n = Number(bytes || 0);
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return Math.round(n / 1024) + ' KB';
    return (n / 1024 / 1024).toFixed(1) + ' MB';
};
const isImage = (file) => /^image\/(png|jpe?g|gif|webp)$/i.test((file && file.contentType) || '');
const fileIcon = (file) => {
    const type = String((file && file.contentType) || '');
    if (/^image\//.test(type)) return 'sym_o_image';
    if (/pdf/.test(type)) return 'sym_o_picture_as_pdf';
    if (/(sheet|excel|csv)/.test(type)) return 'sym_o_table';
    if (/(word|document|text)/.test(type)) return 'sym_o_description';
    if (/(zip|compressed)/.test(type)) return 'sym_o_folder_zip';
    return 'sym_o_attach_file';
};
// mentions of me read in bold (the rich-text content style tints every mention)
const decorateBody = (html, me) => String(html || '').replace(/<span data-mention-id="([^"]*)"/g,
    (match, id) => '<span class="m-chat-mention' + (id === me ? ' text-weight-bold' : '') + '" data-mention-id="' + id + '"');
const plainOf = (html) => (moqui.richText && moqui.richText.toPlain ? moqui.richText.toPlain(html || '') : String(html || '').replace(/<[^>]*>/g, ' ')).trim();
// a pushed event merged into a timeline list (the page's chat store; nothing without it)
const applyEvent = (list, event, me, threadRoot) => (moqui.chat && moqui.chat.applyEvent ? moqui.chat.applyEvent(list, event, me, threadRoot) : list);
const isEmptyHtml = (html) => (moqui.richText && moqui.richText.isEmpty ? moqui.richText.isEmpty(html || '') : !plainOf(html));
// a membership, system, pin, call or poll event in words, with its icon
const systemText = (event, nameOf) => {
    const content = event.content || {};
    const by = nameOf(content.byUserId || event.senderUserId);
    const who = nameOf(content.userId);
    const roles = { CmrOwner: t('an owner'), CmrModerator: t('a moderator'), CmrMember: t('a member'), CmrAgent: t('an agent') };
    if (event.type === 'membership') {
        if (content.action === 'join') return [fill(t('{user} joined'), { user: who }), 'sym_o_login'];
        if (content.action === 'add') return [fill(t('{by} added {user}'), { by, user: who }), 'sym_o_person_add'];
        if (content.action === 'leave') return [fill(t('{user} left'), { user: who }), 'sym_o_logout'];
        if (content.action === 'remove') return [fill(t('{by} took {user} out'), { by, user: who }), 'sym_o_person_remove'];
        if (content.action === 'role') return [fill(t('{by} made {user} {role}'), { by, user: who, role: roles[content.roleEnumId] || content.roleEnumId }), 'sym_o_shield_person'];
        return [fill(t('{by} changed the members'), { by }), 'sym_o_group'];
    }
    if (event.type === 'system') {
        if (content.action === 'created') return [fill(t('{by} created the room'), { by }), 'sym_o_add_circle'];
        if (content.action === 'renamed') return [fill(t('{by} renamed the room to {name}'), { by, name: content.roomName || '' }), 'sym_o_edit'];
        if (content.action === 'topic') return [content.topic ? fill(t('{by} set the topic: {topic}'), { by, topic: content.topic }) : fill(t('{by} cleared the topic'), { by }), 'sym_o_subject'];
        if (content.action === 'archived') return [fill(t('{by} archived the room'), { by }), 'sym_o_archive'];
        if (content.action === 'unarchived') return [fill(t('{by} took the room out of the archive'), { by }), 'sym_o_unarchive'];
        return [fill(t('{by} changed the room'), { by }), 'sym_o_info'];
    }
    if (event.type === 'pin') return [fill(content.pinned ? t('{by} pinned a message') : t('{by} unpinned a message'), { by }), 'sym_o_keep'];
    if (event.type === 'call') return [fill(t('{by} started a call'), { by }), 'sym_o_call'];
    if (event.type === 'poll') return [fill(t('{by} made a poll'), { by }), 'sym_o_ballot'];
    return [by, 'sym_o_info'];
};
const storage = {
    get(key) { try { return window.localStorage.getItem(key); } catch (err) { return null; } },
    set(key, value) { try { if (value) window.localStorage.setItem(key, value); else window.localStorage.removeItem(key); } catch (err) { /* no storage */ } },
    keys(prefix) { const out = []; try { for (let i = 0; i < window.localStorage.length; i++) { const key = window.localStorage.key(i); if (key && key.indexOf(prefix) === 0) out.push(key); } } catch (err) { /* no storage */ } return out; }
};
// a short sound for a new message, at most every two seconds (not under do not disturb: the caller asks moqui.chat.quiet())
let lastChime = 0;
let audio = null;
const chime = () => {
    const now = Date.now();
    if (now - lastChime < 2000) return;
    lastChime = now;
    try {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        audio = audio || new Ctx();
        const osc = audio.createOscillator();
        const gain = audio.createGain();
        osc.type = 'sine';
        osc.frequency.value = 880;
        gain.gain.setValueAtTime(0.0001, audio.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.05, audio.currentTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + 0.25);
        osc.connect(gain);
        gain.connect(audio.destination);
        osc.start();
        osc.stop(audio.currentTime + 0.3);
    } catch (err) { /* the browser plays nothing before the user's first click */ }
};

// ---- a message of the timeline or of a thread (room is the chat-room component) ----
const messageTemplate = `
<div class="row no-wrap relative-position q-pl-xs q-pr-sm m-chat-msg" :class="item.grouped ? '' : 'q-mt-sm'" :id="room.domId(item.eventSeq, inThread)"
        :data-seq="item.eventSeq" @mouseenter="room.hover(item, inThread)" @mouseleave="room.unhover(item, inThread)" @click="room.tap(item, inThread)">
    <div class="self-stretch" :class="item.highlight ? 'bg-primary' : ''" style="width:3px;margin-right:3px;border-radius:2px"></div>
    <div style="width:40px;min-width:40px" class="q-pr-sm">
