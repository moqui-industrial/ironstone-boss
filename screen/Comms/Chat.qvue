            <div v-else-if="item.bodyHtml" class="m-rich-text-content text-body2" style="padding:0;cursor:auto;max-height:none;overflow:visible;overflow-wrap:anywhere"
                    v-html="item.bodyHtml" @click="room.bodyClick($event)"></div>
            <span v-if="item.edited && !room.isEditing(item)" class="text-caption m-muted">{{room.t('(edited)')}}<q-tooltip>{{item.editedText}}</q-tooltip></span>
            <div v-if="item.attachments.length" class="row q-gutter-xs q-mt-none">
                <template v-for="file in item.attachments" :key="file.chatAttachmentId">
                    <img v-if="room.isImage(file)" :src="room.fileUrl(file, true)" :alt="file.fileName" class="rounded-borders cursor-pointer q-mt-xs"
                            style="max-width:min(280px, 100%);max-height:200px" @load="room.imageLoaded()" @click.stop="room.preview(file)">
                    <q-chip v-else dense square clickable :icon="room.fileIcon(file)" class="m-tonal q-ml-none" @click.stop="room.download(file)">
                        <span class="ellipsis" style="max-width:220px">{{file.fileName}}</span><span class="m-muted q-ml-xs">{{room.sizeText(file.fileSize)}}</span>
                        <q-tooltip>{{room.t('Download')}} {{file.fileName}}</q-tooltip></q-chip>
                </template>
            </div>
            <div v-if="item.records.length" class="q-mt-xs" style="max-width:440px">
                <m-record-card v-for="record in item.records" :key="record.entity + '|' + record.id" :record-entity="record.entity" :record-id="record.id"
                        :card-url="room.url('recordCard')" dense class="q-mb-xs"></m-record-card>
            </div>
            <div v-if="item.reactions.length" class="row items-center q-mt-xs">
                <q-chip v-for="reaction in item.reactions" :key="reaction.key" dense clickable :outline="!reaction.mine" :color="reaction.mine ? 'primary' : undefined"
                        :text-color="reaction.mine ? 'white' : undefined" class="q-ml-none q-mr-xs" :disable="!room.canPost" @click.stop="room.react(item, reaction.key)">
                    {{reaction.key}} {{reaction.count}}<q-tooltip>{{room.reactorsText(reaction)}}</q-tooltip></q-chip>
            </div>
            <div v-if="!inThread && item.threadReplyCount" class="q-mt-xs">
