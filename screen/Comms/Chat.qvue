            <div class="q-pl-sm text-caption ellipsis-2-lines" style="min-width:0">
                <span class="text-weight-medium">{{(item.replyTo.senderName || room.t('Someone')) + ': '}}</span><span class="m-muted">{{item.replyTo.redacted ? room.t('Message removed') : item.replyTo.snippet}}</span>
            </div>
        </div>
        <div v-if="item.redacted" class="text-body2 m-muted text-italic">{{item.removedLabel || room.t('Message removed')}}</div>
        <template v-else>
