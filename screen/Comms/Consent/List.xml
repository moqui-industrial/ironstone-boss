<!-- The consent registry (design-drawers-commons.md §16 Consent ConsentFind and Consents; style-guide §3.2 List): one row per
    contact with consent data, with its email and phone and whether each allows contact, its lists as chips (subscribed,
    waiting, out), the purposes granted and withdrawn, and the last change with its source (mantle.party.ConsentServices
    find#Consents through ironstone.comms.ConsentServices). ConsentFind narrows by text (name, email, phone, id), list, status (a
    list status or a consent status), purpose, the period of a change and allow contact. A row opens the contact's consent
    (Consent/Contact: change it, the history, the export of a data request). The bulk action unsubscribes the selected
    contacts from a list with the note of where the request came from; Export CSV gives every match (a suppression list);
    Record consent takes a contact and the grant or withdrawal with its evidence. For contact admins only: anyone else sees
    a short note, and every transition checks again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Consent" default-menu-include="false">

    <parameter name="text"/>
    <parameter name="contactListId"/>
    <parameter name="statusId"/>
    <parameter name="purposeEnumId"/>
    <parameter name="allowSolicitation"/>
    <parameter name="changed_period"/>
    <parameter name="changed_poffset"/>
    <parameter name="changed_pdate"/>
    <parameter name="changed_from"/>
    <parameter name="changed_thru"/>
    <parameter name="orderByField"/>
    <parameter name="pageIndex"/>

    <!-- the parties of the Record consent picker -->
    <transition-include name="contactSearch" location="component://mr-boss/template/ContactRecord.xml"/>

    <transition name="recordConsent">
        <actions>
            <service-call name="ironstone.comms.ConsentServices.record#Consent" in-map="context"/>
            <if condition="!ec.message.hasError()"><message type="success">Consent recorded</message></if>
        </actions>
        <default-response url="."/>
    </transition>
    <!-- the selected rows (selectedPartyIds, a comma list) unsubscribed from a list -->
    <transition name="unsubscribeParties">
        <actions><script><![CDATA[
            const ids = String(selectedPartyIds || '').split(',').map((id) => id.trim()).filter((id) => id)
            if (!ids.length) { ec.message.addError(ec.l10n.localize('Select the contacts to unsubscribe')); return }
            const out = ec.service.sync().name('ironstone.comms.ConsentServices.unsubscribe#Parties').parameters({partyIdList: ids,
                contactListId: bulkContactListId || '', evidenceText: evidenceText || null}).call()
            if (ec.message.hasError()) return
            const failed = (out.failedPartyIdList || []).length
            ec.message.addMessage(ec.resource.expand('${done} unsubscribed, ${same} already out${failed ? ", " + failed + " not changed" : ""}', '',
                {done: out.unsubscribedCount || 0, same: out.unchangedCount || 0, failed: failed}), failed ? 'warning' : 'success')
        ]]></script></actions>
        <default-response url="."/>
    </transition>
    <!-- every match as CSV -->
    <transition name="exportCsv" read-only="true">
        <actions><script><![CDATA[
            const param = (name) => { const value = ec.web.parameters[name]; return value == null || value === '' ? null : String(value) }
            let changedFromDate = null
            let changedThruDate = null
            if (param('changed_period')) {
                const range = ec.user.getPeriodRange(param('changed_period'), param('changed_poffset') || '0', param('changed_pdate'))
                if (range) { changedFromDate = range[0]; changedThruDate = range[1] }
            } else {
                if (param('changed_from')) changedFromDate = ec.l10n.parseTimestamp(param('changed_from').substring(0, 10) + ' 00:00:00.000', 'yyyy-MM-dd HH:mm:ss.SSS')
                if (param('changed_thru')) changedThruDate = new Date(Number(String(ec.l10n.parseTimestamp(param('changed_thru').substring(0, 10) + ' 00:00:00.000', 'yyyy-MM-dd HH:mm:ss.SSS'))) + 86400000)
            }
            const out = ec.service.sync().name('ironstone.comms.ConsentServices.find#Consents').parameters({text: param('text'), contactListId: param('contactListId'),
                statusId: param('statusId'), purposeEnumId: param('purposeEnumId'), allowSolicitation: param('allowSolicitation'),
                changedFromDate: changedFromDate, changedThruDate: changedThruDate, exportCsv: true}).call()
            if (!ec.message.hasError() && out?.csvText != null) ec.web.sendTextResponse(out.csvText, 'text/csv', out.fileName || 'consents.csv')
            else ec.web.sendJsonResponse({})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <service-call name="ironstone.comms.ConsentServices.check#ConsentAdmin" out-map="adminOut"/>
        <set field="isConsentAdmin" from="!!adminOut.isConsentAdmin"/>
        <script><![CDATA[
            if (!isConsentAdmin) return
            const param = (name) => { const value = ec.web.parameters[name]; return value == null || value === '' ? null : String(value) }
            let changedFromDate = null
            let changedThruDate = null
            if (param('changed_period')) {
                const range = ec.user.getPeriodRange(param('changed_period'), param('changed_poffset') || '0', param('changed_pdate'))
                if (range) { changedFromDate = range[0]; changedThruDate = range[1] }
            } else {
                if (param('changed_from')) changedFromDate = ec.l10n.parseTimestamp(param('changed_from').substring(0, 10) + ' 00:00:00.000', 'yyyy-MM-dd HH:mm:ss.SSS')
                if (param('changed_thru')) changedThruDate = new Date(Number(String(ec.l10n.parseTimestamp(param('changed_thru').substring(0, 10) + ' 00:00:00.000', 'yyyy-MM-dd HH:mm:ss.SSS'))) + 86400000)
            }
            const out = ec.service.sync().name('ironstone.comms.ConsentServices.find#Consents').parameters({text: text || null, contactListId: contactListId || null,
                statusId: statusId || null, purposeEnumId: purposeEnumId || null, allowSolicitation: allowSolicitation || null,
                changedFromDate: changedFromDate, changedThruDate: changedThruDate, orderByField: orderByField || null,
                pageIndex: Number(pageIndex || 0) || 0, pageSize: 20}).call() || {}
            consentList = Array.from(out.consentList || [])
            consentListCount = out.consentListCount || 0
            consentListPageIndex = out.consentListPageIndex || 0
            consentListPageSize = out.consentListPageSize || 20
            consentListPageMaxIndex = out.consentListPageMaxIndex || 0
            consentListPageRangeLow = out.consentListPageRangeLow || 0
            consentListPageRangeHigh = out.consentListPageRangeHigh || 0
            const options = ec.service.sync().name('ironstone.comms.ConsentServices.get#ConsentOptions').call() || {}
            listOptions = Array.from(options.listOptions || [])
            activeListOptions = listOptions.filter((option) => !option.archived)
            purposeOptions = Array.from(options.purposeOptions || [])
            sourceOptions = Array.from(options.sourceOptions || [])
            statusOptions = Array.from(options.statusOptions || [])
            consentStatusOptions = [{key: 'PconGranted', text: ec.l10n.localize('Granted')}, {key: 'PconWithdrawn', text: ec.l10n.localize('Withdrawn')}]
            filtered = !!(text || contactListId || statusId || purposeEnumId || allowSolicitation || param('changed_period') || param('changed_from') || param('changed_thru'))
            exportParams = {text: text || null, contactListId: contactListId || null, statusId: statusId || null, purposeEnumId: purposeEnumId || null,
                allowSolicitation: allowSolicitation || null, changed_period: param('changed_period'), changed_poffset: param('changed_poffset'),
                changed_pdate: param('changed_pdate'), changed_from: param('changed_from'), changed_thru: param('changed_thru')}
        ]]></script>
    </actions>
    <widgets>
        <section name="NotConsentAdmin" condition="!isConsentAdmin"><widgets>
            <container-box type="warning"><box-header title="Consent"/><box-body>
                <label type="p" text="Only contact admins see and change consent. Ask an admin to add you to Contact admins."/>
                <link url="//Comms/Inbox" link-type="anchor" text="Back to the Inbox"/>
            </box-body></container-box>
        </widgets></section>
        <section name="ConsentAdmin" condition="isConsentAdmin"><widgets>
            <container style="row items-center q-mb-xs">
                <label type="h5" text="Consent" style="q-my-none"/>
                <container style="col"/>
                <container-dialog id="RecordConsentDialog" button-text="Record consent" icon="sym_o_verified" width="600" title="Record consent">
                    <label type="p" text="A grant or withdrawal with what shows it: the form and its wording, the email or call it came in, the file it was imported from." style="m-muted"/>
                    <form-single name="RecordConsentForm" transition="recordConsent" focus-field="partyId">
                        <field name="partyId"><default-field title="Contact">
                            <drop-down><dynamic-options transition="contactSearch" server-search="true" min-length="2" parameter-map="{directoryOnly:'Y'}"/></drop-down></default-field></field>
                        <field name="purposeEnumId"><default-field title="Purpose">
                            <drop-down no-current-selected-key="PcpMarketingEmail"><list-options list="purposeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="statusId"><default-field title="Consent">
                            <radio no-current-selected-key="PconGranted"><list-options list="consentStatusOptions" key="${key}" text="${text}"/></radio></default-field></field>
                        <field name="sourceEnumId"><default-field title="Source">
                            <drop-down no-current-selected-key="PcsStaff"><list-options list="sourceOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="consentDate"><default-field title="When (empty: now)"><date-time type="date-time"/></default-field></field>
                        <field name="evidenceText"><default-field title="Evidence"><text-area rows="3" cols="60"/></default-field></field>
                        <field name="submitButton"><default-field title="Record"><submit/></default-field></field>
                        <field-layout>
                            <field-ref name="partyId"/>
                            <field-row><field-ref name="purposeEnumId"/><field-ref name="statusId"/></field-row>
                            <field-row><field-ref name="sourceEnumId"/><field-ref name="consentDate"/></field-row>
                            <field-ref name="evidenceText"/><field-ref name="submitButton"/>
                        </field-layout>
                    </form-single>
                </container-dialog>
                <link url="exportCsv" link-type="hidden-form-link" text="Export CSV" icon="sym_o_download" style="q-ml-sm" parameter-map="exportParams"
                        tooltip="Every contact that matches, as CSV (a suppression list)"/>
            </container>
            <label type="p" text="Whether each contact may be solicited, the lists they are on and the consent behind it. Open a contact to change it, see its history or export it for a data request." style="m-muted"/>

            <form-single name="ConsentFind" transition=".">
                <field name="text"><default-field title="Name, email or phone"><text-line size="24"/></default-field></field>
                <field name="contactListId"><default-field title="List">
                    <drop-down allow-empty="true"><list-options list="listOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                <field name="statusId"><default-field title="Status">
                    <drop-down allow-empty="true"><list-options list="statusOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                <field name="purposeEnumId"><default-field title="Purpose">
                    <drop-down allow-empty="true"><list-options list="purposeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                <field name="changed"><default-field title="Changed"><date-period allow-empty="true"/></default-field></field>
                <field name="allowSolicitation"><default-field title="Allows contact">
                    <drop-down allow-empty="true"><option key="Y" text="Yes"/><option key="N" text="No"/></drop-down></default-field></field>
                <field name="findButton"><default-field title="Find"><submit icon="sym_o_search"/></default-field></field>
                <field-layout><field-row-big><field-ref name="text"/><field-ref name="contactListId"/><field-ref name="statusId"/><field-ref name="purposeEnumId"/>
                    <field-ref name="changed"/><field-ref name="allowSolicitation"/><field-ref name="findButton"/></field-row-big></field-layout>
            </form-single>
            <section name="ClearConsentFind" condition="filtered"><widgets>
                <container style="q-mb-xs"><link url="." link-type="anchor" text="Clear filters"/></container>
            </widgets></section>

            <container-box><box-header title="Contacts · ${consentListCount}"/><box-body-nopad>
                <form-list name="Consents" list="consentList" multi="true" transition="unsubscribeParties" paginate="true" show-page-size="false">
                    <row-selection id-field="partyId" parameter="selectedPartyIds" list-mode="true">
                        <action><dialog button-text="Unsubscribe from a list" button-icon="sym_o_unsubscribe" title="Unsubscribe the selected contacts from a list"/>
                            <form-single name="BulkUnsubscribe" transition="unsubscribeParties">
                                <field name="bulkContactListId"><default-field title="List">
                                    <drop-down><list-options list="activeListOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                                <field name="evidenceText"><default-field title="Where the request came from"><text-line size="50"/></default-field></field>
                                <field name="submitButton"><default-field title="Unsubscribe"><submit type="danger" confirmation="Unsubscribe the selected contacts from this list?"/></default-field></field>
                            </form-single></action>
                    </row-selection>
                    <field name="partyName"><header-field title="Contact" show-order-by="true"/><default-field>
                        <link url="../Contact" text="${partyName}" parameter-map="{partyId:partyId}"/></default-field></field>
                    <field name="emailAddress"><header-field title="Email" show-order-by="true"/><default-field>
                        <render-mode><text type="qvt"><![CDATA[<span>${WebUtilities.encodeHtml(emailText ?? '')}</span><q-chip v-if="${emailFlag ? 'true' : 'false'}" dense square class="q-my-none q-mr-none m-tonal ${emailAllowSolicitation == 'Y' ? 'text-positive' : 'text-negative'}">${WebUtilities.encodeHtml(emailFlag ?? '')}<q-tooltip>${WebUtilities.encodeHtml(ec.l10n.localize('Allows contact'))}</q-tooltip></q-chip>]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(emailText ?? "") + (emailFlag ? " (" + emailFlag + ")" : "")})}]]></text></render-mode>
                    </default-field></field>
                    <field name="phoneNumber"><default-field title="Phone">
                        <render-mode><text type="qvt"><![CDATA[<span>${WebUtilities.encodeHtml(phoneText ?? '')}</span><q-chip v-if="${phoneFlag ? 'true' : 'false'}" dense square class="q-my-none q-mr-none m-tonal ${phoneAllowSolicitation == 'Y' ? 'text-positive' : 'text-negative'}">${WebUtilities.encodeHtml(phoneFlag ?? '')}<q-tooltip>${WebUtilities.encodeHtml(ec.l10n.localize('Allows contact'))}</q-tooltip></q-chip>]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(phoneText ?? "") + (phoneFlag ? " (" + phoneFlag + ")" : "")})}]]></text></render-mode>
                    </default-field></field>
                    <field name="listsHtml"><default-field title="Lists">
                        <render-mode><text type="qvt"><![CDATA[<div class="row items-center" data-party="${partyId}">${listsHtml}</div>]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(listsHtml ?? "").replace(/<[^>]*>/g, " ").replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, "\"").replace(/&#39;/g, "'").replace(/\s+/g, " ").trim()})}]]></text></render-mode>
                    </default-field></field>
                    <field name="purposesHtml"><default-field title="Purposes">
                        <render-mode><text type="qvt"><![CDATA[<div class="row items-center">${purposesHtml}</div>]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: String(purposesHtml ?? "").replace(/<[^>]*>/g, " ").replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, "\"").replace(/&#39;/g, "'").replace(/\s+/g, " ").trim()})}]]></text></render-mode>
                    </default-field></field>
                    <field name="lastChangeDate"><header-field title="Last change" show-order-by="true"/><default-field>
                        <render-mode><text type="qvt"><![CDATA[<div class="text-no-wrap">${WebUtilities.encodeHtml(lastChangeText ?? '')}</div><div class="text-caption m-muted">${WebUtilities.encodeHtml(lastChangeDetail ?? '')}</div>]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: [lastChangeText, lastChangeDetail].filter((part) => part).join(" · ")})}]]></text></render-mode>
                    </default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="partyName"/><field-ref name="emailAddress"/></column>
                        <column><field-ref name="listsHtml"/><field-ref name="purposesHtml"/></column>
                        <column><field-ref name="lastChangeDate"/></column>
                    </columns>
                </form-list>
                <section name="NoConsents" condition="!consentList.length"><widgets>
                    <container style="q-pa-sm">
                        <label type="p" text="${filtered ? 'No contacts match' : 'No consent recorded yet · Record consent, or subscribe contacts to a list'}" style="m-muted q-mb-xs"/>
                        <section name="NoConsentsClear" condition="filtered"><widgets>
                            <link url="." link-type="anchor" text="Clear filters"/>
                        </widgets></section>
                    </container>
                </widgets></section>
            </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
