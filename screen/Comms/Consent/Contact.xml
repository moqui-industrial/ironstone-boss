<!-- One contact's consent (design-drawers-commons.md §16 EditConsent and ConsentHistory; style-guide §3.3 Detail): the addresses
    and whether each allows contact, the lists, the consent of the contact as a whole, Record consent and the history with the
    export of a data request: template/ConsentRecord.xml's ConsentRecordSection with the history. A page rather than the
    design's dialog: with the history it is longer than a dialog may be (style-guide §3.11); Record consent and each change
    are its dialogs. For contact admins only, as the registry; the contact record's Consent tab shows the same state to
    anyone who may see the contact. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Contact consent" default-menu-include="false">

    <parameter name="partyId"/>
    <parameter name="pageIndex"/>

    <transition-include name="consentRecord" location="component://mr-boss/template/ConsentRecord.xml"/>
    <transition-include name="consentListSet" location="component://mr-boss/template/ConsentRecord.xml"/>
    <transition-include name="consentHistoryExport" location="component://mr-boss/template/ConsentRecord.xml"/>

    <actions>
        <service-call name="ironstone.ConsentServices.check#ConsentAdmin" out-map="adminOut"/>
        <set field="isConsentAdmin" from="!!adminOut.isConsentAdmin"/>
        <set field="consentPartyId" from="partyId"/>
        <set field="consentFull" from="true"/>
        <script><![CDATA[
            contactName = null
            if (isConsentAdmin && partyId) {
                const party = ec.entity.find('mantle.party.PartyDetail').condition('partyId', partyId).one()
                if (party != null && (!party.privateOwnerUserId || party.privateOwnerUserId === ec.user.userId))
                    contactName = ec.resource.expand('PartyFullNameTemplate', '', party).trim() || partyId
            }
        ]]></script>
    </actions>
    <widgets>
        <container style="q-mb-xs">
            <link url="../List" link-type="anchor" text="Consent" icon="arrow_back"/>
        </container>
        <section name="NotConsentAdmin" condition="!isConsentAdmin"><widgets>
            <container-box type="warning"><box-header title="Consent"/><box-body>
                <label type="p" text="Only contact admins see and change consent. Ask an admin to add you to Contact admins."/>
            </box-body></container-box>
        </widgets></section>
        <section name="NoContact" condition="isConsentAdmin &amp;&amp; !partyId"><widgets>
            <container-box><box-body>
                <label type="p" text="Choose a contact in the Consent list." style="m-muted q-mb-none"/>
            </box-body></container-box>
        </widgets></section>
        <section name="ContactConsent" condition="isConsentAdmin &amp;&amp; partyId"><widgets>
            <container style="row items-center q-mb-sm">
                <label type="h5" text="${contactName || partyId}" style="q-my-none"/>
                <container style="col"/>
                <link url="//Commons/Contacts/ContactDetail" text="Open the contact" icon="sym_o_person" parameter-map="{partyId:partyId}" condition="contactName"/>
            </container>
            <section-include name="ConsentRecordSection" location="component://mr-boss/template/ConsentRecord.xml"/>
        </widgets></section>
    </widgets>
</screen>
