<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <!-- the public page of a file or folder shared by link (design-drawers-commons.md §9 PublicShare; impl R16): /s/<token> in
        the public shell, after the token check; screen/PublicShare.xml checks the token again in every call. The unsubscribe
        page of a list email (§16 Unsubscribe): /u/<token>, the List-Unsubscribe URL too: the RFC 8058 one-click POST to it runs
        the screen's oneClick transition (post-transition, after the token check), as a POST to /u/<token>/oneClick does (the
        List-Unsubscribe of the emails sent before); screen/Unsubscribe.xml calls only Mantle's token-checked consent services.
        A published calendar (§7, §8): /cal/<token>, screen/PublishedCalendar.xml, after check#PublishedCalendarToken; the
        page asks for the password when the link has one and then reads get#PublishedCalendar. No CalDAV. -->
    <webapp-list>
        <webapp name="webroot">
            <token-route name="s" screen-location="component://ironstone-boss/screen/PublicShare.xml"
                    token-service="org.moqui.impl.FileServices.check#PublicShareToken" title="Shared files"/>
            <token-route name="u" screen-location="component://ironstone-boss/screen/Unsubscribe.xml"
                    token-service="mantle.party.ConsentServices.check#UnsubscribeToken" title="Email preferences" post-transition="oneClick"/>
            <token-route name="cal" screen-location="component://ironstone-boss/screen/PublishedCalendar.xml"
                    token-service="ironstone.CalendarServices.check#PublishedCalendarToken" title="Calendar"/>
        </webapp>
    </webapp-list>
    <screen-facade>
        <!-- the IronStone apps, each a root under the apps screen mounted by its own name, so a design path such as
            Commons/Tasks is the URL /qapps/Commons/Tasks -->
        <screen location="component://webroot/screen/webroot/apps.xml">
            <subscreens-item name="Commons" menu-title="IronStone Commons" menu-index="20" location="component://ironstone-boss/screen/Commons.xml"/>
            <subscreens-item name="Comms" menu-title="IronStone Comms" menu-index="21" location="component://ironstone-boss/screen/Comms.xml"/>
            <subscreens-item name="Sales" menu-title="IronStone Sales" menu-index="30" location="component://ironstone-boss/screen/Sales.xml"/>
            <subscreens-item name="Marketing" menu-title="IronStone Marketing" menu-index="31" location="component://ironstone-boss/screen/Marketing.xml"/>
            <subscreens-item name="CustomerService" menu-title="IronStone Customer Service" menu-index="32" location="component://ironstone-boss/screen/CustomerService.xml"/>
            <subscreens-item name="Commerce" menu-title="IronStone Commerce" menu-index="33" location="component://ironstone-boss/screen/Commerce.xml"/>
            <subscreens-item name="Products" menu-title="IronStone Products" menu-index="40" location="component://ironstone-boss/screen/Products.xml"/>
            <subscreens-item name="Purchasing" menu-title="IronStone Purchasing" menu-index="41" location="component://ironstone-boss/screen/Purchasing.xml"/>
            <subscreens-item name="Warehouse" menu-title="IronStone Warehouse" menu-index="42" location="component://ironstone-boss/screen/Warehouse.xml"/>
            <subscreens-item name="Manufacturing" menu-title="IronStone Manufacturing" menu-index="43" location="component://ironstone-boss/screen/Manufacturing.xml"/>
            <subscreens-item name="Maintenance" menu-title="IronStone Maintenance" menu-index="44" location="component://ironstone-boss/screen/Maintenance.xml"/>
            <subscreens-item name="Accounting" menu-title="IronStone Accounting" menu-index="50" location="component://ironstone-boss/screen/Accounting.xml"/>
            <subscreens-item name="People" menu-title="IronStone People" menu-index="51" location="component://ironstone-boss/screen/People.xml"/>
            <subscreens-item name="Projects" menu-title="IronStone Projects" menu-index="52" location="component://ironstone-boss/screen/Projects.xml"/>
            <subscreens-item name="Insights" menu-title="IronStone Insights" menu-index="60" location="component://ironstone-boss/screen/Insights.xml"/>
            <subscreens-item name="Admin" menu-title="IronStone Admin" menu-index="61" location="component://ironstone-boss/screen/Admin.xml"/>
        </screen>
    </screen-facade>
</moqui-conf>
