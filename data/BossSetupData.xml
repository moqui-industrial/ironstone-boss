<entity-facade-xml type="seed-initial">
    <!-- An artifact group and authz per IronStone app, via its root screen. Commons and Comms are for everyone who signs
        in (design-drawers-commons.md §2); a deployment narrows that with its own authz. Each business app is ADMIN only
        until its design file names its user groups. The active organization limits finds and search, as in PopCommerce;
        MANTLE_USER_ORG limits to all the user's orgs. -->
    <artifactGroups artifactGroupId="BOSS_COMMONS" description="IronStone Commons App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Commons.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_COMMONS_ALL_USERS" userGroupId="ALL_USERS" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_COMMS" description="IronStone Comms App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Comms.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
