<entity-facade-xml type="seed-initial">
    <!-- Artifact group and authz for the IronStone BOSS app, via its root screen -->
    <artifactGroups artifactGroupId="BOSS_APP" description="IronStone BOSS App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/boss.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <!-- the active organization limits finds and search, as in PopCommerce; MANTLE_USER_ORG limits to all the user's orgs -->
        <authz artifactAuthzId="BOSS_APP_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/></authz>
    </artifactGroups>
</entity-facade-xml>
