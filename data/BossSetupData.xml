<entity-facade-xml type="seed-initial">
    <!-- An artifact group and authz per IronStone app, via its root screen. Commons and Comms are for everyone who signs
        in (design-drawers-commons.md §2); a deployment narrows that with its own authz. Each business app is ADMIN only
        until its design file names its user groups. The active organization limits finds and search, as in PopCommerce;
        MANTLE_USER_ORG limits to all the user's orgs. MANTLE_PRIVATE_CONTACT keeps another user's personal contacts
        hidden whether or not an organization is active. -->
    <artifactGroups artifactGroupId="BOSS_COMMONS" description="IronStone Commons App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Commons.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_COMMONS_ALL_USERS" userGroupId="ALL_USERS" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_COMMS" description="IronStone Comms App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Comms.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_COMMS_ALL_USERS" userGroupId="ALL_USERS" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>

    <artifactGroups artifactGroupId="BOSS_SALES" description="IronStone Sales App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Sales.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_SALES_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_MARKETING" description="IronStone Marketing App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Marketing.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MARKETING_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_CUSTOMER_SERVICE" description="IronStone Customer Service App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/CustomerService.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_CUSTOMER_SERVICE_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_COMMERCE" description="IronStone Commerce App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Commerce.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_COMMERCE_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PRODUCTS" description="IronStone Products App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Products.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PRODUCTS_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PURCHASING" description="IronStone Purchasing App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Purchasing.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PURCHASING_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_WAREHOUSE" description="IronStone Warehouse App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Warehouse.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_WAREHOUSE_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_MANUFACTURING" description="IronStone Manufacturing App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Manufacturing.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MANUFACTURING_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_MAINTENANCE" description="IronStone Maintenance App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Maintenance.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_MAINTENANCE_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_ACCOUNTING" description="IronStone Accounting App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Accounting.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_ACCOUNTING_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PEOPLE" description="IronStone People App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/People.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PEOPLE_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <!-- Projects (design-projects.md §1.1): the project team and the project managers, and the client contacts, whose group
        gets its filter set and authorization with client access (impl-projects.md P10) and so may not open the app yet.
        Managers are ALWAYS, so the deny below never reaches them; the team is ALLOW, and denied the managers' screens, which
        leaves those out of its menu. -->
    <moqui.security.UserGroup userGroupId="BOSS_PROJECT_TEAM" description="Project team (IronStone Projects): employees and contractors who do project work"/>
    <moqui.security.UserGroup userGroupId="BOSS_PROJECT_MANAGER" description="Project managers (IronStone Projects): project, delivery and resource managers, and who bills the work"/>
    <moqui.security.UserGroup userGroupId="BOSS_PROJECT_CLIENT" description="Project clients (IronStone Projects): client contacts with a user account"/>
    <artifactGroups artifactGroupId="BOSS_PROJECTS" description="IronStone Projects App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Projects.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PROJECTS_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_PROJECTS_MANAGER" userGroupId="BOSS_PROJECT_MANAGER" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
        <authz artifactAuthzId="BOSS_PROJECTS_TEAM" userGroupId="BOSS_PROJECT_TEAM" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_PROJECTS_MANAGERS" description="IronStone Projects screens for managers only">
        <artifacts artifactName="component://ironstone-boss/screen/Projects/WorkItems/Import.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <artifacts artifactName="component://ironstone-boss/screen/Projects/Billing.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <artifacts artifactName="component://ironstone-boss/screen/Projects/Settings.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <!-- the + menu's Project kind (impl-projects.md F8: the shell offers a kind by its screen's authorization) -->
        <artifacts artifactName="component://ironstone-boss/screen/Projects/QuickProject.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <!-- the NewProject wizard and a project's Settings tab (design-projects.md §4: managers) -->
        <artifacts artifactName="component://ironstone-boss/screen/Projects/Projects/NewProject.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <artifacts artifactName="component://ironstone-boss/screen/Projects/Projects/ProjectDetail/Settings.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_PROJECTS_MANAGERS_TEAM" userGroupId="BOSS_PROJECT_TEAM" authzTypeEnumId="AUTHZT_DENY" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Projects' link of the WorkItemAssigned topic that Mantle seeds and sends (mantle.work.TaskServices.notify#TaskAssigned): the
        work item in Projects, for the email; the tray opens the record's screen (ironstone.PaletteServices.get#RecordLink) -->
    <moqui.security.user.NotificationTopic topic="WorkItemAssigned" linkTemplate="/qapps/Projects/WorkItems/WorkItemDetail?workEffortId=${workEffortId}"/>
    <!-- and of ProjectStatusUpdate (mantle.work.ProjectServices.post#ProjectUpdate): the project's overview -->
    <moqui.security.user.NotificationTopic topic="ProjectStatusUpdate" linkTemplate="/qapps/Projects/Projects/ProjectDetail?workEffortId=${workEffortId}"/>
    <!-- and of the code topics (mantle.work.GitServices notify#MergeRequest, notify#CommitStatusFailed): a merge request opens its
        detail (impl-projects.md P3b2), a failed check its commit -->
    <moqui.security.user.NotificationTopic topic="MergeRequestReview" linkTemplate="/qapps/Projects/Code/MergeRequestDetail?mergeRequestId=${mergeRequestId}"/>
    <moqui.security.user.NotificationTopic topic="MergeRequestUpdate" linkTemplate="/qapps/Projects/Code/MergeRequestDetail?mergeRequestId=${mergeRequestId}"/>
    <moqui.security.user.NotificationTopic topic="CommitStatusFailed" linkTemplate="/qapps/Projects/Code/CommitDetail?repositoryId=${repositoryId}&amp;commitId=${commitId}"/>
    <!-- the saved finds of WorkItems every Projects user has beside their own (design-projects.md §5 WorkItems; Blocked waits for the
        dependency find of impl-projects.md P4) -->
    <moqui.screen.form.FormListFind formListFindId="BOSS_PROJ_OPEN_BUGS" description="Open bugs"
            formLocation="component://ironstone-boss/screen/Projects/WorkItems/List.xml.form_list$WorkItemList" orderByField="priority">
        <moqui.screen.form.FormListFindField fieldName="list" fieldValue="open"/>
        <moqui.screen.form.FormListFindField fieldName="purposeEnumId" fieldValue="WepFix"/>
        <moqui.screen.form.FormListFindUserGroup userGroupId="BOSS_PROJECT_TEAM"/>
        <moqui.screen.form.FormListFindUserGroup userGroupId="BOSS_PROJECT_MANAGER"/>
    </moqui.screen.form.FormListFind>
    <moqui.screen.form.FormListFind formListFindId="BOSS_PROJ_IN_REVIEW" description="In review"
            formLocation="component://ironstone-boss/screen/Projects/WorkItems/List.xml.form_list$WorkItemList">
        <moqui.screen.form.FormListFindField fieldName="list" fieldValue="all"/>
        <moqui.screen.form.FormListFindField fieldName="statusId" fieldValue="WeInReview"/>
        <moqui.screen.form.FormListFindUserGroup userGroupId="BOSS_PROJECT_TEAM"/>
        <moqui.screen.form.FormListFindUserGroup userGroupId="BOSS_PROJECT_MANAGER"/>
    </moqui.screen.form.FormListFind>
    <moqui.screen.form.FormListFind formListFindId="BOSS_PROJ_CUR_SPRINT" description="Current sprint"
            formLocation="component://ironstone-boss/screen/Projects/WorkItems/List.xml.form_list$WorkItemList">
        <moqui.screen.form.FormListFindField fieldName="list" fieldValue="all"/>
        <moqui.screen.form.FormListFindField fieldName="sprintId" fieldValue="current"/>
        <moqui.screen.form.FormListFindUserGroup userGroupId="BOSS_PROJECT_TEAM"/>
        <moqui.screen.form.FormListFindUserGroup userGroupId="BOSS_PROJECT_MANAGER"/>
    </moqui.screen.form.FormListFind>
    <!-- git over SSH needs SSH_GIT, which ALL_USERS cannot hold (mr-moqui plans/Remaining-Work.md) -->
    <moqui.security.UserGroupPermission userGroupId="BOSS_PROJECT_TEAM" userPermissionId="SSH_GIT" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_PROJECT_MANAGER" userPermissionId="SSH_GIT" fromDate="0"/>
    <artifactGroups artifactGroupId="BOSS_INSIGHTS" description="IronStone Insights App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Insights.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_INSIGHTS_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>
    <artifactGroups artifactGroupId="BOSS_ADMIN" description="IronStone Admin App (via root screen)">
        <artifacts artifactName="component://ironstone-boss/screen/Admin.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="BOSS_ADMIN_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL">
            <filters entityFilterSetId="MANTLE_ACTIVE_ORG"/>
            <filters entityFilterSetId="MANTLE_PRIVATE_CONTACT"/></authz>
    </artifactGroups>

    <!-- The suite shell's IronStone screens (design-drawers-commons.md §1.2, impl R14), on the Quasar theme BOSS ships with:
        the tray panel's three tabs, the quick-create screen of the + menu kinds that name no screen, and the screen the
        header's Inbox count links to, each a path under the apps root; the Chatter and record-files elements' subscreen
        names, which every BOSS app root mounts from screen/Shared (R5). The webroot shellData transition sends them to
        the shell (webroot/screen/webroot/js/README.md, "Shell data and providers"). STRT_SHELL_COUNTS_SERVICE comes with
        mantle.party.PartyServices.get#ShellCounts (M2). -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="300" resourceTypeEnumId="STRT_TRAY_TODAY"
            resourceValue="Commons/Panel/Today"/>
    <!-- the Chat tab is a .qvue screen (Panel/ChatPanel.qvue), which the tray loads in its best client mode -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="301" resourceTypeEnumId="STRT_TRAY_CHAT"
            resourceValue="Comms/Panel/Chat"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="302" resourceTypeEnumId="STRT_TRAY_NOTIFICATIONS"
            resourceValue="Commons/Panel/Notifications"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="303" resourceTypeEnumId="STRT_QUICK_CREATE"
            resourceValue="Commons/QuickCreate"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="304" resourceTypeEnumId="STRT_MAIL_SCREEN"
            resourceValue="Comms/Inbox"/>
    <!-- the Messages count opens the Inbox on the Internal account (design-drawers-commons.md §1.2, §12) -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="308" resourceTypeEnumId="STRT_MESSAGES_SCREEN"
            resourceValue="Comms/Inbox?view=internal"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="305" resourceTypeEnumId="STRT_CHATTER_SCREEN"
            resourceValue="Chatter"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="306" resourceTypeEnumId="STRT_RECORD_FILES_SCREEN"
            resourceValue="RecordFiles"/>
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="307" resourceTypeEnumId="STRT_SHELL_COUNTS_SERVICE"
            resourceValue="mantle.party.PartyServices.get#ShellCounts"/>
    <!-- Chat (design-drawers-commons.md §13, impl M10): a room bound to a record is read and joined by the users who may see the
        record (org.moqui.impl.ChatServices.check#RecordVisible calls this service with checkOnly, under the user's filters) -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="309" resourceTypeEnumId="STRT_RECORD_VISIBLE_SERVICE"
            resourceValue="mantle.party.CommunicationServices.get#RecordLinkInfo"/>
    <!-- Out of office (design-drawers-commons.md §17, impl M5): an automatic reply to "my contacts and people inside" asks which
        senders are the account owner's contacts (org.moqui.impl.EmailClientServices.filter#ContactAddresses calls this service:
        the owner's personal contacts, own and shared contact books, and the directory of the owner's organizations) -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="310" resourceTypeEnumId="STRT_EMAIL_CONTACT_SERVICE"
            resourceValue="mantle.party.ContactBookServices.filter#ContactAddresses"/>
    <!-- m-avatar given only a user id (the header). ${userId} is replaced in the browser. 404 leaves the initials. Under
        /apps, where a transition answers an image request: under /qapps the request gets the page shell, so no image loads.
        An existing database needs this row loaded (the STRT_AVATAR_URL enumeration comes with the framework seed). -->
    <moqui.screen.ScreenThemeResource screenThemeId="DEFAULT_QUASAR" sequenceNum="311" resourceTypeEnumId="STRT_AVATAR_URL"
            resourceValue="/apps/Commons/Settings/Account/userPhoto?userId=${userId}"/>
    <!-- the do not disturb hours of Comms Settings, Chat (ironstone.ChatServices.apply#DndHours) -->
    <moqui.service.job.ServiceJob jobName="apply_ChatDndHours" description="Do not disturb hours of the chat users (IronStone)"
            serviceName="ironstone.ChatServices.apply#DndHours" cronExpression="0 */5 * * * ?" paused="N"/>
    <!-- Contacts (design-drawers-commons.md §6, impl M4): contact admins change and delete directory contacts and review the
        duplicates (Commons/Contacts/Duplicates), with Mantle's CONTACT_ADMIN permission (which the ADMIN group has too). A pair
        a contact admin marks "not a duplicate" is Mantle's PartyNotDuplicate; the PartySetting BossNotDuplicates that held such
        pairs before is moved to it on a load (ironstone.ContactServices.migrate#NotDuplicateSettings, nothing to do once done). -->
    <moqui.security.UserGroup userGroupId="BOSS_CONTACT_ADMIN" description="Contact admins (IronStone): edit and delete directory contacts, review duplicates"/>
    <moqui.security.UserGroupPermission userGroupId="BOSS_CONTACT_ADMIN" userPermissionId="CONTACT_ADMIN" fromDate="0"/>
    <ironstone.ContactServices.migrate-NotDuplicateSettings/>

    <!-- Files (design-drawers-commons.md §9 Records, impl-drawers-commons.md M8, R25): the Records drive, a view over the record
        attachment folders Mantle's save#*ContentFile services write under the mantle.content.root preference (the default
        dbresource://mantle/content; a deployment that moves the root changes rootLocation too). Every user may view it (the
        ALL_USERS member row), and FileServices (get#DriveAccess, through the STRT_RECORD_VISIBLE_SERVICE hook above) lets a user
        into a record's folder only when the record is one the user may see (R5, R28), so the drive shows each user only their
        records; it is read only (files are added from a record's Files panel). The folders are mapped explicitly, since they
        follow no naming rule: CommunicationEvent is capitalised, a work effort of any type (task, project, event) is under work,
        an asset maintenance record's files are
        under asset/<assetId>/maintenance/<id>, a facility's are written by BOSS's RecordFiles (no Mantle pair) and its
        certifications by Mantle. Payment methods and employments are left out on purpose; wiki page attachments are under
        each space's own root, not here. -->
    <moqui.resource.ResourceDrive driveId="BOSS_RECORDS" driveName="Records" driveKindEnumId="RdkRecords" rootLocation="dbresource://mantle/content"
            description="The files of records: parties, orders, requests, tasks and events, messages and more"/>
    <moqui.resource.ResourceDriveMember driveMemberId="BOSS_RECORDS_ALL_USERS" driveId="BOSS_RECORDS" userGroupId="ALL_USERS"
            permissionEnumId="RdpView" fromDate="1767225600000"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="party" recordEntityName="mantle.party.Party" idField="partyId"
            label="People and organizations" sequenceNum="10"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="order" recordEntityName="mantle.order.OrderHeader" idField="orderId"
            label="Orders" sequenceNum="20"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="request" recordEntityName="mantle.request.Request" idField="requestId"
            label="Requests" sequenceNum="30"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="work" recordEntityName="mantle.work.effort.WorkEffort"
            idField="workEffortId" label="Tasks, projects and events" sequenceNum="40"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="CommunicationEvent"
            recordEntityName="mantle.party.communication.CommunicationEvent" idField="communicationEventId" label="Messages" sequenceNum="50"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="facility" recordEntityName="mantle.facility.Facility"
            idField="facilityId" label="Facilities" sequenceNum="60"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="asset" recordEntityName="mantle.product.asset.Asset"
            idField="assetId" label="Assets" sequenceNum="70"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="asset/*/maintenance"
            recordEntityName="mantle.product.maintenance.AssetMaintenance" idField="assetMaintenanceId" label="Asset maintenance" sequenceNum="75"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="invoice" recordEntityName="mantle.account.invoice.Invoice"
            idField="invoiceId" label="Invoices" sequenceNum="80"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="payment" recordEntityName="mantle.account.payment.Payment"
            idField="paymentId" label="Payments" sequenceNum="85"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="shipment" recordEntityName="mantle.shipment.Shipment"
            idField="shipmentId" label="Shipments" sequenceNum="90"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="agreement" recordEntityName="mantle.party.agreement.Agreement"
            idField="agreementId" label="Agreements" sequenceNum="95"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="product" recordEntityName="mantle.product.Product"
            idField="productId" label="Products" sequenceNum="100"/>
    <moqui.resource.ResourceDriveRecordFolder driveId="BOSS_RECORDS" folderPath="productCategory"
            recordEntityName="mantle.product.category.ProductCategory" idField="productCategoryId" label="Product categories" sequenceNum="105"/>
</entity-facade-xml>
