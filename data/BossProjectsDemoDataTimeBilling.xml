<entity-facade-xml type="demo">
    <!-- P8a: billing (design-projects.md §10; impl-projects.md P8a). A file of its own after BossProjectsDemoDataTime.xml (the files load in
        name order), since it bills SUPP's time. Brightwater Dental Group, whose installation the support desk runs, is its client (billing
        address and email); the rates: SUPP's
        client rate (140 an hour) and its project management rate (165), ACME's client rate (135 until October, 150 since), and the worker
        pay of Joe Developer (70) and Bob Developer (60) on any project; then service/ironstone/projects/BillingDemoServices.xml load#BillingDemo
        finds the rates of SUPP's time again (as ProjectTime's Update rates does) and makes a draft client invoice of Joe's approved week,
        Net 30, a line per worker as the organization's billing defaults say. The rest of SUPP's time stays unbilled: Joe's last week
        waits for approval, Bob's was returned, this week's is open. -->
    <mantle.party.Party partyId="BOSS_DEMO_BRIGHTWATER" partyTypeEnumId="PtyOrganization" pseudoId="BRIGHTWATER"/>
    <mantle.party.Organization partyId="BOSS_DEMO_BRIGHTWATER" organizationName="Brightwater Dental Group"/>
    <mantle.party.PartyRole partyId="BOSS_DEMO_BRIGHTWATER" roleTypeId="Customer"/>
    <mantle.party.PartyRole partyId="BOSS_DEMO_BRIGHTWATER" roleTypeId="CustomerBillTo"/>
    <mantle.party.contact.ContactMech contactMechId="BOSS_DEMO_BW_PA" contactMechTypeEnumId="CmtPostalAddress"/>
    <mantle.party.contact.PostalAddress contactMechId="BOSS_DEMO_BW_PA" toName="Brightwater Dental Group" attnName="Accounts Payable"
            address1="410 Harbor Way" city="Portland" stateProvinceGeoId="USA_OR" countryGeoId="USA" postalCode="97204"/>
    <mantle.party.contact.PartyContactMech partyId="BOSS_DEMO_BRIGHTWATER" contactMechId="BOSS_DEMO_BW_PA" contactMechPurposeId="PostalBilling" fromDate="2026-01-01 00:00:00"/>
    <mantle.party.contact.ContactMech contactMechId="BOSS_DEMO_BW_BE" contactMechTypeEnumId="CmtEmailAddress" infoString="accounts@brightwater.example"/>
    <mantle.party.contact.PartyContactMech partyId="BOSS_DEMO_BRIGHTWATER" contactMechId="BOSS_DEMO_BW_BE" contactMechPurposeId="EmailBilling" fromDate="2026-01-01 00:00:00"/>
    <mantle.work.effort.WorkEffortParty workEffortId="SUPP" partyId="BOSS_DEMO_BRIGHTWATER" roleTypeId="Customer" fromDate="2026-09-01 09:00:00"/>

    <mantle.humanres.rate.RateAmount rateAmountId="BOSS_DEMO_RATE_SUPP" rateTypeEnumId="RatpStandard" ratePurposeEnumId="RaprClient" timePeriodUomId="TF_hr"
            workEffortId="SUPP" fromDate="2026-09-01 00:00:00" rateAmount="140.00" rateCurrencyUomId="USD"/>
    <mantle.humanres.rate.RateAmount rateAmountId="BOSS_DEMO_RATE_SUPP_PM" rateTypeEnumId="RatpStandard" ratePurposeEnumId="RaprClient" timePeriodUomId="TF_hr"
            workEffortId="SUPP" workTypeEnumId="WktpProjectMgmt" fromDate="2026-09-01 00:00:00" rateAmount="165.00" rateCurrencyUomId="USD"/>
    <mantle.humanres.rate.RateAmount rateAmountId="BOSS_DEMO_RATE_ACME_OLD" rateTypeEnumId="RatpStandard" ratePurposeEnumId="RaprClient" timePeriodUomId="TF_hr"
            workEffortId="ACME" fromDate="2026-09-14 00:00:00" thruDate="2026-10-01 00:00:00" rateAmount="135.00" rateCurrencyUomId="USD"/>
    <mantle.humanres.rate.RateAmount rateAmountId="BOSS_DEMO_RATE_ACME" rateTypeEnumId="RatpStandard" ratePurposeEnumId="RaprClient" timePeriodUomId="TF_hr"
            workEffortId="ACME" fromDate="2026-10-01 00:00:00" rateAmount="150.00" rateCurrencyUomId="USD"/>
    <mantle.humanres.rate.RateAmount rateAmountId="BOSS_DEMO_RATE_JOE_PAY" rateTypeEnumId="RatpStandard" ratePurposeEnumId="RaprVendor" timePeriodUomId="TF_hr"
            partyId="ORG_ZIZI_JD" fromDate="2026-01-01 00:00:00" rateAmount="70.00" rateCurrencyUomId="USD"/>
    <mantle.humanres.rate.RateAmount rateAmountId="BOSS_DEMO_RATE_BOB_PAY" rateTypeEnumId="RatpStandard" ratePurposeEnumId="RaprVendor" timePeriodUomId="TF_hr"
            partyId="ORG_ZIZI_BD" fromDate="2026-01-01 00:00:00" rateAmount="60.00" rateCurrencyUomId="USD"/>

    <!-- P8b: milestone billing on ACME (impl-projects.md P8b): Acme's sales order of the portal, a fixed fee of 24,000 (approved), its line
        the project's; two milestones share it: Design sign-off (ACME-MS-2) 20%, reached Oct 9 and approved by Acme's manager (John Doe
        recorded it), so 4,800 is due on Unbilled's Milestones due; Go live (ACME-MS-1) 80%, whose approval John Doe asked of Acme's
        manager (the roadmap's Awaiting approval). Their deliverables, the designs accepted. ACME is billed by milestones. -->
    <mantle.order.OrderHeader orderId="BOSS_DEMO_ACME_SO" orderName="Acme customer portal" statusId="OrderApproved" currencyUomId="USD"
            entryDate="2026-09-10 10:00:00" placedDate="2026-09-11 10:00:00" approvedDate="2026-09-11 10:00:00" grandTotal="24000.00" orderRevision="1"/>
    <mantle.order.OrderPart orderId="BOSS_DEMO_ACME_SO" orderPartSeqId="01" statusId="OrderApproved" customerPartyId="ORG_ACME" vendorPartyId="ORG_ZIZI_SERVICES"
            partTotal="24000.00"/>
    <mantle.order.OrderItem orderId="BOSS_DEMO_ACME_SO" orderItemSeqId="01" orderPartSeqId="01" itemTypeEnumId="ItemServiceProduct"
            itemDescription="Customer portal, fixed fee" quantity="1" unitAmount="24000.00"/>
    <mantle.order.OrderItemWorkEffort orderId="BOSS_DEMO_ACME_SO" orderItemSeqId="01" workEffortId="ACME"/>
    <mantle.work.effort.WorkEffort workEffortId="ACME-MS-2" workEffortTypeEnumId="WetMilestone" statusId="WeComplete" rootWorkEffortId="ACME"
            workEffortName="Design sign-off" estimatedCompletionDate="2026-10-09 17:00:00" actualCompletionDate="2026-10-09 15:00:00"
            description="Acme signs off the portal's designs: sign-in, order history and invoices."/>
    <mantle.order.OrderItemWorkEffort orderId="BOSS_DEMO_ACME_SO" orderItemSeqId="01" workEffortId="ACME-MS-2" invoicePercent="20"/>
    <mantle.order.OrderItemWorkEffort orderId="BOSS_DEMO_ACME_SO" orderItemSeqId="01" workEffortId="ACME-MS-1" invoicePercent="80"/>
    <mantle.work.effort.WorkEffortSetting workEffortId="ACME" settingTypeEnumId="WstBillingBasis" settingValue="Milestones"/>
    <mantle.work.effort.WorkEffortSetting workEffortId="ACME-MS-2" settingTypeEnumId="WstApprovalRequired" settingValue="Y"/>
    <mantle.work.effort.WorkEffortSetting workEffortId="ACME-MS-2" settingTypeEnumId="WstApproverParty" settingValue="ORG_ACME_SA"/>
    <mantle.work.effort.WorkEffortApproval workEffortApprovalId="BOSS_DEMO_ACME_AP2" workEffortId="ACME-MS-2" approverPartyId="ORG_ACME_SA" statusId="WeaApproved"
            requestedByUserId="EX_JOHN_DOE" requestedDate="2026-10-08 16:00:00" requestComments="The designs are in the shared folder."
            decidedByUserId="EX_JOHN_DOE" decidedDate="2026-10-09 15:00:00" decisionComments="Approved on the review call." recordedFor="Y"/>
    <mantle.work.effort.WorkEffortSetting workEffortId="ACME-MS-1" settingTypeEnumId="WstApprovalRequired" settingValue="Y"/>
    <mantle.work.effort.WorkEffortSetting workEffortId="ACME-MS-1" settingTypeEnumId="WstApproverParty" settingValue="ORG_ACME_SA"/>
    <mantle.work.effort.WorkEffortApproval workEffortApprovalId="BOSS_DEMO_ACME_AP1" workEffortId="ACME-MS-1" approverPartyId="ORG_ACME_SA" statusId="WeaRequested"
            requestedByUserId="EX_JOHN_DOE" requestedDate="2026-10-20 11:00:00" requestComments="The portal is on the staging site for your acceptance test."/>
    <mantle.work.effort.Deliverable deliverableId="BOSS_DEMO_DLV_DESIGNS" deliverableTypeEnumId="DlvtDesign" deliverableName="Portal designs"
            description="Sign-in, order history and invoices, desktop and phone."/>
    <mantle.work.effort.WorkEffortDeliverableProd workEffortId="ACME-MS-2" deliverableId="BOSS_DEMO_DLV_DESIGNS" sequenceNum="10"
            acceptedDate="2026-10-09 15:00:00" acceptedByUserId="EX_JOHN_DOE"/>
    <mantle.work.effort.Deliverable deliverableId="BOSS_DEMO_DLV_PORTAL" deliverableTypeEnumId="DlvtSoftware" deliverableName="Customer portal, live"
            description="On Acme's domain, with their single sign-on."/>
    <mantle.work.effort.WorkEffortDeliverableProd workEffortId="ACME-MS-1" deliverableId="BOSS_DEMO_DLV_PORTAL" sequenceNum="10"/>
    <mantle.work.effort.Deliverable deliverableId="BOSS_DEMO_DLV_GUIDE" deliverableTypeEnumId="DlvtDocument" deliverableName="Administrator guide"/>
    <mantle.work.effort.WorkEffortDeliverableProd workEffortId="ACME-MS-1" deliverableId="BOSS_DEMO_DLV_GUIDE" sequenceNum="20"/>

    <ironstone.projects.BillingDemoServices.load-BillingDemo/>
</entity-facade-xml>
